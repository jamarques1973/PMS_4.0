    except Exception:
        HAS_PYALE = False
    try:
        import dice_ml  # noqa: F401
        HAS_DICE = True
    except Exception:
        HAS_DICE = False
    try:
        from rulefit import RuleFit  # noqa: F401
        HAS_RULEFIT = True
    except Exception:
        HAS_RULEFIT = False
    try:
        from sklearn.inspection import permutation_importance, PartialDependenceDisplay  # noqa: F401

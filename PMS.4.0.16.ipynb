from typing import Any, Dict as _Dict, List as _List, Tuple as _Tuple
import numpy as np
import pandas as pd
from scipy.stats import loguniform
from sklearn.svm import SVR

# Aux: construir SVR con params

def build_svr_from_params(params: _Dict[str, Any]) -> "SVR":
    kernel = params.get("kernel", svr_kernel.value)
    kwargs: _Dict[str, Any] = {
        "kernel": kernel,
        "C": float(params.get("C", 1.0)),
        "epsilon": float(params.get("epsilon", 0.1)),
        "max_iter": int(max_iter_svr.value),
        "shrinking": bool(params.get("shrinking", True)),
        "tol": float(params.get("tol", 1e-3)),
    }
    gamma = params.get("gamma", None)
    if gamma is not None:
        kwargs["gamma"] = gamma
    if kernel == "poly":
        if "degree" in params:
            kwargs["degree"] = int(params["degree"])
        if "coef0" in params:
            kwargs["coef0"] = float(params["coef0"])
    return SVR(**kwargs)


def sklearn_cv_results_to_df(cv) -> "pd.DataFrame":
    try:
        df = pd.DataFrame(cv.cv_results_)
        cols = [c for c in df.columns if c.startswith("param_") or c in ("rank_test_score", "mean_test_score", "std_test_score")]
        return df[cols].sort_values("rank_test_score").reset_index(drop=True)
    except Exception:
        return pd.DataFrame()


def plot_sklearn_search_history(title: str, df: "pd.DataFrame"):
    if df.empty:
        return
    plt.figure(figsize=(8, 4))
    sns.lineplot(x=np.arange(len(df)), y=df["mean_test_score"].values, marker="o")
    plt.title(title + " — mean_test_score por candidato (ordenado)")
    plt.xlabel("Candidato (ordenado por rank)")
    plt.ylabel("mean_test_score")
    plt.tight_layout()
    plt.show()


def run_randomized_search(X_tr: np.ndarray, y_tr: np.ndarray, X_te: np.ndarray, y_te: np.ndarray, scoring_key: str) -> _Dict[str, Any]:
    seed = 42
    try:
        seed = int(svr_seed.value)  # type: ignore
    except Exception:
        pass
    kernel = svr_kernel.value
    param_distributions: _Dict[str, Any] = {
        "C": loguniform(float(C_min.value), float(C_max.value)),
        "epsilon": loguniform(float(eps_min.value), float(eps_max.value)),
    }
    if kernel in ("rbf", "sigmoid"):
        param_distributions["gamma"] = ["scale", "auto"]
    if kernel == "poly":
        param_distributions["degree"] = list(range(max(2, int(svr_degree.min)), int(svr_degree.max) + 1)) if hasattr(svr_degree, "max") else [2, 3, 4, 5, 6]
        param_distributions["coef0"] = list(np.round(np.linspace(-1.0, 1.0, 41), 3))
        param_distributions["gamma"] = ["scale", "auto"]
    # parámetros adicionales comunes
    param_distributions["tol"] = loguniform(1e-6, 1e-1)
    param_distributions["shrinking"] = [True, False]
    base = SVR(kernel=kernel, max_iter=int(max_iter_svr.value))
    X_all, y_all, cv = build_predefined_cv(X_tr, y_tr, X_te, y_te)
    rs = RandomizedSearchCV(
        estimator=base,
        param_distributions=param_distributions,
        n_iter=int(n_iter_random.value),
        scoring=scoring_key,
        n_jobs=-1,
        cv=cv,
        refit=False,
        random_state=seed,
        verbose=0,
        return_train_score=False,
    )
    rs.fit(X_all, y_all)
    best_params = {k.replace("param_", ""): v for k, v in rs.cv_results_.items() if k.startswith("param_")}
    # Obtener el mejor conjunto desde rs.best_index_
    try:
        idx = int(rs.best_index_)
        best_params = {k.replace("param_", ""): rs.cv_results_[k][idx] for k in rs.cv_results_ if k.startswith("param_")}
    except Exception:
        pass
    best_params = {k: (v.item() if hasattr(v, "item") else v) for k, v in best_params.items()}
    best_params["kernel"] = kernel
    # Reentrenar en Train únicamente con best_params
    model = build_svr_from_params(best_params)
    model.fit(X_tr, y_tr)
    y_pred = model.predict(X_te)
    metrics = compute_metrics(y_te, y_pred)
    hist_df = sklearn_cv_results_to_df(rs)
    return {"engine": "RandomizedSearchCV", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hist_df}


def run_halving_random_search(X_tr: np.ndarray, y_tr: np.ndarray, X_te: np.ndarray, y_te: np.ndarray, scoring_key: str) -> _Dict[str, Any]:
    if not HAS_HALVING:
        raise RuntimeError("HalvingRandomSearchCV no disponible en esta versión de sklearn.")
    seed = 42
    try:
        seed = int(svr_seed.value)  # type: ignore
    except Exception:
        pass
    kernel = svr_kernel.value
    param_distributions: _Dict[str, Any] = {
        "C": loguniform(float(C_min.value), float(C_max.value)),
        "epsilon": loguniform(float(eps_min.value), float(eps_max.value)),
    }
    if kernel in ("rbf", "sigmoid"):
        param_distributions["gamma"] = ["scale", "auto"]
    if kernel == "poly":
        param_distributions["degree"] = list(range(max(2, int(svr_degree.min)), int(svr_degree.max) + 1)) if hasattr(svr_degree, "max") else [2, 3, 4, 5, 6]
        param_distributions["coef0"] = list(np.round(np.linspace(-1.0, 1.0, 41), 3))
        param_distributions["gamma"] = ["scale", "auto"]
    # parámetros adicionales comunes
    param_distributions["tol"] = loguniform(1e-6, 1e-1)
    param_distributions["shrinking"] = [True, False]
    base = SVR(kernel=kernel, max_iter=int(max_iter_svr.value))
    X_all, y_all, cv = build_predefined_cv(X_tr, y_tr, X_te, y_te)
    min_res = min(int(halving_min_resources.value), len(y_tr))
    hrs = HalvingRandomSearchCV(
        estimator=base,
        param_distributions=param_distributions,
        factor=int(halving_factor.value),
        min_resources=min_res,
        scoring=scoring_key,
        n_jobs=-1,
        cv=cv,
        refit=False,
        random_state=seed,
        verbose=0,
        return_train_score=False,
    )
    hrs.fit(X_all, y_all)
    best_params = {k.replace("param_", ""): v for k, v in hrs.cv_results_.items() if k.startswith("param_")}
    try:
        idx = int(hrs.best_index_)
        best_params = {k.replace("param_", ""): hrs.cv_results_[k][idx] for k in hrs.cv_results_ if k.startswith("param_")}
    except Exception:
        pass
    best_params = {k: (v.item() if hasattr(v, "item") else v) for k, v in best_params.items()}
    best_params["kernel"] = kernel
    model = build_svr_from_params(best_params)
    model.fit(X_tr, y_tr)
    y_pred = model.predict(X_te)
    metrics = compute_metrics(y_te, y_pred)
    hist_df = sklearn_cv_results_to_df(hrs)
    return {"engine": "HalvingRandomSearchCV", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hist_df}


def run_skopt_bayes(X_tr: np.ndarray, y_tr: np.ndarray, X_te: np.ndarray, y_te: np.ndarray, scoring_key: str) -> _Dict[str, Any]:
    if not HAS_SKOPT:
        raise RuntimeError("scikit-optimize (skopt) no disponible.")
    kernel = svr_kernel.value
    space: _Dict[str, Any] = {
        "C": Real(float(C_min.value), float(C_max.value), prior="log-uniform"),
        "epsilon": Real(float(eps_min.value), float(eps_max.value), prior="log-uniform"),
    }
    if kernel in ("rbf", "sigmoid"):
        space["gamma"] = Categorical(["scale", "auto"])
    if kernel == "poly":
        space["degree"] = Integer(2, 8)
        space["coef0"] = Real(-1.0, 1.0)
        space["gamma"] = Categorical(["scale", "auto"])
    # parámetros adicionales comunes
    space["tol"] = Real(1e-6, 1e-1, prior="log-uniform")
    space["shrinking"] = Categorical([True, False])
    base = SVR(kernel=kernel, max_iter=int(max_iter_svr.value))
    X_all, y_all, cv = build_predefined_cv(X_tr, y_tr, X_te, y_te)
    seed = 42
    try:
        seed = int(svr_seed.value)  # type: ignore
    except Exception:
        pass
    opt = BayesSearchCV(
        estimator=base,
        search_spaces=space,
        n_iter=int(skopt_n_iter.value),
        scoring=scoring_key,
        cv=cv,
        refit=False,
        n_jobs=-1,
        random_state=seed,
        verbose=0,
    )
    opt.fit(X_all, y_all)
    best_params = opt.best_params_.copy()
    best_params["kernel"] = kernel
    model = build_svr_from_params(best_params)
    model.fit(X_tr, y_tr)
    y_pred = model.predict(X_te)
    metrics = compute_metrics(y_te, y_pred)
    hist_df = sklearn_cv_results_to_df(opt)
    return {"engine": "BayesSearchCV (skopt)", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hist_df}


def run_optuna(X_tr: np.ndarray, y_tr: np.ndarray, X_te: np.ndarray, y_te: np.ndarray, metric_key: str) -> _Dict[str, Any]:
    if not HAS_OPTUNA:
        raise RuntimeError("Optuna no disponible.")
    skey, maximize, metric_fn = metric_and_direction(metric_key)
    kernel = svr_kernel.value

    def objective(trial: "optuna.trial.Trial") -> float:
        C = trial.suggest_float("C", float(C_min.value), float(C_max.value), log=True)
        eps = trial.suggest_float("epsilon", float(eps_min.value), float(eps_max.value), log=True)
        params: _Dict[str, Any] = {"kernel": kernel, "C": C, "epsilon": eps}
        if kernel in ("rbf", "sigmoid"):
            params["gamma"] = trial.suggest_categorical("gamma", ["scale", "auto"])
        if kernel == "poly":
            params["degree"] = trial.suggest_int("degree", 2, 8)
            params["coef0"] = trial.suggest_float("coef0", -1.0, 1.0)
            params["gamma"] = trial.suggest_categorical("gamma", ["scale", "auto"])
        # parámetros adicionales comunes
        params["tol"] = trial.suggest_float("tol", 1e-6, 1e-1, log=True)
        params["shrinking"] = trial.suggest_categorical("shrinking", [True, False])
        model = build_svr_from_params(params)
        model.fit(X_tr, y_tr)
        y_pred = model.predict(X_te)
        score = metric_fn(y_te, y_pred)
        return score if maximize else float(score)

    study = optuna.create_study(direction="maximize" if metric_key == "R2" else "minimize")
    study.optimize(objective, n_trials=int(optuna_trials.value), show_progress_bar=False)
    best_params = study.best_trial.params.copy()
    best_params["kernel"] = kernel
    model = build_svr_from_params(best_params)
    model.fit(X_tr, y_tr)
    y_pred = model.predict(X_te)
    metrics = compute_metrics(y_te, y_pred)
    # Historial como df (plot uniforme lo hará on_run_svr)
    hist_df = pd.DataFrame({"value": [t.value for t in study.trials], "number": [t.number for t in study.trials]})
    return {"engine": "Optuna", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hist_df }


def run_hyperopt(X_tr: np.ndarray, y_tr: np.ndarray, X_te: np.ndarray, y_te: np.ndarray, metric_key: str) -> _Dict[str, Any]:
    if not HAS_HYPEROPT:
        raise RuntimeError("Hyperopt no disponible.")
    # Import defensivo por si la celda de imports no se ejecutó aún
    try:
        from hyperopt import hp, tpe, fmin, Trials, STATUS_OK
    except Exception as _e:
        raise RuntimeError(f"Hyperopt no disponible o import falló: {_e}")
    skey, maximize, metric_fn = metric_and_direction(metric_key)
    kernel = svr_kernel.value

    space: _Dict[str, Any] = {
        "C": hp.loguniform("C", np.log(float(C_min.value)), np.log(float(C_max.value))),
        "epsilon": hp.loguniform("epsilon", np.log(float(eps_min.value)), np.log(float(eps_max.value))),
    }
    if kernel in ("rbf", "sigmoid"):
        space["gamma"] = hp.choice("gamma", ["scale", "auto"])
    if kernel == "poly":
        space["degree"] = hp.quniform("degree", 2, 8, 1)
        space["coef0"] = hp.uniform("coef0", -1.0, 1.0)
        space["gamma"] = hp.choice("gamma", ["scale", "auto"])
    # parámetros adicionales comunes
    space["tol"] = hp.loguniform("tol", np.log(1e-6), np.log(1e-1))
    space["shrinking"] = hp.choice("shrinking", [True, False])

    def objective(params):
        params = params.copy()
        if "degree" in params:
            params["degree"] = int(params["degree"])  # quniform -> int
        params["kernel"] = kernel
        model = build_svr_from_params(params)
        model.fit(X_tr, y_tr)
        y_pred = model.predict(X_te)
        score = metric_fn(y_te, y_pred)
        loss = -float(score) if metric_key == "R2" else float(score)
        return {"loss": loss, "status": STATUS_OK}

    trials = Trials()
    seed = 42
    try:
        seed = int(svr_seed.value)  # type: ignore
    except Exception:
        pass
    # Usar Generator en lugar de RandomState para compatibilidad
    rng = np.random.default_rng(seed)
    best = fmin(
        fn=objective,
        space=space,
        algo=tpe.suggest,
        max_evals=int(hyperopt_evals.value),
        rstate=rng,
        trials=trials,
        verbose=False,
    )
    # Decodificar best con space_eval para choices
    try:
        from hyperopt import space_eval
        best_params = space_eval(space, best)
    except Exception:
        best_params = {**best}
        if kernel == "poly" and "degree" in best_params:
            best_params["degree"] = int(best_params["degree"])  # already int
    best_params["kernel"] = kernel
    model = build_svr_from_params(best_params)
    model.fit(X_tr, y_tr)
    y_pred = model.predict(X_te)
    metrics = compute_metrics(y_te, y_pred)
    # Historial (plot uniforme lo hará on_run_svr)
    vals = []
    for i, tr in enumerate(trials.trials):
        res = tr.get("result", {})
        vals.append({"iter": i + 1, "loss": res.get("loss", np.nan)})
    hist_df = pd.DataFrame(vals)
    return {"engine": "Hyperopt", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hist_df}

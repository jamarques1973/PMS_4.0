def _rf_collect_ranges() -> _Dict[str, _Any]:
    return {
        "n_estimators_min": int(rf_n_estimators_min.value),
        "n_estimators_max": int(rf_n_estimators_max.value),
        "max_depth_min": int(rf_max_depth_min.value),
        "max_depth_max": int(rf_max_depth_max.value),
        "allow_none_depth": bool(rf_allow_none_depth.value),
        "min_split_min": int(rf_min_split_min.value),
        "min_split_max": int(rf_min_split_max.value),
        "min_leaf_min": int(rf_min_leaf_min.value),
        "min_leaf_max": int(rf_min_leaf_max.value),
        "use_max_features_cats": bool(rf_use_max_features_cats.value),
        "max_features_cats": list(rf_max_features_cats.value or []),
        "max_features_frac_min": float(rf_max_features_frac_min.value),
        "max_features_frac_max": float(rf_max_features_frac_max.value),
        "bootstrap_search": bool(rf_bootstrap_search.value),
        "max_samples_frac_min": float(rf_max_samples_frac_min.value),
        "max_samples_frac_max": float(rf_max_samples_frac_max.value),
    }


def _engine_metric_value_rf(metric_key: str, metrics: dict) -> float:
    if metric_key == "R2":
        return float(metrics.get("r2", float("nan")))
    if metric_key == "RMSE":
        return float(metrics.get("rmse", float("nan")))
    if metric_key == "MAE":
        return float(metrics.get("mae", float("nan")))
    if metric_key == "MSE":
        return float(metrics.get("mse", float("nan")))
    return float(metrics.get("r2", float("nan")))


def on_run_rf(_):
    rf_alert.clear_output(); rf_histories_out.clear_output(); rf_tables_out.clear_output(); rf_best_out.clear_output(); rf_progress_out.clear_output()
    prog = _widgets_rf.IntProgress(value=0, min=0, max=6, description='HPO', bar_style='info')
    prog_label = _widgets_rf.HTML(value='Preparando...')
    with rf_progress_out:
        display(_widgets_rf.VBox([prog_label, prog]))

    if app.X is None or app.Y is None:
        with rf_alert:
            display(make_alert_html("Cargue X e Y antes de optimizar.", level="warning"))
        return
    y_col = None
    if sel_y_col.value is not None:
        y_col = sel_y_col.value
    elif y_col_dropdown.value is not None:
        y_col = y_col_dropdown.value
    if y_col is None:
        with rf_alert:
            display(make_alert_html("Seleccione una columna Y.", level="warning"))
        return
    if not app.segments:
        with rf_alert:
            display(make_alert_html("Genere la segmentación (Train/Test).", level="warning"))
        return
    seg = app.segments[0]
    X_tr, y_tr, X_te, y_te, cols, _, _ = prepare_train_test(app.X, app.Y[y_col], seg, use_selected_chk.value, scale_x_chk.value, scale_y_chk.value)
    skey, maximize, _metric_fn = metric_and_direction(rf_metric_dropdown.value)
    seed = int(rf_seed.value)

    need_opt = (rf_run_optuna_chk.value and not (_HAS_OPTUNA_RF or HAS_OPTUNA)) or (rf_run_skopt_chk.value and not (_HAS_SKOPT_RF or HAS_SKOPT)) or (rf_run_bayesopt_chk.value and not (_HAS_BAYESOPT_RF or HAS_BAYESOPT))
    if need_opt:
        ensure_optional_packages(progress_output=rf_alert)

    results = []
    history_items: list = []
    ranges = _rf_collect_ranges()

    try:
        if rf_run_random_chk.value:
            prog_label.value = 'RandomizedSearchCV corriendo...'; prog.value = min(prog.max, prog.value + 1)
            res = _run_rf_randomized(X_tr, y_tr, X_te, y_te, scoring_key=skey, seed=seed, ranges=ranges)
            results.append(res)
            hdf = res.get("history", _pd_rf.DataFrame())
            if not hdf.empty and "mean_test_score" in hdf.columns:
                history_items.append(("RandomizedSearchCV", _np_rf.arange(len(hdf)), hdf["mean_test_score"], "score"))
    except Exception as e:
        with rf_alert:
            display(make_alert_html(f"Error RandomizedSearchCV: {e}", level="error"))

    try:
        if rf_run_halving_chk.value and HAS_HALVING:
            prog_label.value = 'HalvingRandomSearchCV corriendo...'; prog.value = min(prog.max, prog.value + 1)
            res = _run_rf_halving(X_tr, y_tr, X_te, y_te, scoring_key=skey, seed=seed, ranges=ranges)
            results.append(res)
            hdf = res.get("history", _pd_rf.DataFrame())
            if not hdf.empty and "mean_test_score" in hdf.columns:
                history_items.append(("HalvingRandomSearchCV", _np_rf.arange(len(hdf)), hdf["mean_test_score"], "score"))
    except Exception as e:
        with rf_alert:
            display(make_alert_html(f"Error HalvingRandomSearchCV: {e}", level="error"))

    try:
        if rf_run_skopt_chk.value and (_HAS_SKOPT_RF or HAS_SKOPT):
            prog_label.value = 'BayesSearchCV (skopt) corriendo...'; prog.value = min(prog.max, prog.value + 1)
            res = _run_rf_skopt(X_tr, y_tr, X_te, y_te, scoring_key=skey, seed=seed, ranges=ranges)
            results.append(res)
            hdf = res.get("history", _pd_rf.DataFrame())
            if not hdf.empty and "mean_test_score" in hdf.columns:
                history_items.append(("BayesSearchCV (skopt)", _np_rf.arange(len(hdf)), hdf["mean_test_score"], "score"))
    except Exception as e:
        with rf_alert:
            display(make_alert_html(f"Error skopt: {e}", level="error"))

    try:
        if rf_run_optuna_chk.value and (_HAS_OPTUNA_RF or HAS_OPTUNA):
            prog_label.value = 'Optuna corriendo...'; prog.value = min(prog.max, prog.value + 1)
            res = _run_rf_optuna(X_tr, y_tr, X_te, y_te, metric_key=rf_metric_dropdown.value, seed=seed, ranges=ranges)
            results.append(res)
            hdf = res.get("history", _pd_rf.DataFrame())
            if not hdf.empty and "number" in hdf.columns and "value" in hdf.columns:
                history_items.append(("Optuna", hdf["number"], hdf["value"], "valor objetivo"))
    except Exception as e:
        with rf_alert:
            display(make_alert_html(f"Error Optuna: {e}", level="error"))



    try:
        if rf_run_bayesopt_chk.value and (_HAS_BAYESOPT_RF or HAS_BAYESOPT):
            prog_label.value = 'BayesianOptimization (bayes_opt) corriendo...'; prog.value = min(prog.max, prog.value + 1)
            res = _run_rf_bayesopt(X_tr, y_tr, X_te, y_te, metric_key=rf_metric_dropdown.value, seed=seed, ranges=ranges)
            results.append(res)
            hdf = res.get("history", _pd_rf.DataFrame())
            if not hdf.empty:
                x_series = hdf.get("iter", _pd_rf.Series(range(1, len(hdf) + 1)))
                y_series = hdf.get("target", _pd_rf.Series(dtype=float))
                if len(y_series) == len(x_series) and len(y_series) > 0:
                    history_items.append(("BayesianOptimization (bayes_opt)", x_series, y_series, "target"))
    except Exception as e:
        with rf_alert:
            display(make_alert_html(f"Error bayes_opt: {e}", level="error"))

    if not results:
        with rf_alert:
            display(make_alert_html("Seleccione y ejecute al menos un motor.", level="warning"))
        return

    rows = []
    for r in results:
        m = r.get("metrics", {})
        rows.append({
            "engine": r.get("engine"),
            "r2": m.get("r2"),
            "rmse": m.get("rmse"),
            "mae": m.get("mae"),
            "mse": m.get("mse"),
            "residual_kurtosis": m.get("residual_kurtosis"),
            "p_normal": m.get("p_normal"),
            "best_params": json.dumps(r.get("best_params", {}), ensure_ascii=False),
        })
    comp_df = _pd_rf.DataFrame(rows)
    metric_key = rf_metric_dropdown.value
    if metric_key == "R2":
        best_idx = int(comp_df["r2"].astype(float).idxmax())
    elif metric_key == "RMSE":
        best_idx = int(comp_df["rmse"].astype(float).idxmin())
    elif metric_key == "MAE":
        best_idx = int(comp_df["mae"].astype(float).idxmin())
    else:
        best_idx = int(comp_df["mse"].astype(float).idxmin())
    comp_df["is_best"] = False
    comp_df.loc[best_idx, "is_best"] = True

    if history_items:
        with rf_histories_out:
            cols_n = 2
            rows_n = int(_np_rf.ceil(len(history_items) / cols_n))
            fig, axes = plt.subplots(rows_n, cols_n, figsize=(10, rows_n * 2.2))
            axes = _np_rf.atleast_2d(axes)
            for idx, (name, x, y, ylab) in enumerate(history_items):
                r = idx // cols_n; c = idx % cols_n
                ax = axes[r, c]
                plot_history_uniform(ax, x, y, f"{name}", ylab)
            for k in range(len(history_items), rows_n * cols_n):
                r = k // cols_n; c = k % cols_n
                axes[r, c].axis('off')
            plt.tight_layout(); plt.show()

    with rf_tables_out:
        display(_widgets_rf.HTML(value="<i>Función objetivo seleccionada:</i> " + metric_key + "."))
        show_df(comp_df, caption="Tabla comparativa de motores", max_height=400, font_px=12)
        hp_rows = []
        for r in results:
            bp = r.get("best_params", {})
            row = {"engine": r.get("engine")}
            for k, v in bp.items():
                row[str(k)] = v
            hp_rows.append(row)
        hp_df = _pd_rf.DataFrame(hp_rows).fillna("")
        display(_widgets_rf.HTML(value="<i>Hiperparámetros óptimos por motor</i>"))
        show_df(hp_df, caption="Hiperparámetros óptimos por motor", max_height=400, font_px=12)
        fig, ax = plt.subplots(figsize=(8, 4))
        engines = comp_df["engine"].astype(str).tolist()
        if metric_key == "R2":
            vals = comp_df["r2"].astype(float).tolist(); ax.bar(engines, vals, color="#1f77b4"); ax.set_ylabel("R2 (↑)")
        elif metric_key == "RMSE":
            vals = comp_df["rmse"].astype(float).tolist(); ax.bar(engines, vals, color="#ff7f0e"); ax.set_ylabel("RMSE (↓)")
        elif metric_key == "MAE":
            vals = comp_df["mae"].astype(float).tolist(); ax.bar(engines, vals, color="#2ca02c"); ax.set_ylabel("MAE (↓)")
        else:
            vals = comp_df["mse"].astype(float).tolist(); ax.bar(engines, vals, color="#9467bd"); ax.set_ylabel("MSE (↓)")
        ax.set_title("Comparativa de motores vs función objetivo"); ax.set_xticks(range(len(engines))); ax.set_xticklabels(engines, rotation=15, ha="right"); plt.tight_layout(); plt.show()

    best_res = results[best_idx]
    y_pred_best = best_res.get("y_pred")
    with rf_best_out:
        plot_best_diagnostics(y_te, y_pred_best, title_prefix=f"RF [{best_res.get('engine')}] best")
        m = best_res.get("metrics", {})
        diag_table = _pd_rf.DataFrame([{**m, "n_test": len(y_te)}])
        display(_widgets_rf.HTML(value="<i>Métricas del mejor modelo</i>"))
        display(diag_table)

    app.rf_optim_results = {
        "y_column": y_col,
        "segment_name": seg.get("name"),
        "X_used_columns": cols,
        "metric_selection": metric_key,
        "engines": results,
        "comparison_table": comp_df.to_dict(orient="records"),
    }
    persist_payload = {
        "y_column": y_col,
        "segment": seg.get("name"),
        "metric": metric_key,
        "comparison": comp_df.to_dict(orient="records"),
        "best_engine": best_res.get("engine"),
        "best_params": best_res.get("best_params", {}),
        "best_metrics": best_res.get("metrics", {}),
        "X_used_columns": cols,
    }
    persist_results_for_comparison("RF", persist_payload)
    prog.value = prog.max; prog.bar_style = 'success'; prog_label.value = 'HPO completado'
    with rf_alert:
        display(make_alert_html("Optimización finalizada.", level="success"))


btn_run_rf.on_click(on_run_rf)


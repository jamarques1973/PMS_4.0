def _sklearn_cv_to_df_xgb(cv) -> _pd_xgb.DataFrame:
	try:
		df = _pd_xgb.DataFrame(cv.cv_results_)
		cols = [c for c in df.columns if c.startswith("param_") or c in ("rank_test_score", "mean_test_score", "std_test_score")]
		return df[cols].sort_values("rank_test_score").reset_index(drop=True)
	except Exception:
		return _pd_xgb.DataFrame()


def _build_predefined_cv_xgb(X_tr, y_tr, X_te, y_te):
	X_all = _np_xgb.vstack([X_tr, X_te])
	y_all = _np_xgb.concatenate([y_tr, y_te])
	test_fold = _np_xgb.array([-1] * len(y_tr) + [0] * len(y_te))
	cv = _PredefinedSplit_xgb(test_fold)
	return X_all, y_all, cv


def _engine_metric_value_xgb(metric_key: str, metrics: dict) -> float:
	if metric_key == "R2":
		return float(metrics.get("r2", float("nan")))
	if metric_key == "RMSE":
		return float(metrics.get("rmse", float("nan")))
	if metric_key == "MAE":
		return float(metrics.get("mae", float("nan")))
	return float(metrics.get("mse", float("nan")))


# Motores — implementaciones

def _run_xgb_randomized(X_tr, y_tr, X_te, y_te, scoring_key: str, seed: int, ranges: dict):
	X_all, y_all, cv = _build_predefined_cv_xgb(X_tr, y_tr, X_te, y_te)
	lr_dist = _uniform_xgb(float(ranges["lr_min"]), float(ranges["lr_max"]) - float(ranges["lr_min"])) if _loguniform_xgb is None else _loguniform_xgb(float(ranges["lr_min"]), float(ranges["lr_max"]))
	param_distributions = {
		"n_estimators": _randint_xgb(int(ranges["n_estimators_min"]), int(ranges["n_estimators_max"]) + 1),
		"max_depth": _randint_xgb(int(ranges["max_depth_min"]), int(ranges["max_depth_max"]) + 1),
		"learning_rate": lr_dist,
		"subsample": _uniform_xgb(float(ranges["subsample_min"]), float(ranges["subsample_max"]) - float(ranges["subsample_min"])) ,
		"colsample_bytree": _uniform_xgb(float(ranges["colsample_min"]), float(ranges["colsample_max"]) - float(ranges["colsample_min"])) ,
		"min_child_weight": _uniform_xgb(float(ranges["min_child_w_min"]), float(ranges["min_child_w_max"]) - float(ranges["min_child_w_min"])) ,
		"gamma": _uniform_xgb(float(ranges["gamma_min"]), float(ranges["gamma_max"]) - float(ranges["gamma_min"])) ,
		"reg_alpha": _uniform_xgb(float(ranges["alpha_min"]), float(ranges["alpha_max"]) - float(ranges["alpha_min"])) ,
		"reg_lambda": _uniform_xgb(float(ranges["lambda_min"]), float(ranges["lambda_max"]) - float(ranges["lambda_min"])) ,
	}
	base = _build_xgb_from_params({}, seed)
	rs = _RS_xgb(
		estimator=base,
		param_distributions=param_distributions,
		n_iter=int(xgb_n_iter_random.value),
		scoring=scoring_key,
		n_jobs=-1,
		cv=cv,
		refit=False,
		random_state=seed,
		return_train_score=False,
		verbose=0,
	)
	rs.fit(X_all, y_all)
	try:
		idx = int(rs.best_index_)
		best_params = {k.replace("param_", ""): rs.cv_results_[k][idx] for k in rs.cv_results_ if k.startswith("param_")}
	except Exception:
		best_params = {k.replace("param_", ""): v for k, v in rs.cv_results_.items() if k.startswith("param_")}
	best_params = {k: (v.item() if hasattr(v, 'item') else v) for k, v in best_params.items()}
	model = _build_xgb_from_params(best_params, seed)
	model.fit(X_tr, y_tr)
	y_pred = model.predict(X_te)
	metrics = compute_metrics(y_te, y_pred)
	hist_df = _sklearn_cv_to_df_xgb(rs)
	return {"engine": "RandomizedSearchCV", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hist_df}


def _run_xgb_halving(X_tr, y_tr, X_te, y_te, scoring_key: str, seed: int, ranges: dict):
	if not _HAS_HALVING_XGB:
		raise RuntimeError("HalvingRandomSearchCV no disponible.")
	X_all, y_all, cv = _build_predefined_cv_xgb(X_tr, y_tr, X_te, y_te)
	lr_dist = _uniform_xgb(float(ranges["lr_min"]), float(ranges["lr_max"]) - float(ranges["lr_min"])) if _loguniform_xgb is None else _loguniform_xgb(float(ranges["lr_min"]), float(ranges["lr_max"]))
	param_distributions = {
		"n_estimators": _randint_xgb(int(ranges["n_estimators_min"]), int(ranges["n_estimators_max"]) + 1),
		"max_depth": _randint_xgb(int(ranges["max_depth_min"]), int(ranges["max_depth_max"]) + 1),
		"learning_rate": lr_dist,
		"subsample": _uniform_xgb(float(ranges["subsample_min"]), float(ranges["subsample_max"]) - float(ranges["subsample_min"])) ,
		"colsample_bytree": _uniform_xgb(float(ranges["colsample_min"]), float(ranges["colsample_max"]) - float(ranges["colsample_min"])) ,
		"min_child_weight": _uniform_xgb(float(ranges["min_child_w_min"]), float(ranges["min_child_w_max"]) - float(ranges["min_child_w_min"])) ,
		"gamma": _uniform_xgb(float(ranges["gamma_min"]), float(ranges["gamma_max"]) - float(ranges["gamma_min"])) ,
		"reg_alpha": _uniform_xgb(float(ranges["alpha_min"]), float(ranges["alpha_max"]) - float(ranges["alpha_min"])) ,
		"reg_lambda": _uniform_xgb(float(ranges["lambda_min"]), float(ranges["lambda_max"]) - float(ranges["lambda_min"])) ,
	}
	base = _build_xgb_from_params({}, seed)
	hrs = _HRS_xgb(
		estimator=base,
		param_distributions=param_distributions,
		factor=int(xgb_halving_factor.value),
		min_resources=min(int(xgb_halving_min_resources.value), len(y_tr)),
		scoring=scoring_key,
		n_jobs=-1,
		cv=cv,
		refit=False,
		random_state=seed,
		return_train_score=False,
		verbose=0,
	)
	hrs.fit(X_all, y_all)
	try:
		idx = int(hrs.best_index_)
		best_params = {k.replace("param_", ""): hrs.cv_results_[k][idx] for k in hrs.cv_results_ if k.startswith("param_")}
	except Exception:
		best_params = {k.replace("param_", ""): v for k, v in hrs.cv_results_.items() if k.startswith("param_")}
	best_params = {k: (v.item() if hasattr(v, 'item') else v) for k, v in best_params.items()}
	model = _build_xgb_from_params(best_params, seed)
	model.fit(X_tr, y_tr)
	y_pred = model.predict(X_te)
	metrics = compute_metrics(y_te, y_pred)
	hist_df = _sklearn_cv_to_df_xgb(hrs)
	return {"engine": "HalvingRandomSearchCV", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hist_df}


def _run_xgb_skopt(X_tr, y_tr, X_te, y_te, scoring_key: str, seed: int, ranges: dict):
	if not _HAS_SKOPT_XGB:
		raise RuntimeError("scikit-optimize (skopt) no disponible.")
	X_all, y_all, cv = _build_predefined_cv_xgb(X_tr, y_tr, X_te, y_te)
	space = {
		"n_estimators": _Integer_xgb(int(ranges["n_estimators_min"]), int(ranges["n_estimators_max"])) ,
		"max_depth": _Integer_xgb(int(ranges["max_depth_min"]), int(ranges["max_depth_max"])) ,
		"learning_rate": _Real_xgb(float(ranges["lr_min"]), float(ranges["lr_max"])) ,
		"subsample": _Real_xgb(float(ranges["subsample_min"]), float(ranges["subsample_max"])) ,
		"colsample_bytree": _Real_xgb(float(ranges["colsample_min"]), float(ranges["colsample_max"])) ,
		"min_child_weight": _Real_xgb(float(ranges["min_child_w_min"]), float(ranges["min_child_w_max"])) ,
		"gamma": _Real_xgb(float(ranges["gamma_min"]), float(ranges["gamma_max"])) ,
		"reg_alpha": _Real_xgb(float(ranges["alpha_min"]), float(ranges["alpha_max"])) ,
		"reg_lambda": _Real_xgb(float(ranges["lambda_min"]), float(ranges["lambda_max"])) ,
	}
	opt = _BayesSearchCV_xgb(
		estimator=_build_xgb_from_params({}, seed),
		search_spaces=space,
		n_iter=int(xgb_skopt_n_iter.value),
		scoring=scoring_key,
		cv=cv,
		refit=False,
		n_jobs=-1,
		random_state=seed,
		verbose=0,
	)
	opt.fit(X_all, y_all)
	best_params = getattr(opt, 'best_params_', {})
	model = _build_xgb_from_params(best_params or {}, seed)
	model.fit(X_tr, y_tr)
	y_pred = model.predict(X_te)
	metrics = compute_metrics(y_te, y_pred)
	hist_df = _sklearn_cv_to_df_xgb(opt) if hasattr(opt, 'cv_results_') else _pd_xgb.DataFrame()
	return {"engine": "BayesSearchCV (skopt)", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hist_df}


def _run_xgb_optuna(X_tr, y_tr, X_te, y_te, metric_key: str, seed: int, ranges: dict):
	if not _HAS_OPTUNA_XGB:
		raise RuntimeError("Optuna no disponible.")
	skey, maximize, metric_fn = metric_and_direction(metric_key)
	def objective(trial: "_optuna_xgb.trial.Trial") -> float:
		params = {
			"n_estimators": trial.suggest_int("n_estimators", int(ranges["n_estimators_min"]), int(ranges["n_estimators_max"])) ,
			"max_depth": trial.suggest_int("max_depth", int(ranges["max_depth_min"]), int(ranges["max_depth_max"])) ,
			"learning_rate": trial.suggest_float("learning_rate", float(ranges["lr_min"]), float(ranges["lr_max"]), log=True) ,
			"subsample": trial.suggest_float("subsample", float(ranges["subsample_min"]), float(ranges["subsample_max"])) ,
			"colsample_bytree": trial.suggest_float("colsample_bytree", float(ranges["colsample_min"]), float(ranges["colsample_max"])) ,
			"min_child_weight": trial.suggest_float("min_child_weight", float(ranges["min_child_w_min"]), float(ranges["min_child_w_max"])) ,
			"gamma": trial.suggest_float("gamma", float(ranges["gamma_min"]), float(ranges["gamma_max"])) ,
			"reg_alpha": trial.suggest_float("reg_alpha", float(ranges["alpha_min"]), float(ranges["alpha_max"]), log=True) ,
			"reg_lambda": trial.suggest_float("reg_lambda", float(ranges["lambda_min"]), float(ranges["lambda_max"]), log=True) ,
		}
		model = _build_xgb_from_params(params, seed)
		model.fit(X_tr, y_tr)
		y_pred = model.predict(X_te)
		score = metric_fn(y_te, y_pred)
		return float(score) if maximize else float(score)
	study = _optuna_xgb.create_study(direction="maximize" if metric_key == "R2" else "minimize")
	study.optimize(objective, n_trials=int(xgb_optuna_trials.value), show_progress_bar=False)
	best_params = study.best_trial.params.copy()
	model = _build_xgb_from_params(best_params, seed)
	model.fit(X_tr, y_tr)
	y_pred = model.predict(X_te)
	metrics = compute_metrics(y_te, y_pred)
	hdf = _pd_xgb.DataFrame({"value": [t.value for t in study.trials], "number": [t.number for t in study.trials]})
	return {"engine": "Optuna", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hdf}


def _run_xgb_hyperopt(X_tr, y_tr, X_te, y_te, metric_key: str, seed: int, ranges: dict):
	if not _HAS_HYPEROPT_XGB:
		raise RuntimeError("Hyperopt no disponible.")
	maximize = (metric_key == "R2")
	space = {
		"n_estimators": _hp_xgb.quniform("n_estimators", int(ranges["n_estimators_min"]), int(ranges["n_estimators_max"]), 1),
		"max_depth": _hp_xgb.quniform("max_depth", int(ranges["max_depth_min"]), int(ranges["max_depth_max"]), 1),
		"learning_rate": _hp_xgb.loguniform("learning_rate", _np_xgb.log(float(ranges["lr_min"])), _np_xgb.log(float(ranges["lr_max"]))),
		"subsample": _hp_xgb.uniform("subsample", float(ranges["subsample_min"]), float(ranges["subsample_max"])) ,
		"colsample_bytree": _hp_xgb.uniform("colsample_bytree", float(ranges["colsample_min"]), float(ranges["colsample_max"])) ,
		"min_child_weight": _hp_xgb.uniform("min_child_weight", float(ranges["min_child_w_min"]), float(ranges["min_child_w_max"])) ,
		"gamma": _hp_xgb.uniform("gamma", float(ranges["gamma_min"]), float(ranges["gamma_max"])) ,
		"reg_alpha": _hp_xgb.loguniform("reg_alpha", _np_xgb.log(float(ranges["alpha_min"])) if float(ranges["alpha_min"])>0 else -8.0, _np_xgb.log(float(ranges["alpha_max"])) if float(ranges["alpha_max"])>0 else -2.0),
		"reg_lambda": _hp_xgb.loguniform("reg_lambda", _np_xgb.log(float(ranges["lambda_min"])) if float(ranges["lambda_min"])>0 else -8.0, _np_xgb.log(float(ranges["lambda_max"])) if float(ranges["lambda_max"])>0 else -2.0),
	}
	trials = _Trials_xgb()
	def objective(hparams):
		params = {
			"n_estimators": int(round(hparams["n_estimators"])) ,
			"max_depth": int(round(hparams["max_depth"])) ,
			"learning_rate": float(hparams["learning_rate"]) ,
			"subsample": float(hparams["subsample"]) ,
			"colsample_bytree": float(hparams["colsample_bytree"]) ,
			"min_child_weight": float(hparams["min_child_weight"]) ,
			"gamma": float(hparams["gamma"]) ,
			"reg_alpha": float(hparams["reg_alpha"]) ,
			"reg_lambda": float(hparams["reg_lambda"]) ,
		}
		model = _build_xgb_from_params(params, seed)
		model.fit(X_tr, y_tr)
		y_pred = model.predict(X_te)
		mse = _mse_xgb(y_te, y_pred)
		mae = _mae_xgb(y_te, y_pred)
		r2 = _r2_score_xgb(y_te, y_pred)
		if maximize:
			loss = -float(r2)
		else:
			if metric_key == "RMSE":
				loss = float(_np_xgb.sqrt(mse))
			elif metric_key == "MAE":
				loss = float(mae)
			else:
				loss = float(mse)
		return {"loss": loss, "status": _STATUS_OK_XGB}
	best = _fmin_xgb(fn=objective, space=space, algo=_tpe_xgb.suggest, max_evals=int(xgb_hyperopt_evals.value), trials=trials, rstate=_np_xgb.random.default_rng(seed))
	# Reconstruir mejor modelo
	best_params = {
		"n_estimators": int(round(best.get("n_estimators", 300))) ,
		"max_depth": int(round(best.get("max_depth", 6))) ,
		"learning_rate": float(best.get("learning_rate", 0.1)) ,
		"subsample": float(best.get("subsample", 0.8)) ,
		"colsample_bytree": float(best.get("colsample_bytree", 0.8)) ,
		"min_child_weight": float(best.get("min_child_weight", 1.0)) ,
		"gamma": float(best.get("gamma", 0.0)) ,
		"reg_alpha": float(best.get("reg_alpha", 0.0)) ,
		"reg_lambda": float(best.get("reg_lambda", 1.0)) ,
	}
	model = _build_xgb_from_params(best_params, seed)
	model.fit(X_tr, y_tr)
	y_pred = model.predict(X_te)
	metrics = compute_metrics(y_te, y_pred)
	# Historial
	try:
		hdf = _pd_xgb.DataFrame({
			"iter": list(range(1, len(trials.trials)+1)),
			"loss": [t.get('result', {}).get('loss', _np_xgb.nan) for t in trials.trials],
		})
	except Exception:
		hdf = _pd_xgb.DataFrame()
	return {"engine": "Hyperopt", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hdf}


def _run_xgb_bayesopt(X_tr, y_tr, X_te, y_te, metric_key: str, seed: int, ranges: dict):
	if not _HAS_BAYESOPT_XGB:
		raise RuntimeError("bayes_opt no disponible.")
	_, maximize, metric_fn = metric_and_direction(metric_key)
	def objective_fun(n_estimators, max_depth, learning_rate, subsample, colsample_bytree, min_child_weight, gamma, reg_alpha, reg_lambda):
		params = {
			"n_estimators": int(round(n_estimators)) ,
			"max_depth": int(round(max_depth)) ,
			"learning_rate": float(learning_rate) ,
			"subsample": float(subsample) ,
			"colsample_bytree": float(colsample_bytree) ,
			"min_child_weight": float(min_child_weight) ,
			"gamma": float(gamma) ,
			"reg_alpha": float(reg_alpha) ,
			"reg_lambda": float(reg_lambda) ,
		}
		model = _build_xgb_from_params(params, seed)
		model.fit(X_tr, y_tr)
		y_pred = model.predict(X_te)
		score = metric_fn(y_te, y_pred)
		return float(score) if maximize else float(score)
	pbounds = {
		"n_estimators": (float(ranges["n_estimators_min"]), float(ranges["n_estimators_max"])) ,
		"max_depth": (float(ranges["max_depth_min"]), float(ranges["max_depth_max"])) ,
		"learning_rate": (float(ranges["lr_min"]), float(ranges["lr_max"])) ,
		"subsample": (float(ranges["subsample_min"]), float(ranges["subsample_max"])) ,
		"colsample_bytree": (float(ranges["colsample_min"]), float(ranges["colsample_max"])) ,
		"min_child_weight": (float(ranges["min_child_w_min"]), float(ranges["min_child_w_max"])) ,
		"gamma": (float(ranges["gamma_min"]), float(ranges["gamma_max"])) ,
		"reg_alpha": (float(ranges["alpha_min"]), float(ranges["alpha_max"])) ,
		"reg_lambda": (float(ranges["lambda_min"]), float(ranges["lambda_max"])) ,
	}
	opt = _BO_xgb(f=objective_fun, pbounds=pbounds, random_state=seed, verbose=0)
	opt.maximize(init_points=10, n_iter=int(xgb_n_iter_random.value))
	best = opt.max.get("params", {})
	best_params = {
		"n_estimators": int(round(best.get("n_estimators", 300))) ,
		"max_depth": int(round(best.get("max_depth", 6))) ,
		"learning_rate": float(best.get("learning_rate", 0.1)) ,
		"subsample": float(best.get("subsample", 0.8)) ,
		"colsample_bytree": float(best.get("colsample_bytree", 0.8)) ,
		"min_child_weight": float(best.get("min_child_weight", 1.0)) ,
		"gamma": float(best.get("gamma", 0.0)) ,
		"reg_alpha": float(best.get("reg_alpha", 0.0)) ,
		"reg_lambda": float(best.get("reg_lambda", 1.0)) ,
	}
	model = _build_xgb_from_params(best_params, seed)
	model.fit(X_tr, y_tr)
	y_pred = model.predict(X_te)
	metrics = compute_metrics(y_te, y_pred)
	try:
		targets = getattr(getattr(opt, 'space', None), 'target', None)
		if targets is not None and len(targets) > 0:
			hdf = _pd_xgb.DataFrame({"iter": list(range(1, len(targets)+1)), "target": list(targets)})
		else:
			hdf = _pd_xgb.DataFrame()
	except Exception:
		hdf = _pd_xgb.DataFrame()
	return {"engine": "BayesianOptimization (bayes_opt)", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hdf}


# Ayudas (>300 palabras cada una)
_xgb_help_engines = _widgets_xgb.HTML(value=(
	"<div style='max-width:900px;text-align:justify'>"
	+ "<p><b>Motores de optimización: RandomizedSearchCV, HalvingRandomSearchCV, BayesSearchCV (skopt), Optuna, Hyperopt y BayesianOptimization (bayes_opt)</b>. Este módulo permite ejecutar de forma flexible diversos motores de optimización de hiperparámetros sobre XGBoost. <b>RandomizedSearchCV</b> realiza un muestreo aleatorio del espacio, ideal para una primera exploración amplia y poco costosa; su ventaja es la simplicidad y la robustez a rangos extensos, lo que ayuda a identificar órdenes de magnitud razonables en learning_rate o en regularizaciones (reg_alpha, reg_lambda). <b>HalvingRandomSearchCV</b> implementa selección sucesiva: comienza con muchos candidatos y pocos recursos (p. ej., menos iteraciones o menos datos) y va concentrando recursos en los mejores; esto puede acelerar mucho en datasets grandes. <b>BayesSearchCV (skopt)</b> construye un modelo surrogate de la función objetivo y propone nuevos puntos informados, lo que reduce iteraciones en espacios correlacionados (por ejemplo, subsample vs colsample_bytree). <b>Optuna</b> ofrece muestreadores avanzados (TPE, CMA-ES) y <i>pruning</i>, con una API clara para definir espacios y restricciones; es excelente para refinar alrededor de regiones prometedoras. <b>Hyperopt</b> también usa TPE y destaca por su flexibilidad para espacios condicionales y escalas logarítmicas; además, permite presupuestos de evaluación muy controlados. <b>BayesianOptimization (bayes_opt)</b> maximiza directamente una función de objetivo sobre parámetros continuos; resulta útil para ajustes rápidos en torno a regiones continuas bien comportadas.</p>"
	+ "<p><b>Estrategia recomendada</b>. Comience con RandomizedSearch para delimitar rangos efectivos: por ejemplo, learning_rate entre 1e-3 y 0.3 (log-uniforme), max_depth 2–12, y fracciones 0.5–1.0 para subsample/colsample. Observe la trayectoria de la métrica en Test: si converge pronto, refine con Optuna o skopt; si el dataset es grande, incorpore Halving para filtrar candidatos rápidamente. Use Hyperopt cuando necesite espacios condicionales o cuando prefiera expresar el espacio de forma probabilística. Para presupuestos limitados, limite iteraciones/trials y supervise la estabilidad del mejor valor; si los mejores puntos aparecen en los bordes del rango, amplíe los límites. Combine los motores: una búsqueda aleatoria amplia seguida de un ajuste bayesiano suele ofrecer un equilibrio óptimo entre coste y calidad.</p>"
	+ "<p><b>Validación y sobreajuste</b>. En este módulo, todas las evaluaciones se realizan con un <i>PredefinedSplit</i> que separa Train de Test, de modo que la función objetivo se calcula exclusivamente en Test. Esto reduce el riesgo de sobreajustar a Train durante la búsqueda. Aun así, valide que los residuos no presenten patrones (forma de U, abanico), que la métrica en Test sea estable y que no haya degradación fuera de rango. Guarde siempre la configuración ganadora como baseline para comparaciones posteriores y documente los valores y rangos explorados.</p>"
	+ "</div>") )

_xgb_help_model = _widgets_xgb.HTML(value=(
	"<div style='max-width:900px;text-align:justify'>"
	+ "<p><b>Fundamentos de XGBoost</b>. XGBoost (Extreme Gradient Boosting) es un algoritmo de ensamble basado en <i>boosting</i> de árboles de decisión que optimiza una función de pérdida mediante gradiente. En regresión, suele emplear la pérdida cuadrática (reg:squarederror) sobre árboles relativamente poco profundos, agregados en secuencia. Cada árbol corrige los errores del conjunto acumulado, permitiendo modelar relaciones no lineales e interacciones de forma eficiente. El método incorpora regularizaciones L1 (reg_alpha) y L2 (reg_lambda), así como parámetros de control de complejidad como max_depth, min_child_weight o gamma, que ayudan a prevenir sobreajuste. El muestreo por filas (subsample) y por columnas (colsample_bytree) añade <i>bagging</i> implícito, mejorando la generalización. La versión moderna con <b>tree_method='hist'</b> acelera el entrenamiento y permite escalar a grandes volúmenes de datos.</p>"
	+ "<p><b>Parámetros clave</b>. <i>n_estimators</i> (número de árboles) y <i>learning_rate</i> (tasa de aprendizaje) controlan el equilibrio sesgo-varianza: tasas pequeñas requieren más árboles pero suelen generalizar mejor; tasas grandes convergen rápido pero pueden sobreajustar. <i>max_depth</i> limita la profundidad de cada árbol; valores altos aumentan capacidad pero también riesgo de sobreajuste. <i>min_child_weight</i> y <i>gamma</i> restringen divisiones débiles, elevando el umbral para crear nodos: mayores valores generan árboles más conservadores. <i>subsample</i> y <i>colsample_bytree</i> determinan la fracción de filas y columnas usada por árbol; valores intermedios (0.6–0.9) suelen ser un buen compromiso. Las regularizaciones <i>reg_alpha</i> (L1) y <i>reg_lambda</i> (L2) inducen esparsidad y contracción de pesos; ajuste log-uniforme entre 1e-8 y 1e-1 es un buen punto de partida.</p>"
	+ "<p><b>Buenas prácticas</b>. Escale las variables si hay rangos muy dispares para facilitar la optimización; revise la selección de variables global (unión) para evitar ruido irrelevante. Si detecta infraajuste (R² bajo y residuos estructurados), incremente n_estimators o reduzca regularización; si ve sobreajuste (gran brecha Train/Test), aumente regularizaciones, active muestreos más agresivos o reduzca profundidad. XGBoost no extrapola fuera del rango de entrenamiento: verifique la estabilidad en extremos y use análisis de residuos y curvas PDP/ALE para entender cómo responde el modelo. Mantenga semillas fijas para reproducibilidad y documente la mejor configuración.</p>"
	+ "</div>") )

_xgb_help_params = _widgets_xgb.HTML(value=(
	"<div style='max-width:900px;text-align:justify'>"
	+ "<p><b>Rangos recomendados y significado</b>. Definir rangos realistas acelera la búsqueda. Para <i>n_estimators</i>, explore 100–2000 como primera etapa; incremente si la métrica mejora de forma sostenida. <i>learning_rate</i> en log-uniforme 1e-3–0.3 cubre escenarios conservadores y agresivos; si la optimización oscila o se estanca, reduzca el máximo o aumente n_estimators. <i>max_depth</i> entre 2 y 12 suele bastar en regresión tabular; use valores mayores solo si hay evidencia clara de infraajuste. <i>subsample</i> y <i>colsample_bytree</i> entre 0.5 y 1.0: valores alrededor de 0.7–0.9 suelen equilibrar varianza y sesgo. <i>min_child_weight</i> de 0–20 controla la mínima suma de pesos por hoja; valores altos limitan divisiones arbitrarias. <i>gamma</i> penaliza la creación de nodos con ganancia marginal: 0–10 es un rango razonable; increméntelo si aparecen patrones de sobreajuste. <i>reg_alpha</i> y <i>reg_lambda</i> penalizan pesos; pruebe log-uniforme 1e-8–1e-1 inicialmente y ajuste según estabilidad de residuos y necesidad de esparsidad.</p>"
	+ "<p><b>Ajustes de la optimización</b>. Defina los presupuestos: <i>Rand iters</i> para Randomized/BO, <i>Optuna trials</i> y <i>Hyperopt evals</i> entre 50–200 para una sesión típica; increméntelos solo si observa mejoras. En <i>Halving</i>, elija <i>factor</i> entre 2–4 y un <i>min_res</i> que asegure evaluaciones rápidas pero representativas. En <i>skopt</i>, un número de iteraciones similar a RandomizedSearch suele ser suficiente para encontrar mejoras significativas cuando hay correlaciones entre hiperparámetros.</p>"
	+ "<p><b>Consejos</b>. Si el mejor punto cae en los extremos (por ejemplo, depth=max o lr=min), amplíe rangos o reequilibre el presupuesto hacia el parámetro crítico. Para datos con outliers o colas pesadas, evalúe transformar Y (log/Box-Cox) o usar métricas robustas como MAE como función objetivo. Mantenga coherencia en los splits Train/Test para poder comparar contra otros modelos y reutilice la lista de X seleccionadas (unión) como base de la optimización.</p>"
	+ "</div>") )

_xgb_help_interpret = _widgets_xgb.HTML(value=(
	"<div style='max-width:900px;text-align:justify'>"

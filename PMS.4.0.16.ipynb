def _ensure_xgboost(progress_output=None):
	global _HAS_XGBOOST
	if _HAS_XGBOOST:
		return
	import sys, subprocess
	prog = _widgets_xgb.IntProgress(value=0, min=0, max=1, description='HPO', bar_style='info')
	lbl = _widgets_xgb.HTML(value='Instalando xgboost…')
	if progress_output is not None:
		with progress_output:
			_display_xgb(_widgets_xgb.VBox([lbl, prog]))
	try:
		subprocess.check_call([sys.executable, '-m', 'pip', 'install', '-q', 'xgboost'])
		_HAS_XGBOOST = True
	except Exception as e:
		if progress_output is not None:
			with progress_output:
				_display_xgb(_widgets_xgb.HTML(value=f"<div>⚠️ No se pudo instalar xgboost: {e}</div>"))
	finally:
		prog.value = 1


def _build_xgb_from_params(params: dict, seed: int):
	if not _HAS_XGBOOST:
		raise RuntimeError("xgboost no disponible.")
	base = {
		'n_estimators': int(params.get('n_estimators', 300)),
		'max_depth': int(params.get('max_depth', 6)),
		'learning_rate': float(params.get('learning_rate', 0.1)),
		'subsample': float(params.get('subsample', 0.8)),
		'colsample_bytree': float(params.get('colsample_bytree', 0.8)),
		'min_child_weight': float(params.get('min_child_weight', 1.0)),
		'gamma': float(params.get('gamma', 0.0)),
		'reg_alpha': float(params.get('reg_alpha', 0.0)),
		'reg_lambda': float(params.get('reg_lambda', 1.0)),
		'random_state': int(seed),
		'n_jobs': -1,
		'objective': 'reg:squarederror',
		'tree_method': 'hist',
	}
	return _XGBRegressor(**base)



def _engine_metric_value(metric_key: str, metrics: dict) -> float:
    if metric_key == "R2":
        return float(metrics.get("r2", float("nan")))
    if metric_key == "RMSE":
        return float(metrics.get("rmse", float("nan")))
    if metric_key == "MAE":
        return float(metrics.get("mae", float("nan")))
    if metric_key == "MSE":
        return float(metrics.get("mse", float("nan")))
    return float(metrics.get("r2", float("nan")))


def on_run_svr(_):
    svr_alert.clear_output(); svr_histories_out.clear_output(); svr_tables_out.clear_output(); svr_best_out.clear_output(); svr_progress_out.clear_output()
    # Barra de progreso (6 pasos máx.)
    prog = widgets.IntProgress(value=0, min=0, max=6, description='HPO', bar_style='info')
    prog_label = widgets.HTML(value='Preparando...')
    with svr_progress_out:
        display(widgets.VBox([prog_label, prog]))
    # Validaciones
    if app.X is None or app.Y is None:
        with svr_alert:
            display(make_alert_html("Cargue X e Y antes de optimizar.", level="warning"))
        return
    y_col = None
    if sel_y_col.value is not None:
        y_col = sel_y_col.value
    elif y_col_dropdown.value is not None:
        y_col = y_col_dropdown.value
    if y_col is None:
        with svr_alert:
            display(make_alert_html("Seleccione una columna Y.", level="warning"))
        return
    if not app.segments:
        with svr_alert:
            display(make_alert_html("Genere la segmentación (Train/Test).", level="warning"))
        return
    seg = app.segments[0]
    # Preparar datos
    X_tr, y_tr, X_te, y_te, cols, _, _ = prepare_train_test(app.X, app.Y[y_col], seg, use_selected_chk.value, scale_x_chk.value, scale_y_chk.value)
    skey, maximize, _metric_fn = metric_and_direction(metric_dropdown.value)

    # Instalar opcionales si se requieren
    need_opt = (run_optuna_chk.value and not HAS_OPTUNA) or (run_hyperopt_chk.value and not HAS_HYPEROPT) or (run_skopt_chk.value and not HAS_SKOPT)
    if need_opt:
        ensure_optional_packages(progress_output=svr_alert)
        # Normalizar flags tras instalación
        need_opt = (run_optuna_chk.value and not HAS_OPTUNA) or (run_hyperopt_chk.value and not HAS_HYPEROPT) or (run_skopt_chk.value and not HAS_SKOPT)

    results = []
    history_items: list = []
    # Motores sklearn
    try:
        if run_random_chk.value:
            prog_label.value = 'RandomizedSearchCV corriendo...'; prog.value = min(prog.max, prog.value + 1)
            res = run_randomized_search(X_tr, y_tr, X_te, y_te, scoring_key=skey)
            results.append(res)
            hdf = res.get("history", pd.DataFrame())
            if not hdf.empty and "mean_test_score" in hdf.columns:
                history_items.append(("RandomizedSearchCV", np.arange(len(hdf)), hdf["mean_test_score"], "score"))
    except Exception as e:
        with svr_alert:
            display(make_alert_html(f"Error RandomizedSearchCV: {e}", level="error"))
    try:
        if run_halving_chk.value and HAS_HALVING:
            prog_label.value = 'HalvingRandomSearchCV corriendo...'; prog.value = min(prog.max, prog.value + 1)
            res = run_halving_random_search(X_tr, y_tr, X_te, y_te, scoring_key=skey)
            results.append(res)
            hdf = res.get("history", pd.DataFrame())
            if not hdf.empty and "mean_test_score" in hdf.columns:
                history_items.append(("HalvingRandomSearchCV", np.arange(len(hdf)), hdf["mean_test_score"], "score"))
    except Exception as e:
        with svr_alert:
            display(make_alert_html(f"Error HalvingRandomSearchCV: {e}", level="error"))
    # Optuna
    try:
        if run_optuna_chk.value and HAS_OPTUNA:
            # Optuna: mostrar progreso con callback
            prog_label.value = 'Optuna corriendo...'
            res = run_optuna(X_tr, y_tr, X_te, y_te, metric_key=metric_dropdown.value)
            prog.value = min(prog.max, prog.value + 1)
            results.append(res)
            # Plot historial luego en grid pequeño
            hdf = res.get("history", pd.DataFrame())
            if not hdf.empty and "number" in hdf.columns and "value" in hdf.columns:
                history_items.append(("Optuna", hdf["number"], hdf["value"], "valor objetivo"))
    except Exception as e:
        with svr_alert:
            display(make_alert_html(f"Error Optuna: {e}", level="error"))
    # Hyperopt
    try:
        if run_hyperopt_chk.value and HAS_HYPEROPT:
            prog_label.value = 'Hyperopt corriendo...'
            res = run_hyperopt(X_tr, y_tr, X_te, y_te, metric_key=metric_dropdown.value)
            prog.value = min(prog.max, prog.value + 1)
            results.append(res)
            hdf = res.get("history", pd.DataFrame())
            if not hdf.empty and "iter" in hdf.columns:
                y = (-hdf["loss"]) if metric_dropdown.value == "R2" else hdf["loss"]
                ylab = "R2" if metric_dropdown.value == "R2" else metric_dropdown.value
                history_items.append(("Hyperopt", hdf["iter"], y, ylab))
    except Exception as e:
        with svr_alert:
            display(make_alert_html(f"Error Hyperopt: {e}", level="error"))
    # skopt
    try:
        if run_skopt_chk.value and HAS_SKOPT:
            prog_label.value = 'BayesSearchCV (skopt) corriendo...'
            res = run_skopt_bayes(X_tr, y_tr, X_te, y_te, scoring_key=skey)
            prog.value = min(prog.max, prog.value + 1)
            results.append(res)
            hdf = res.get("history", pd.DataFrame())
            if not hdf.empty and "mean_test_score" in hdf.columns:
                history_items.append(("BayesSearchCV (skopt)", np.arange(len(hdf)), hdf["mean_test_score"], "score"))
    except Exception as e:
        with svr_alert:
            display(make_alert_html(f"Error skopt: {e}", level="error"))

    if not results:
        with svr_alert:
            display(make_alert_html("Seleccione y ejecute al menos un motor.", level="warning"))
        return

    # Tablas comparativas
    rows = []
    for r in results:
        m = r.get("metrics", {})
        rows.append({
            "engine": r.get("engine"),
            "r2": m.get("r2"),
            "rmse": m.get("rmse"),
            "mae": m.get("mae"),
            "mse": m.get("mse"),
            "residual_kurtosis": m.get("residual_kurtosis"),
            "p_normal": m.get("p_normal"),
            "best_params": json.dumps(r.get("best_params", {}), ensure_ascii=False),
        })
    comp_df = pd.DataFrame(rows)
    # Elegir mejor
    metric_key = metric_dropdown.value
    if metric_key == "R2":
        best_idx = int(comp_df["r2"].astype(float).idxmax())
    elif metric_key == "RMSE":
        best_idx = int(comp_df["rmse"].astype(float).idxmin())
    elif metric_key == "MAE":
        best_idx = int(comp_df["mae"].astype(float).idxmin())
    else:
        best_idx = int(comp_df["mse"].astype(float).idxmin())
    comp_df["is_best"] = False
    comp_df.loc[best_idx, "is_best"] = True

    # Mostrar historiales en grid compacto con ayudas
    if history_items:
        with svr_histories_out:
            cols = 2
            rows = int(np.ceil(len(history_items)/cols))
            fig, axes = plt.subplots(rows, cols, figsize=(10, rows*2.2))
            axes = np.atleast_2d(axes)
            for idx, (name, x, y, ylab) in enumerate(history_items):
                r = idx // cols; c = idx % cols
                ax = axes[r, c]
                plot_history_uniform(ax, x, y, f"{name}", ylab)
            # Ocultar ejes sobrantes
            for k in range(len(history_items), rows*cols):
                r = k // cols; c = k % cols
                axes[r, c].axis('off')
            plt.tight_layout(); plt.show()
            display(_HTML("""
<div style='max-width:900px;text-align:justify'>
<p><b>Interpretación extensa de historiales HPO</b>. Los historiales de optimización recogen, para cada motor, la evolución del valor objetivo conforme avanza la búsqueda en el espacio de hiperparámetros. Interpretarlos correctamente es clave para diagnosticar sobreajuste, falta de exploración o convergencia prematura. En primer lugar, observe la <i>tendencia general</i>: curvas crecientes (si se maximiza R2) o decrecientes (si se minimiza RMSE/MSE/MAE) sugieren que el algoritmo está encontrando configuraciones progresivamente mejores. Si la curva se estabiliza pronto y permanece plana, quizá el espacio se ha agotado o los límites del rango son demasiado estrechos. Si por el contrario la curva fluctúa mucho, puede indicar sensibilidad a la aleatoriedad (semillas, minibúsquedas) o que el espacio está poco estructurado y requiere más iteraciones o refinar los rangos (por ejemplo, acotar C y epsilon).</p>
<p>Compare la <i>velocidad de mejora</i> entre motores: búsquedas bayesianas (Optuna/skopt) suelen mejorar de forma más informada tras unas primeras iteraciones de exploración, mientras que RandomizedSearch/ HalvingRandom avanzan a saltos. Si HalvingRandom converge con menos candidatos, puede ser ventajoso en datasets grandes por su uso eficiente de recursos. Sin embargo, si la métrica empeora al aumentar recursos, revise el <i>split</i> (PredefinedSplit sobre Test) y asegure que el objetivo se computa exclusivamente en Test, como aquí.</p>
<p>La <i>estabilidad</i> de la curva cercana al final indica que añadir iteraciones aportará poco; si todavía hay pendiente relevante, incremente <code>n_iter</code> o <code>trials</code>. Preste atención a <i>picos aislados</i>: podrían ser valores extremos por combinaciones fortuitas (ej. gamma=auto con C alto). En esos casos, revise la comparativa final y valide con diagnósticos de residuos del mejor modelo para confirmar que no se trata de sobreajuste.</p>
<p>Por último, use estos historiales para <i>refinar rangos</i>: si los mejores puntos se concentran en el borde superior/inferior de C o epsilon, amplíe el rango. Si la mayoría de combinaciones ‘poly’ presentan desempeño pobre frente a ‘rbf’, puede descartar kernels menos prometedores o reservarlos para una fase separada. El objetivo es lograr una búsqueda suficientemente amplia para explorar hipótesis y suficientemente enfocada para no derrochar iteraciones en regiones poco productivas.</p>
</div>
"""))

    with svr_tables_out:
        display(widgets.HTML(value="<i>Función objetivo seleccionada:</i> " + metric_key + ". La tabla resume métricas en Test: R2 (↑ mejor), RMSE/MSE/MAE (↓ mejor)."))
        show_df(comp_df, caption="Tabla comparativa de motores", max_height=400, font_px=12)
        display(widgets.HTML(value="<i>Interpretación:</i> utilice 'is_best' para identificar el mejor motor según la función objetivo. 'p_normal' y 'kurtosis de residuo' ayudan a evaluar supuestos y colas/picos."))

        # Tabla de hiperparámetros por motor
        hp_rows = []
        for r in results:
            bp = r.get("best_params", {})
            row = {"engine": r.get("engine")}
            for k, v in bp.items():
                row[str(k)] = v
            hp_rows.append(row)
        hp_df = pd.DataFrame(hp_rows).fillna("")
        display(widgets.HTML(value="<i>Hiperparámetros óptimos por motor</i>"))
        show_df(hp_df, caption="Hiperparámetros óptimos por motor", max_height=400, font_px=12)
        display(widgets.HTML(value="<i>Cómo leer:</i> cada fila corresponde al mejor conjunto del motor. Úselo para reproducibilidad y para analizar sensibilidad (C, epsilon, gamma, tol, shrinking, etc.)."))

        # Gráfica comparativa de resultados
        fig, ax = plt.subplots(figsize=(8, 4))
        engines = comp_df["engine"].astype(str).tolist()
        if metric_key == "R2":
            vals = comp_df["r2"].astype(float).tolist()
            ax.bar(engines, vals, color="#1f77b4")
            ax.set_ylabel("R2 (más alto es mejor)")
        elif metric_key == "RMSE":
            vals = comp_df["rmse"].astype(float).tolist()
            ax.bar(engines, vals, color="#ff7f0e")
            ax.set_ylabel("RMSE (más bajo es mejor)")
        elif metric_key == "MAE":
            vals = comp_df["mae"].astype(float).tolist()
            ax.bar(engines, vals, color="#2ca02c")
            ax.set_ylabel("MAE (más bajo es mejor)")
        else:
            vals = comp_df["mse"].astype(float).tolist()
            ax.bar(engines, vals, color="#9467bd")
            ax.set_ylabel("MSE (más bajo es mejor)")
        ax.set_title("Comparativa de motores vs función objetivo")
        ax.set_xticks(range(len(engines)))
        ax.set_xticklabels(engines, rotation=15, ha="right")
        plt.tight_layout()
        plt.show()
        display(_HTML("""
<div style='max-width:900px;text-align:justify'>
<p><b>Interpretación extensa de la comparativa</b>. La gráfica resume el desempeño de cada motor según la función objetivo seleccionada. Para R2, barras más altas indican mayor proporción de varianza explicada; para errores (RMSE/MSE/MAE), barras más bajas implican predicciones más cercanas a los valores reales. Compare no solo el mejor valor, sino también la distancia entre motores: brechas pequeñas sugieren que múltiples motores encuentran soluciones similares (robustez), mientras que diferencias grandes pueden indicar que un motor explota mejor la estructura del problema o que algunos motores están subexplorando el espacio.</p>
<p>Use esta comparativa junto a la tabla de hiperparámetros para entender <i>por qué</i> un motor rindió mejor: por ejemplo, quizá Optuna encontró <code>C</code> y <code>epsilon</code> en rangos diferentes a los probados por RandomizedSearch. Valide además la <i>consistencia</i> con los diagnósticos: es preferible un motor que produce buenas métricas y residuos bien comportados, a uno que vence por un margen pequeño con residuos problemáticos. Si la función objetivo fuera distinta (ej. prioriza MAE sobre RMSE), el motor ganador podría cambiar; por ello, recomiéndase revisar al menos dos objetivos para confirmar la robustez de la elección.</p>
</div>
"""))

    best_res = results[best_idx]
    y_pred_best = best_res.get("y_pred")
    with svr_best_out:
        plot_best_diagnostics(y_te, y_pred_best, title_prefix=f"SVR [{best_res.get('engine')}] best")
        m = best_res.get("metrics", {})
        diag_table = pd.DataFrame([{**m, "n_test": len(y_te)}])
        display(widgets.HTML(value="<i>Métricas del mejor modelo</i>"))
        display(diag_table)
        display(_HTML("<div style='max-width:900px;text-align:justify'>"+
                "<p>Interpretación detallada: la matriz de diagnósticos incluye (1) Y real vs Y predicho con la diagonal de referencia, (2) Residuos vs predicción para detectar heterocedasticidad o patrones sistemáticos, (3) Histograma/KDE de residuos y (4) QQ-Plot frente a normal para inspeccionar colas y simetrías. Puntos cercanos a la diagonal y residuos centrados en 0 con varianza homogénea son señales de buen ajuste; colas pesadas o curvaturas en QQ-Plot sugieren errores no gaussianos o outliers. La tabla de métricas resume desempeño en Test (R2 alto, RMSE/MSE/MAE bajos), que es el criterio principal de la selección del mejor motor. Combine esta lectura con xIA para explicar qué variables impulsan el acierto y dónde aparecen posibles sesgos.</p>"+
                "</div>"))

    # Guardar en estado y persistir
    app.svr_optim_results = {
        "y_column": y_col,
        "segment_name": seg.get("name"),
        "X_used_columns": cols,
        "metric_selection": metric_key,
        "engines": results,
        "comparison_table": comp_df.to_dict(orient="records"),
    }
    persist_payload = {
        "y_column": y_col,
        "segment": seg.get("name"),
        "metric": metric_key,
        "comparison": comp_df.to_dict(orient="records"),

import threading, time
import ipywidgets as widgets
from IPython.display import display as _display

class EngineStatus:
    def __init__(self, name: str, total: int | None = None):
        self.name = name
        self.total = total if (isinstance(total, int) and total > 0) else 0
        self.start = time.time()
        self._stop = False
        self.bar = widgets.IntProgress(value=0, min=0, max=(self.total if self.total else 100), description=name, bar_style='info')
        self.label = widgets.HTML(value='inicializando...')
        self.box = widgets.VBox([self.bar, self.label])
        self._thread = threading.Thread(target=self._tick, daemon=True)
        self._thread.start()

    def _tick(self):
        while not self._stop:
            elapsed = int(time.time() - self.start)
            mm = elapsed // 60; ss = elapsed % 60
            perc = f" — {int(100*self.bar.value/max(1,self.bar.max))}%" if self.bar.max else ''
            self.label.value = f"<span>tiempo: {mm:02d}:{ss:02d}{perc}</span>"
            time.sleep(1)

    def update(self, current: int | None = None, total: int | None = None, message: str | None = None):
        if total is not None and total != self.total:
            self.total = int(total)
            self.bar.max = max(1, self.total)
        if current is not None:
            self.bar.value = min(self.bar.max, max(0, int(current)))
        if message:
            self.label.value = message

    def finish(self, success: bool = True, final_message: str | None = None):
        self._stop = True
        try:
            self._thread.join(timeout=0.2)
        except Exception:
            pass
        self.bar.bar_style = 'success' if success else 'danger'
        if final_message is not None:
            elapsed = int(time.time() - self.start)
            mm = elapsed // 60; ss = elapsed % 60
            self.label.value = final_message + f" — {mm:02d}:{ss:02d}"


def make_engine_panels(title: str):
    header = widgets.HTML(value=f"<b>{title}</b>")
    cont = widgets.VBox([])
    return header, cont

# Callback Optuna que actualiza EngineStatus
def make_optuna_callback(status: EngineStatus, total_trials: int):
    def _cb(study, trial):
        cur = trial.number + 1
        status.update(current=cur, total=total_trials, message=f"trial {cur}/{total_trials} — best: {study.best_value:.5f}")
    return _cb
# Overrides: remove 'patience' from scikeras-based searches; keep epochs/batch_size
from scipy.stats import randint as sp_randint, uniform as sp_uniform

def run_nn_randomized_search(X_tr, y_tr, X_te, y_te, scoring_key: str, n_iter: int, rng_seed: int = 42):
    if not (HAS_TF and HAS_SCIKERAS):
        raise RuntimeError("Requiere TensorFlow y scikeras")
    sp = default_nn_space()
    param_distributions = {
        'model__n_layers': sp_randint(sp['n_layers'][0], sp['n_layers'][1] + 1),
        'model__units': sp_randint(sp['units'][0], sp['units'][1] + 1),
        'model__activation': sp['activation'],
        'model__dropout': sp_uniform(sp['dropout'][0], sp['dropout'][1] - sp['dropout'][0]),
        'model__batch_norm': sp['batch_norm'],
        'model__learning_rate': loguniform(sp['learning_rate'][0], sp['learning_rate'][1]),
        'model__optimizer': sp['optimizer'],
        'batch_size': sp_randint(16, 513),
        'epochs': sp_randint(40, 501),
    }
    base = KerasRegressor(model=build_dense_model, input_dim=X_tr.shape[1], verbose=0)
    X_all, y_all, cv = _build_cv_for_test(X_tr, y_tr, X_te, y_te)
    rs = RandomizedSearchCV(estimator=base, param_distributions=param_distributions, n_iter=int(n_iter), scoring=scoring_key, n_jobs=1, cv=cv, refit=False, random_state=rng_seed, verbose=0, return_train_score=False)
    rs.fit(X_all, y_all)
    try:
        idx = int(rs.best_index_)
        best_params = {k.replace('param_', '').replace('model__', ''): rs.cv_results_[k][idx] for k in rs.cv_results_ if k.startswith('param_')}
    except Exception:
        best_params = {}
    # coerce
    bp = {}
    for k, v in best_params.items():
        try:
            bp[k] = int(v) if isinstance(v, (np.integer,)) else (float(v) if isinstance(v, (np.floating,)) else v)
        except Exception:
            bp[k] = v
    model, metrics, y_pred, hist = _fit_eval_nn(X_tr, y_tr, X_te, y_te, bp, seed=rng_seed)
    hist_df = pd.DataFrame({'epoch': np.arange(len(hist.history.get('loss', []))), 'loss': hist.history.get('loss', []), 'val_loss': hist.history.get('val_loss', [])})
    return {"engine": "RandomizedSearchCV", "best_params": bp, "y_pred": y_pred, "metrics": metrics, "history": hist_df}


def run_nn_halving_random(X_tr, y_tr, X_te, y_te, scoring_key: str, min_resources: int = 20, factor: int = 3, rng_seed: int = 42):
    if not (HAS_TF and HAS_SCIKERAS and HAS_HALVING):
        raise RuntimeError("Requiere TensorFlow, scikeras y HalvingRandomSearchCV")
    sp = default_nn_space()
    param_distributions = {
        'model__n_layers': sp_randint(sp['n_layers'][0], sp['n_layers'][1] + 1),
        'model__units': sp_randint(sp['units'][0], sp['units'][1] + 1),
        'model__activation': sp['activation'],
        'model__dropout': sp_uniform(sp['dropout'][0], sp['dropout'][1] - sp['dropout'][0]),
        'model__batch_norm': sp['batch_norm'],
        'model__learning_rate': loguniform(sp['learning_rate'][0], sp['learning_rate'][1]),
        'model__optimizer': sp['optimizer'],
        'batch_size': sp_randint(16, 513),
        'epochs': sp_randint(40, 501),
    }
    base = KerasRegressor(model=build_dense_model, input_dim=X_tr.shape[1], verbose=0)
    X_all, y_all, cv = _build_cv_for_test(X_tr, y_tr, X_te, y_te)
    hrs = HalvingRandomSearchCV(estimator=base, param_distributions=param_distributions, factor=int(factor), min_resources=int(min_resources), scoring=scoring_key, cv=cv, random_state=rng_seed, refit=False, verbose=0, n_candidates="exhaust")
    hrs.fit(X_all, y_all)
    try:
        idx = int(hrs.best_index_)
        best_params = {k.replace('param_', '').replace('model__', ''): hrs.cv_results_[k][idx] for k in hrs.cv_results_ if k.startswith('param_')}
    except Exception:
        best_params = {}
    model, metrics, y_pred, hist = _fit_eval_nn(X_tr, y_tr, X_te, y_te, best_params, seed=rng_seed)
    hist_df = pd.DataFrame({'candidate': np.arange(len(hrs.cv_results_.get('mean_test_score', []))), 'mean_test_score': hrs.cv_results_.get('mean_test_score', [])})
    return {"engine": "HalvingRandomSearchCV", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hist_df}


def run_nn_skopt(X_tr, y_tr, X_te, y_te, scoring_key: str, n_iter: int, rng_seed: int = 42):
    if not (HAS_SCIKERAS and HAS_SKOPT):
        raise RuntimeError("skopt no disponible o scikeras ausente")
    from skopt import BayesSearchCV
    from skopt.space import Real, Integer, Categorical
    sp = default_nn_space()
    base = KerasRegressor(model=build_dense_model, input_dim=X_tr.shape[1], verbose=0)
    search_spaces = {
        'model__n_layers': Integer(sp['n_layers'][0], sp['n_layers'][1]),
        'model__units': Integer(sp['units'][0], sp['units'][1]),
        'model__activation': Categorical(sp['activation']),
        'model__dropout': Real(sp['dropout'][0], sp['dropout'][1]),
        'model__batch_norm': Categorical(sp['batch_norm']),
        'model__learning_rate': Real(sp['learning_rate'][0], sp['learning_rate'][1], prior='log-uniform'),
        'model__optimizer': Categorical(sp['optimizer']),
        'batch_size': Integer(16, 512),
        'epochs': Integer(40, 500),
    }
    X_all, y_all, cv = _build_cv_for_test(X_tr, y_tr, X_te, y_te)
    opt = BayesSearchCV(estimator=base, search_spaces=search_spaces, n_iter=int(n_iter), scoring=scoring_key, cv=cv, n_jobs=1, refit=False, random_state=rng_seed, verbose=0, return_train_score=False)
    opt.fit(X_all, y_all)
    try:
        idx = int(opt.best_index_)
        best_params = {k.replace('param_', '').replace('model__', ''): opt.cv_results_[k][idx] for k in opt.cv_results_ if k.startswith('param_')}
    except Exception:
        best_params = {}
    model, metrics, y_pred, hist = _fit_eval_nn(X_tr, y_tr, X_te, y_te, best_params, seed=rng_seed)
    hdf = pd.DataFrame(opt.cv_results_)
    return {"engine": "BayesSearchCV (skopt)", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hdf}# Re-define on_run_nn without inline statements to fix SyntaxError
import ipywidgets as widgets
from IPython.display import display as _display, HTML as _HTML

def on_run_nn(_):
    try:
        nn_alert.clear_output(); nn_histories_out.clear_output(); nn_tables_out.clear_output(); nn_best_out.clear_output(); nn_progress_out.clear_output()
    except Exception:
        pass
    prog = widgets.IntProgress(value=0, min=0, max=6, description='HPO', bar_style='info')
    prog_label = widgets.HTML(value='Preparando...')
    with nn_progress_out:
        _display(widgets.VBox([prog_label, prog]))

    # Validaciones
    if 'app' not in globals() or app.X is None or app.Y is None:  # type: ignore
        with nn_alert:
            _display(_HTML("<i>Cargue X e Y antes de optimizar.</i>"))
        return
    y_col = None
    if 'sel_y_col' in globals() and sel_y_col.value is not None:
        y_col = sel_y_col.value
    elif 'y_col_dropdown' in globals() and y_col_dropdown.value is not None:
        y_col = y_col_dropdown.value
    if y_col is None:
        with nn_alert:
            _display(_HTML("<i>Seleccione una columna Y.</i>"))
        return
    if not getattr(app, 'segments', []):  # type: ignore
        with nn_alert:
            _display(_HTML("<i>Genere la segmentación (Train/Test).</i>"))
        return
    seg = app.segments[0]  # type: ignore

    # Datos Train/Test con selección global
    X_tr, y_tr, X_te, y_te, cols, _, _ = prepare_train_test(  # type: ignore
        app.X, app.Y[y_col], seg,  # type: ignore
        bool(nn_use_selected_chk.value), bool(nn_scale_x_chk.value), bool(nn_scale_y_chk.value)
    )
    skey, maximize, _metric_fn = metric_and_direction(nn_metric_dropdown.value)

    # Instalar paquetes opcionales si faltan
    need = (
        (run_nn_optuna_chk.value and not HAS_OPTUNA) or
        (run_nn_hyperopt_chk.value and not HAS_HYPEROPT) or
        (run_nn_skopt_chk.value and not HAS_SKOPT) or
        (run_nn_kt_chk.value and not HAS_KT) or
        (not HAS_TF) or (not HAS_SCIKERAS)
    )
    if need:
        ensure_nn_packages()

    results = []
    history_items = []

    # RandomizedSearchCV
    try:
        if run_nn_random_chk.value and HAS_TF and HAS_SCIKERAS:
            prog_label.value = 'RandomizedSearchCV corriendo...'
            prog.value = min(prog.max, prog.value + 1)
            res = run_nn_randomized_search(
                X_tr, y_tr, X_te, y_te,
                scoring_key=skey,
                n_iter=int(nn_n_iter_random.value),
                rng_seed=int(nn_seed.value)
            )
            results.append(res)
            h = res.get('history', pd.DataFrame())
            if isinstance(h, pd.DataFrame) and not h.empty and {'epoch', 'val_loss'}.issubset(set(h.columns)):
                history_items.append(("RandomizedSearchCV", h['epoch'].values, h['val_loss'].values, 'val_loss'))
    except Exception as e:
        with nn_alert:
            _display(_HTML(f"<i>Error RandomizedSearchCV:</i> {e}"))

    # HalvingRandomSearchCV
    try:
        if run_nn_halving_chk.value and HAS_HALVING and HAS_TF and HAS_SCIKERAS:
            prog_label.value = 'HalvingRandomSearchCV corriendo...'
            prog.value = min(prog.max, prog.value + 1)
            res = run_nn_halving_random(
                X_tr, y_tr, X_te, y_te,
                scoring_key=skey,
                min_resources=int(nn_halving_min_res.value),
                factor=int(nn_halving_factor.value),
                rng_seed=int(nn_seed.value)
            )
            results.append(res)
            h = res.get('history', pd.DataFrame())
            if isinstance(h, pd.DataFrame) and not h.empty and 'mean_test_score' in h.columns:
                history_items.append(("HalvingRandomSearchCV", np.arange(len(h)), h['mean_test_score'].values, 'score'))
    except Exception as e:
        with nn_alert:
            _display(_HTML(f"<i>Error Halving:</i> {e}"))

    # Optuna
    try:
        if run_nn_optuna_chk.value and HAS_OPTUNA:
            prog_label.value = 'Optuna corriendo...'
            prog.value = min(prog.max, prog.value + 1)
            res = run_nn_optuna(
                X_tr, y_tr, X_te, y_te,
                metric_key=nn_metric_dropdown.value,
                trials=int(nn_optuna_trials.value),
                rng_seed=int(nn_seed.value)
            )
            results.append(res)
            h = res.get('history', pd.DataFrame())
            if isinstance(h, pd.DataFrame) and not h.empty and {'number', 'value'}.issubset(set(h.columns)):
                history_items.append(("Optuna", h['number'].values, h['value'].values, 'valor objetivo'))
    except Exception as e:
        with nn_alert:
            _display(_HTML(f"<i>Error Optuna:</i> {e}"))

    # Hyperopt
    try:
        if run_nn_hyperopt_chk.value and HAS_HYPEROPT:
            prog_label.value = 'Hyperopt corriendo...'
            prog.value = min(prog.max, prog.value + 1)
            res = run_nn_hyperopt(
                X_tr, y_tr, X_te, y_te,
                metric_key=nn_metric_dropdown.value,
                max_evals=int(nn_hyperopt_evals.value),
                rng_seed=int(nn_seed.value)
            )
            results.append(res)
            h = res.get('history', pd.DataFrame())
            if isinstance(h, pd.DataFrame) and not h.empty and {'iter', 'value'}.issubset(set(h.columns)):
                history_items.append(("Hyperopt", h['iter'].values, h['value'].values, 'valor objetivo'))
    except Exception as e:
        with nn_alert:
            _display(_HTML(f"<i>Error Hyperopt:</i> {e}"))

    # skopt
    try:
        if run_nn_skopt_chk.value and HAS_SKOPT and HAS_SCIKERAS:
            prog_label.value = 'BayesSearchCV (skopt) corriendo...'
            prog.value = min(prog.max, prog.value + 1)
            res = run_nn_skopt(
                X_tr, y_tr, X_te, y_te,
                scoring_key=skey,
                n_iter=int(nn_skopt_n_iter.value),
                rng_seed=int(nn_seed.value)
            )
            results.append(res)
            h = res.get('history', pd.DataFrame())
            if isinstance(h, pd.DataFrame) and not h.empty and 'mean_test_score' in h.columns:
                history_items.append(("BayesSearchCV (skopt)", np.arange(len(h)), h['mean_test_score'].values, 'score'))
    except Exception as e:
        with nn_alert:
            _display(_HTML(f"<i>Error skopt:</i> {e}"))

    # KerasTuner
    try:
        if run_nn_kt_chk.value and HAS_KT:
            prog_label.value = 'KerasTuner corriendo...'
            prog.value = min(prog.max, prog.value + 1)
            res = run_nn_kerastuner(
                X_tr, y_tr, X_te, y_te,
                metric_key=nn_metric_dropdown.value,
                max_trials=int(nn_n_iter_random.value),
                rng_seed=int(nn_seed.value)
            )
            results.append(res)
            h = res.get('history', pd.DataFrame())
            if isinstance(h, pd.DataFrame) and not h.empty:
                if 'val_loss' in h.columns:
                    yy = h['val_loss'].values
                else:
                    yy = h.iloc[:, -1].values
                history_items.append(("KerasTuner", np.arange(len(yy)), yy, 'val_loss'))
    except Exception as e:
        with nn_alert:
            _display(_HTML(f"<i>Error KerasTuner:</i> {e}"))

    if not results:
        with nn_alert:
            _display(_HTML("<i>Seleccione y ejecute al menos un motor.</i>"))
        return

    # Historiales
    if history_items:
        with nn_histories_out:
            _plot_histories_grid(history_items)
            _display(_HTML("<div style='max-width:900px;text-align:justify'><p>Interpretación: observe tendencias, estabilidad y margen de mejora; contraste motores.</p></div>"))

    # Tabla comparativa y parámetros
    metric_key = nn_metric_dropdown.value
    comp_rows = []
    hp_rows = []
    for res in results:
        comp_rows.append({'engine': res.get('engine'), **res.get('metrics', {})})
        hp_rows.append({'engine': res.get('engine'), **res.get('best_params', {})})
    comp_df = pd.DataFrame(comp_rows)
    if metric_key == 'R2':
        best_idx = int(comp_df['r2'].idxmax())
    elif metric_key == 'RMSE':
        best_idx = int(comp_df['rmse'].idxmin())
    elif metric_key == 'MSE':
        best_idx = int(comp_df['mse'].idxmin())
    elif metric_key == 'MAE':
        best_idx = int(comp_df['mae'].idxmin())
    else:
        best_idx = int(comp_df['r2'].idxmax())
    comp_df['is_best'] = False
    comp_df.loc[best_idx, 'is_best'] = True

    with nn_tables_out:
        _display(_HTML("<i>Función objetivo seleccionada:</i> " + metric_key))
        show_df(comp_df, caption="Tabla comparativa de motores", max_height=400, font_px=12)
        _display(_HTML("<i>Hiperparámetros óptimos por motor</i>"))
        show_df(pd.DataFrame(hp_rows).fillna(""), caption="Hiperparámetros óptimos por motor", max_height=400, font_px=12)

    best_res = results[best_idx]
    y_pred_best = best_res.get('y_pred')
    with nn_best_out:
        plot_best_diagnostics(y_te, y_pred_best, title_prefix=f"NN [{best_res.get('engine')}] best")
        diag_table = pd.DataFrame([{**best_res.get('metrics', {}), 'n_test': len(y_te)}])
        _display(diag_table)

    # Persistencia
    try:
        persist_results_for_comparison("NN", {
            'y_column': y_col,
            'segment_name': seg.get('name'),
            'metric_key': metric_key,
            'engines': [r.get('engine') for r in results],
            'comp': comp_df.to_dict(orient='list'),
            'best_engine': best_res.get('engine'),
            'best_params': best_res.get('best_params'),
            'best_metrics': best_res.get('metrics'),
        })
    except Exception:
        pass

    with nn_alert:
        _display(_HTML("<b>Optimización NN finalizada.</b>"))


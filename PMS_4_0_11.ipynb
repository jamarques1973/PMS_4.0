            except Exception as _e:
                if progress_output is not None:
                    with progress_output:
                        display(widgets.HTML(value=f"<div>⚠️ No se pudo instalar {pkg}: {str(_e)}</div>"))
            finally:
                prog.value = i
        if progress_output is not None:
            prog.bar_style = 'success'
            prog_label.value = "Instalación HPO completada."
    # reintento de imports
    try:
        import optuna  # noqa: F401
        from optuna.visualization.matplotlib import plot_optimization_history as optuna_plot_history  # noqa: F401
        from optuna.visualization.matplotlib import plot_param_importances as optuna_plot_importances  # noqa: F401
        HAS_OPTUNA = True
    except Exception:
        HAS_OPTUNA = False
    try:
        from hyperopt import hp, tpe, fmin, Trials, STATUS_OK  # noqa: F401
        HAS_HYPEROPT = True
    except Exception:
        HAS_HYPEROPT = False
    try:
        from skopt import BayesSearchCV  # noqa: F401
        from skopt.space import Real, Integer, Categorical  # noqa: F401
        HAS_SKOPT = True
    except Exception:
        HAS_SKOPT = False
    try:
        from sklearn.experimental import enable_halving_search_cv  # noqa: F401
        from sklearn.model_selection import HalvingRandomSearchCV  # noqa: F401
        HAS_HALVING = True
    except Exception:
        HAS_HALVING = False


def build_predefined_cv(X_tr: np.ndarray, y_tr: np.ndarray, X_te: np.ndarray, y_te: np.ndarray):
    X_all = np.vstack([X_tr, X_te])
    y_all = np.concatenate([y_tr, y_te])
    test_fold = np.array([-1] * len(y_tr) + [0] * len(y_te))
    cv = PredefinedSplit(test_fold)
    return X_all, y_all, cv


def prepare_train_test(
    X: pd.DataFrame,
    y: pd.Series,
    segment: dict,
    use_selected: bool = True,
    scale_x: bool = True,
    scale_y: bool = False,
):
    cols = app.selected_X_columns if use_selected and len(app.selected_X_columns) > 0 else list(X.columns)
    X_use = X[cols].copy()
    X_num = _prepare_X_for_selection(X_use)
    y_num = pd.to_numeric(y, errors="coerce")
    tr_idx = np.array(segment["train_index"], dtype=int)
    te_idx = np.array(segment["test_index"], dtype=int)
    X_tr = X_num.iloc[tr_idx].copy()
    X_te = X_num.iloc[te_idx].copy()
    y_tr = y_num.iloc[tr_idx].copy()
    y_te = y_num.iloc[te_idx].copy()
    x_scaler = StandardScaler(with_mean=True, with_std=True) if scale_x else None
    y_scaler = StandardScaler(with_mean=True, with_std=True) if scale_y else None
    if x_scaler is not None:
        X_tr.loc[:, :] = x_scaler.fit_transform(X_tr.values)
        X_te.loc[:, :] = x_scaler.transform(X_te.values)
    if y_scaler is not None:
        y_tr_vals = y_scaler.fit_transform(y_tr.values.reshape(-1, 1)).ravel()
        y_te_vals = y_scaler.transform(y_te.values.reshape(-1, 1)).ravel()
    else:
        y_tr_vals = y_tr.values
        y_te_vals = y_te.values
    return X_tr.values, y_tr_vals, X_te.values, y_te_vals, cols, x_scaler, y_scaler


def metric_and_direction(metric_key: str):
    # Retorna nombre sklearn y bool maximize, además de función métrica para reporting
    if metric_key == "R2":
        return ("r2", True, r2_score)
    if metric_key == "RMSE":
        return ("neg_root_mean_squared_error", False, lambda yt, yp: math.sqrt(mean_squared_error(yt, yp)))
    if metric_key == "MSE":
        return ("neg_mean_squared_error", False, mean_squared_error)
    if metric_key == "MAE":
        return ("neg_mean_absolute_error", False, mean_absolute_error)
    return ("r2", True, r2_score)


def compute_metrics(y_true: np.ndarray, y_pred: np.ndarray) -> dict:
    mse = mean_squared_error(y_true, y_pred)
    rmse = float(math.sqrt(mse))
    mae = float(mean_absolute_error(y_true, y_pred))
    r2 = float(r2_score(y_true, y_pred))
    residuals = y_true - y_pred
    try:
        kurt = float(stats.kurtosis(residuals, fisher=True, nan_policy="omit"))
    except Exception:
        kurt = float("nan")
    try:
        if len(residuals) < 5000:
            _, pnorm = stats.shapiro(residuals)
            pnorm = float(pnorm)
        else:
            _, pnorm = stats.normaltest(residuals)
            pnorm = float(pnorm)
    except Exception:
        pnorm = float("nan")
    return {"r2": r2, "rmse": rmse, "mse": float(mse), "mae": mae, "residual_kurtosis": kurt, "p_normal": pnorm}


def plot_best_diagnostics(y_true: np.ndarray, y_pred: np.ndarray, title_prefix: str = "SVR"):
    residuals = y_true - y_pred
    fig, axes = plt.subplots(2, 2, figsize=(12, 10))
    # Y real vs Predicho
    ax = axes[0, 0]
    ax.scatter(y_true, y_pred, alpha=0.5, s=18)
    lims = [min(np.min(y_true), np.min(y_pred)), max(np.max(y_true), np.max(y_pred))]
    ax.plot(lims, lims, "r--", lw=1)
    ax.set_xlabel("Y real")
    ax.set_ylabel("Y predicho")
    ax.set_title(f"{title_prefix}: Y real vs Y predicho")
    # Residuos vs Predicción
    ax = axes[0, 1]
    ax.scatter(y_pred, residuals, alpha=0.5, s=18)
    ax.axhline(0.0, color="r", linestyle="--", lw=1)
    ax.set_xlabel("Y predicho")
    ax.set_ylabel("Residuos")
    ax.set_title("Residuos vs Predicción")
    # Histograma de residuos
    ax = axes[1, 0]
    sns.histplot(residuals, kde=True, ax=ax, color="#1f77b4")
    ax.set_title("Distribución de residuos")
    ax.set_xlabel("Residuo")
    # QQ-Plot
    ax = axes[1, 1]
    stats.probplot(residuals, dist="norm", plot=ax)
    ax.set_title("QQ-Plot de residuos")
    plt.tight_layout()
    plt.show()


def safe_to_jsonable(obj):
    try:
        json.dumps(obj)
        return obj
    except Exception:
        if isinstance(obj, dict):
            return {k: safe_to_jsonable(v) for k, v in obj.items()}
        if isinstance(obj, (list, tuple)):
            return [safe_to_jsonable(v) for v in obj]
        return str(obj)


def persist_results_for_comparison(model_key: str, results: dict, file_path: str = "/workspace/svr_hpo_results.json"):
    try:
        try:
            with open(file_path, "r", encoding="utf-8") as f:
                existing = json.load(f)
        except Exception:
            existing = {}
        if not isinstance(existing, dict):
            existing = {}
        now = datetime.utcnow().isoformat() + "Z"
        existing.setdefault(model_key, []).append({
            "timestamp": now,
            **safe_to_jsonable(results),
        })
        with open(file_path, "w", encoding="utf-8") as f:
            json.dump(existing, f, ensure_ascii=False, indent=2)
    except Exception:
        pass

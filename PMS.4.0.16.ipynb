def _plot_history_grid(items):
	if not items:
		return
	cols_n = 2
	rows_n = int(_np_xgb.ceil(len(items) / cols_n))
	fig, axes = _plt_xgb.subplots(rows_n, cols_n, figsize=(10, rows_n * 2.2))
	axes = _np_xgb.atleast_2d(axes)
	for idx, (title, x, y, ylab) in enumerate(items):
		r = idx // cols_n; c = idx % cols_n
		ax = axes[r, c]
		plot_history_uniform(ax, x, y, f"{title}", ylab)
	for k in range(len(items), rows_n * cols_n):
		r = k // cols_n; c = k % cols_n
		axes[r, c].axis('off')
	_plt_xgb.tight_layout(); _plt_xgb.show()



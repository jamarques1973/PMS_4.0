def on_run_xgb(_):
	xgb_alert.clear_output(); xgb_histories_out.clear_output(); xgb_tables_out.clear_output(); xgb_best_out.clear_output(); xgb_progress_out.clear_output()
	prog = _widgets_xgb.IntProgress(value=0, min=0, max=7, description='HPO', bar_style='info')
	prog_label = _widgets_xgb.HTML(value='Preparando...')
	with xgb_progress_out:
		_display_xgb(_widgets_xgb.VBox([prog_label, prog]))
	# Validaciones
	if app.X is None or app.Y is None:
		with xgb_alert:
			_display_xgb(make_alert_html("Cargue X e Y antes de optimizar.", level="warning"))
		return
	y_col = None
	if 'sel_y_col' in globals() and sel_y_col.value is not None:
		y_col = sel_y_col.value
	elif 'y_col_dropdown' in globals() and y_col_dropdown.value is not None:
		y_col = y_col_dropdown.value
	if y_col is None:
		with xgb_alert:
			_display_xgb(make_alert_html("Seleccione una columna Y.", level="warning"))
		return
	if not app.segments:
		with xgb_alert:
			_display_xgb(make_alert_html("Genere la segmentación (Train/Test).", level="warning"))
		return
	seg = app.segments[0]
	use_sel = (_use_selected_chk_xgb.value if '_use_selected_chk_xgb' in globals() and _use_selected_chk_xgb is not None else (globals().get('use_selected_chk').value if globals().get('use_selected_chk') is not None else True))
	scale_x = (_scale_x_chk_xgb.value if '_scale_x_chk_xgb' in globals() and _scale_x_chk_xgb is not None else (globals().get('scale_x_chk').value if globals().get('scale_x_chk') is not None else True))
	scale_y = (_scale_y_chk_xgb.value if '_scale_y_chk_xgb' in globals() and _scale_y_chk_xgb is not None else (globals().get('scale_y_chk').value if globals().get('scale_y_chk') is not None else False))
	X_tr, y_tr, X_te, y_te, cols, _, _ = prepare_train_test(app.X, app.Y[y_col], seg, use_sel, scale_x, scale_y)
	_prefill_xgb_features(cols)
	if not _HAS_XGBOOST:
		_ensure_xgboost(progress_output=xgb_alert)
	# Dependencias opcionales
	need_opt = (xgb_run_optuna_chk.value and not (_HAS_OPTUNA_XGB or ('HAS_OPTUNA' in globals() and HAS_OPTUNA))) or \
				(xgb_run_skopt_chk.value and not (_HAS_SKOPT_XGB or ('HAS_SKOPT' in globals() and HAS_SKOPT))) or \
				(xgb_run_hyperopt_chk.value and not (_HAS_HYPEROPT_XGB or ('HAS_HYPEROPT' in globals() and HAS_HYPEROPT))) or \
				(xgb_run_bayesopt_chk.value and not (_HAS_BAYESOPT_XGB or ('HAS_BAYESOPT' in globals() and HAS_BAYESOPT)))
	if need_opt and 'ensure_optional_packages' in globals():
		ensure_optional_packages(progress_output=xgb_alert)

	ranges = _xgb_collect_ranges()
	skey, _, _metric_fn = metric_and_direction(xgb_metric_dropdown.value)
	seed = int(xgb_seed.value)

	results = []
	history_items = []
	try:
		if xgb_run_random_chk.value:
			prog_label.value = 'RandomizedSearchCV corriendo...'; prog.value = min(prog.max, prog.value + 1)
			res = _run_xgb_randomized(X_tr, y_tr, X_te, y_te, scoring_key=skey, seed=seed, ranges=ranges)
			results.append(res)
			hdf = res.get("history", _pd_xgb.DataFrame())
			if not hdf.empty and "mean_test_score" in hdf.columns:
				history_items.append(("RandomizedSearchCV", _np_xgb.arange(len(hdf)), hdf["mean_test_score"], "score"))
	except Exception as e:
		with xgb_alert:
			_display_xgb(make_alert_html(f"Error RandomizedSearchCV: {e}", level="error"))
	try:
		if xgb_run_halving_chk.value and _HAS_HALVING_XGB:
			prog_label.value = 'HalvingRandomSearchCV corriendo...'; prog.value = min(prog.max, prog.value + 1)
			res = _run_xgb_halving(X_tr, y_tr, X_te, y_te, scoring_key=skey, seed=seed, ranges=ranges)
			results.append(res)
			hdf = res.get("history", _pd_xgb.DataFrame())
			if not hdf.empty and "mean_test_score" in hdf.columns:
				history_items.append(("HalvingRandomSearchCV", _np_xgb.arange(len(hdf)), hdf["mean_test_score"], "score"))
	except Exception as e:
		with xgb_alert:
			_display_xgb(make_alert_html(f"Error Halving: {e}", level="error"))
	try:
		if xgb_run_skopt_chk.value and _HAS_SKOPT_XGB:
			prog_label.value = 'BayesSearchCV (skopt) corriendo...'; prog.value = min(prog.max, prog.value + 1)
			res = _run_xgb_skopt(X_tr, y_tr, X_te, y_te, scoring_key=skey, seed=seed, ranges=ranges)
			results.append(res)
			hdf = res.get("history", _pd_xgb.DataFrame())
			if not hdf.empty and "mean_test_score" in hdf.columns:
				history_items.append(("BayesSearchCV (skopt)", _np_xgb.arange(len(hdf)), hdf["mean_test_score"], "score"))
	except Exception as e:
		with xgb_alert:
			_display_xgb(make_alert_html(f"Error skopt: {e}", level="error"))
	try:
		if xgb_run_optuna_chk.value and _HAS_OPTUNA_XGB:
			prog_label.value = 'Optuna corriendo...'; prog.value = min(prog.max, prog.value + 1)
			res = _run_xgb_optuna(X_tr, y_tr, X_te, y_te, metric_key=xgb_metric_dropdown.value, seed=seed, ranges=ranges)
			results.append(res)
			hdf = res.get("history", _pd_xgb.DataFrame())
			if not hdf.empty:
				idx = hdf.index if 'number' not in hdf.columns else hdf['number']
				history_items.append(("Optuna", idx, hdf.get("value", _pd_xgb.Series(dtype=float)), "valor objetivo"))
	except Exception as e:
		with xgb_alert:
			_display_xgb(make_alert_html(f"Error Optuna: {e}", level="error"))
	try:
		if xgb_run_hyperopt_chk.value and _HAS_HYPEROPT_XGB:
			prog_label.value = 'Hyperopt corriendo...'; prog.value = min(prog.max, prog.value + 1)
			res = _run_xgb_hyperopt(X_tr, y_tr, X_te, y_te, metric_key=xgb_metric_dropdown.value, seed=seed, ranges=ranges)
			results.append(res)
			hdf = res.get("history", _pd_xgb.DataFrame())
			if not hdf.empty:
				history_items.append(("Hyperopt", hdf.get("iter", _pd_xgb.Series(range(1, len(hdf)+1))), hdf.get("loss", _pd_xgb.Series(dtype=float)), "loss"))
	except Exception as e:
		with xgb_alert:
			_display_xgb(make_alert_html(f"Error Hyperopt: {e}", level="error"))
	try:
		if xgb_run_bayesopt_chk.value and _HAS_BAYESOPT_XGB:
			prog_label.value = 'BayesianOptimization (bayes_opt) corriendo...'; prog.value = min(prog.max, prog.value + 1)
			res = _run_xgb_bayesopt(X_tr, y_tr, X_te, y_te, metric_key=xgb_metric_dropdown.value, seed=seed, ranges=ranges)
			results.append(res)
			hdf = res.get("history", _pd_xgb.DataFrame())
			if not hdf.empty:
				history_items.append(("BayesianOptimization (bayes_opt)", hdf.get("iter", _pd_xgb.Series(range(1, len(hdf)+1))), hdf.get("target", _pd_xgb.Series(dtype=float)), "target"))
	except Exception as e:
		with xgb_alert:
			_display_xgb(make_alert_html(f"Error bayes_opt: {e}", level="error"))

	if not results:
		with xgb_alert:
			_display_xgb(make_alert_html("Seleccione y ejecute al menos un motor.", level="warning"))
		return

	# Tabla comparativa
	rows = []
	for r in results:
		m = r.get("metrics", {})
		rows.append({
			"engine": r.get("engine"),
			"r2": m.get("r2"),
			"rmse": m.get("rmse"),
			"mae": m.get("mae"),
			"mse": m.get("mse"),
			"residual_kurtosis": m.get("residual_kurtosis"),
			"p_normal": m.get("p_normal"),
			"best_params": json.dumps(r.get("best_params", {}), ensure_ascii=False),
		})
	comp_df = _pd_xgb.DataFrame(rows)
	metric_key = xgb_metric_dropdown.value
	if metric_key == "R2":
		best_idx = int(comp_df["r2"].astype(float).idxmax())
	elif metric_key == "RMSE":
		best_idx = int(comp_df["rmse"].astype(float).idxmin())
	elif metric_key == "MAE":
		best_idx = int(comp_df["mae"].astype(float).idxmin())
	else:
		best_idx = int(comp_df["mse"].astype(float).idxmin())
	comp_df["is_best"] = False
	comp_df.loc[best_idx, "is_best"] = True

	if history_items:
		with xgb_histories_out:
			_plot_history_grid(history_items)

	with xgb_tables_out:
		_display_xgb(_widgets_xgb.HTML(value="<i>Función objetivo seleccionada:</i> " + metric_key + "."))
		show_df(comp_df, caption="Tabla comparativa de motores (XGB)", max_height=400, font_px=12)
		# Tabla de hiperparámetros por motor
		hp_rows = []
		for r in results:
			row = {"engine": r.get("engine")}
			for k, v in (r.get("best_params", {}) or {}).items():
				row[str(k)] = v
			hp_rows.append(row)
		hp_df = _pd_xgb.DataFrame(hp_rows).fillna("")
		_display_xgb(_widgets_xgb.HTML(value="<i>Hiperparámetros óptimos por motor</i>"))
		show_df(hp_df, caption="Hiperparámetros óptimos por motor (XGB)", max_height=400, font_px=12)
		# Barras por motor vs métrica
		fig, ax = _plt_xgb.subplots(figsize=(8, 4))
		engines = comp_df["engine"].astype(str).tolist()
		if metric_key == "R2":
			vals = comp_df["r2"].astype(float).tolist(); ax.bar(engines, vals, color="#1f77b4"); ax.set_ylabel("R2 (↑)")
		elif metric_key == "RMSE":
			vals = comp_df["rmse"].astype(float).tolist(); ax.bar(engines, vals, color="#ff7f0e"); ax.set_ylabel("RMSE (↓)")
		elif metric_key == "MAE":
			vals = comp_df["mae"].astype(float).tolist(); ax.bar(engines, vals, color="#2ca02c"); ax.set_ylabel("MAE (↓)")
		else:
			vals = comp_df["mse"].astype(float).tolist(); ax.bar(engines, vals, color="#9467bd"); ax.set_ylabel("MSE (↓)")
		ax.set_title("Comparativa de motores vs función objetivo"); ax.set_xticks(range(len(engines))); ax.set_xticklabels(engines, rotation=15, ha="right"); _plt_xgb.tight_layout(); _plt_xgb.show()

	# Mejor resultado: diagnósticos + features
	best_res = results[best_idx]
	y_pred_best = best_res.get("y_pred")
	with xgb_best_out:
		plot_best_diagnostics(y_te, y_pred_best, title_prefix=f"XGB [{best_res.get('engine')}] best")
		m = best_res.get("metrics", {})
		diag_table = _pd_xgb.DataFrame([{**m, "n_test": len(y_te)}])
		_display_xgb(_widgets_xgb.HTML(value="<i>Métricas del mejor modelo</i>"))
		_display_xgb(diag_table)

	# Feature importance + PDP grid
	try:
		# (Eliminado) Importancia y PDP por features — no aplica en XGB (HPO) sin xIA
		pass
	except Exception as e:
		with xgb_alert:
			_display_xgb(make_alert_html(f"Visualización de features falló: {e}", level="warning"))

	# Persistencia
	app.xgb_optim_results = {
		"y_column": y_col,
		"segment_name": seg.get("name"),
		"X_used_columns": cols,
		"metric_selection": metric_key,
		"engines": results,
		"comparison_table": comp_df.to_dict(orient="records"),
	}
	persist_payload = {
		"y_column": y_col,
		"segment": seg.get("name"),
		"metric": metric_key,
		"comparison": comp_df.to_dict(orient="records"),
		"best_engine": best_res.get("engine"),
		"best_params": best_res.get("best_params", {}),
		"best_metrics": best_res.get("metrics", {}),
		"X_used_columns": cols,
	}
	persist_results_for_comparison("XGB", persist_payload)
	prog.value = prog.max; prog.bar_style = 'success'; prog_label.value = 'HPO completado'
	with xgb_alert:
		_display_xgb(make_alert_html("Optimización XGB finalizada.", level="success"))



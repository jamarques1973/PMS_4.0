import numpy as _np_rf
import pandas as _pd_rf
import seaborn as _sns_rf
import ipywidgets as _widgets_rf
from typing import Any as _Any, Dict as _Dict, List as _List

from sklearn.ensemble import RandomForestRegressor as _RFRegressor
from sklearn.model_selection import RandomizedSearchCV as _RS, PredefinedSplit as _PredefinedSplit
from sklearn.metrics import r2_score as _r2_rf, mean_absolute_error as _mae_rf, mean_squared_error as _mse_rf

from scipy.stats import randint as _randint_rf, uniform as _uniform_rf

try:
    from skopt import BayesSearchCV as _BayesSearchCV_rf
    from skopt.space import Real as _Real_rf, Integer as _Integer_rf, Categorical as _Categorical_rf
    _HAS_SKOPT_RF = True
except Exception:
    _HAS_SKOPT_RF = False

try:
    import optuna as _optuna_rf
    _HAS_OPTUNA_RF = True
except Exception:
    _HAS_OPTUNA_RF = False



try:
    from bayes_opt import BayesianOptimization as _BO_rf
    _HAS_BAYESOPT_RF = True
except Exception:
    _HAS_BAYESOPT_RF = False


def _build_rf_from_params(params: _Dict[str, _Any], seed: int) -> _RFRegressor:
    n_estimators = int(round(float(params.get("n_estimators", 200))))
    max_depth = params.get("max_depth", None)
    if isinstance(max_depth, float) or isinstance(max_depth, str):
        try:
            max_depth = None if (str(max_depth).lower() in ("none", "nan", "null")) else int(round(float(max_depth)))
        except Exception:
            max_depth = None
    elif isinstance(max_depth, _np_rf.generic):
        try:
            max_depth = int(max_depth.item())
        except Exception:
            max_depth = None
    elif max_depth is not None:
        max_depth = int(max_depth)

    min_samples_split = int(round(float(params.get("min_samples_split", 2))))
    min_samples_leaf = int(round(float(params.get("min_samples_leaf", 1))))

    max_features = params.get("max_features", None)
    if isinstance(max_features, float) or isinstance(max_features, _np_rf.floating):
        max_features = float(max_features)
    elif str(max_features).lower() in ("none", "nan", "null"):
        max_features = None

    bootstrap = bool(params.get("bootstrap", True))
    max_samples = params.get("max_samples", None)
    if bootstrap:
        if max_samples is not None:
            try:
                max_samples = float(max_samples)
            except Exception:
                max_samples = None
    else:
        max_samples = None

    return _RFRegressor(
        n_estimators=n_estimators,
        max_depth=max_depth,
        min_samples_split=min_samples_split,
        min_samples_leaf=min_samples_leaf,
        max_features=max_features,
        bootstrap=bootstrap,
        max_samples=max_samples,
        n_jobs=-1,
        random_state=seed,
    )


def _sklearn_cv_to_df_rf(cv) -> "_pd_rf.DataFrame":
    try:
        df = _pd_rf.DataFrame(cv.cv_results_)
        cols = [c for c in df.columns if c.startswith("param_") or c in ("rank_test_score", "mean_test_score", "std_test_score")]
        return df[cols].sort_values("rank_test_score").reset_index(drop=True)
    except Exception:
        return _pd_rf.DataFrame()


def _rf_predefined_cv(X_tr, y_tr, X_te, y_te):
    X_all = _np_rf.vstack([X_tr, X_te])
    y_all = _np_rf.concatenate([y_tr, y_te])
    test_fold = _np_rf.array([-1] * len(y_tr) + [0] * len(y_te))
    cv = _PredefinedSplit(test_fold)
    return X_all, y_all, cv


def _run_rf_randomized(X_tr, y_tr, X_te, y_te, scoring_key: str, seed: int, ranges: _Dict[str, _Any]):
    depth_min = int(ranges["max_depth_min"])
    depth_max = int(ranges["max_depth_max"])
    allow_none = bool(ranges["allow_none_depth"]) 
    depth_options: _List[_Any] = list(range(depth_min, depth_max + 1))
    if allow_none:
        depth_options.append(None)

    param_distributions: _Dict[str, _Any] = {
        "n_estimators": _randint_rf(int(ranges["n_estimators_min"]), int(ranges["n_estimators_max"]) + 1),
        "max_depth": depth_options,
        "min_samples_split": _randint_rf(int(ranges["min_split_min"]), int(ranges["min_split_max"]) + 1),
        "min_samples_leaf": _randint_rf(int(ranges["min_leaf_min"]), int(ranges["min_leaf_max"]) + 1),
        "bootstrap": [True],
    }

    if bool(ranges["use_max_features_cats"]):
        cats = [c if c is not None else None for c in list(ranges["max_features_cats"])]
        if cats:
            param_distributions["max_features"] = cats
    else:
        fmin = float(ranges["max_features_frac_min"]) 
        fmax = float(ranges["max_features_frac_max"]) 
        if fmax > fmin:
            param_distributions["max_features"] = _uniform_rf(fmin, fmax - fmin)

    if bool(ranges["bootstrap_search"]) and float(ranges["max_samples_frac_max"]) > float(ranges["max_samples_frac_min"]):
        smin = float(ranges["max_samples_frac_min"]) 
        smax = float(ranges["max_samples_frac_max"]) 
        param_distributions["max_samples"] = _uniform_rf(smin, smax - smin)

    base = _RFRegressor(random_state=seed, n_jobs=-1)
    X_all, y_all, cv = _rf_predefined_cv(X_tr, y_tr, X_te, y_te)
    rs = _RS(
        estimator=base,
        param_distributions=param_distributions,
        n_iter=int(rf_n_iter_random.value),
        scoring=scoring_key,
        n_jobs=-1,
        cv=cv,
        refit=False,
        random_state=seed,
        verbose=0,
        return_train_score=False,
    )
    rs.fit(X_all, y_all)
    try:
        idx = int(rs.best_index_)
        best_params = {k.replace("param_", ""): rs.cv_results_[k][idx] for k in rs.cv_results_ if k.startswith("param_")}
    except Exception:
        best_params = {k.replace("param_", ""): v for k, v in rs.cv_results_.items() if k.startswith("param_")}
    best_params = {k: (v.item() if hasattr(v, "item") else v) for k, v in best_params.items()}
    model = _build_rf_from_params(best_params, seed)
    model.fit(X_tr, y_tr)
    y_pred = model.predict(X_te)
    metrics = compute_metrics(y_te, y_pred)
    hist_df = _sklearn_cv_to_df_rf(rs)
    return {"engine": "RandomizedSearchCV", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hist_df}


def _run_rf_halving(X_tr, y_tr, X_te, y_te, scoring_key: str, seed: int, ranges: _Dict[str, _Any]):
    if not HAS_HALVING:
        raise RuntimeError("HalvingRandomSearchCV no disponible en esta versión de sklearn.")
    depth_min = int(ranges["max_depth_min"])
    depth_max = int(ranges["max_depth_max"])
    allow_none = bool(ranges["allow_none_depth"]) 
    depth_options: _List[_Any] = list(range(depth_min, depth_max + 1))
    if allow_none:
        depth_options.append(None)

    param_distributions: _Dict[str, _Any] = {
        "n_estimators": _randint_rf(int(ranges["n_estimators_min"]), int(ranges["n_estimators_max"]) + 1),
        "max_depth": depth_options,
        "min_samples_split": _randint_rf(int(ranges["min_split_min"]), int(ranges["min_split_max"]) + 1),
        "min_samples_leaf": _randint_rf(int(ranges["min_leaf_min"]), int(ranges["min_leaf_max"]) + 1),
        "bootstrap": [True],
    }
    if bool(ranges["use_max_features_cats"]):
        cats = [c if c is not None else None for c in list(ranges["max_features_cats"])]
        if cats:
            param_distributions["max_features"] = cats
    else:
        fmin = float(ranges["max_features_frac_min"]) 
        fmax = float(ranges["max_features_frac_max"]) 
        if fmax > fmin:
            param_distributions["max_features"] = _uniform_rf(fmin, fmax - fmin)
    if bool(ranges["bootstrap_search"]) and float(ranges["max_samples_frac_max"]) > float(ranges["max_samples_frac_min"]):
        smin = float(ranges["max_samples_frac_min"]) 
        smax = float(ranges["max_samples_frac_max"]) 
        param_distributions["max_samples"] = _uniform_rf(smin, smax - smin)

    base = _RFRegressor(random_state=seed, n_jobs=-1)
    X_all, y_all, cv = _rf_predefined_cv(X_tr, y_tr, X_te, y_te)
    hrs = HalvingRandomSearchCV(
        estimator=base,
        param_distributions=param_distributions,
        factor=int(rf_halving_factor.value),
        min_resources=min(int(rf_halving_min_resources.value), len(y_tr)),
        scoring=scoring_key,
        n_jobs=-1,
        cv=cv,
        refit=False,
        random_state=seed,
        verbose=0,
        return_train_score=False,
    )
    hrs.fit(X_all, y_all)
    try:
        idx = int(hrs.best_index_)
        best_params = {k.replace("param_", ""): hrs.cv_results_[k][idx] for k in hrs.cv_results_ if k.startswith("param_")}
    except Exception:
        best_params = {k.replace("param_", ""): v for k, v in hrs.cv_results_.items() if k.startswith("param_")}
    best_params = {k: (v.item() if hasattr(v, "item") else v) for k, v in best_params.items()}
    model = _build_rf_from_params(best_params, seed)
    model.fit(X_tr, y_tr)
    y_pred = model.predict(X_te)
    metrics = compute_metrics(y_te, y_pred)
    hist_df = _sklearn_cv_to_df_rf(hrs)
    return {"engine": "HalvingRandomSearchCV", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hist_df}


def _run_rf_skopt(X_tr, y_tr, X_te, y_te, scoring_key: str, seed: int, ranges: _Dict[str, _Any]):
    if not _HAS_SKOPT_RF:
        raise RuntimeError("scikit-optimize (skopt) no disponible.")
    depth_min = int(ranges["max_depth_min"])
    depth_max = int(ranges["max_depth_max"])
    allow_none = bool(ranges["allow_none_depth"]) 
    depth_space: _List[_Any] = list(range(depth_min, depth_max + 1))
    if allow_none:
        depth_space.append(None)

    base = _RFRegressor(random_state=seed, n_jobs=-1)
    X_all, y_all, cv = _rf_predefined_cv(X_tr, y_tr, X_te, y_te)

    # Dos espacios condicionales para evitar max_samples con bootstrap=False
    spaces = []
    space_boot = {
        "n_estimators": _Integer_rf(int(ranges["n_estimators_min"]), int(ranges["n_estimators_max"])) ,
        "max_depth": _Categorical_rf(depth_space),
        "min_samples_split": _Integer_rf(int(ranges["min_split_min"]), int(ranges["min_split_max"])) ,
        "min_samples_leaf": _Integer_rf(int(ranges["min_leaf_min"]), int(ranges["min_leaf_max"])) ,
        "bootstrap": _Categorical_rf([True]),
    }
    if bool(ranges["use_max_features_cats"]):
        cats = [c if c is not None else None for c in list(ranges["max_features_cats"])]
        if cats:
            space_boot["max_features"] = _Categorical_rf(cats)
    else:
        fmin = float(ranges["max_features_frac_min"]) 
        fmax = float(ranges["max_features_frac_max"]) 
        if fmax > fmin:
            space_boot["max_features"] = _Real_rf(fmin, fmax)
    if float(ranges["max_samples_frac_max"]) > float(ranges["max_samples_frac_min"]):
        smin = float(ranges["max_samples_frac_min"]) 
        smax = float(ranges["max_samples_frac_max"]) 
        space_boot["max_samples"] = _Real_rf(smin, smax)
    spaces.append(space_boot)

    space_noboot = {
        "n_estimators": _Integer_rf(int(ranges["n_estimators_min"]), int(ranges["n_estimators_max"])) ,
        "max_depth": _Categorical_rf(depth_space),
        "min_samples_split": _Integer_rf(int(ranges["min_split_min"]), int(ranges["min_split_max"])) ,
        "min_samples_leaf": _Integer_rf(int(ranges["min_leaf_min"]), int(ranges["min_leaf_max"])) ,
        "bootstrap": _Categorical_rf([False]),
        # max_samples omitido para cumplir restricción de sklearn
    }
    if bool(ranges["use_max_features_cats"]):
        cats = [c if c is not None else None for c in list(ranges["max_features_cats"])]
        if cats:
            space_noboot["max_features"] = _Categorical_rf(cats)
    else:
        fmin = float(ranges["max_features_frac_min"]) 
        fmax = float(ranges["max_features_frac_max"]) 
        if fmax > fmin:
            space_noboot["max_features"] = _Real_rf(fmin, fmax)
    spaces.append(space_noboot)

    total_iter = max(2, int(rf_skopt_n_iter.value))
    it_boot = max(1, total_iter // 2)
    it_noboot = max(1, total_iter - it_boot)
    spaces_conf = [(space_boot, it_boot), (space_noboot, it_noboot)]
    opt = _BayesSearchCV_rf(
        estimator=base,
        search_spaces=spaces_conf,
        n_iter=total_iter,
        scoring=scoring_key,
        cv=cv,
        refit=False,
        n_jobs=-1,
        random_state=seed,
        verbose=0,
    )
    try:
        opt.fit(X_all, y_all)
    except Exception as e:
        # Si skopt fallara por un punto inválido aislado, continuar con mejores hasta el momento
        with rf_alert:
            display(make_alert_html(f"Error en BayesSearchCV: {e}", level="error"))
    try:
        best_params = opt.best_params_.copy()
    except Exception:
        # fallback si no hay .best_params_
        best_params = {}
    model = _build_rf_from_params(best_params or space_boot, seed)
    model.fit(X_tr, y_tr)
    y_pred = model.predict(X_te)
    metrics = compute_metrics(y_te, y_pred)
    hist_df = _sklearn_cv_to_df_rf(opt) if hasattr(opt, 'cv_results_') else _pd_rf.DataFrame()
    return {"engine": "BayesSearchCV (skopt)", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hist_df}


def _run_rf_optuna(X_tr, y_tr, X_te, y_te, metric_key: str, seed: int, ranges: _Dict[str, _Any]):
    if not _HAS_OPTUNA_RF:
        raise RuntimeError("Optuna no disponible.")
    skey, maximize, metric_fn = metric_and_direction(metric_key)

    def objective(trial: "_optuna_rf.trial.Trial") -> float:
        n_estimators = trial.suggest_int("n_estimators", int(ranges["n_estimators_min"]), int(ranges["n_estimators_max"]))
        allow_none = bool(ranges["allow_none_depth"]) 
        max_depth = trial.suggest_categorical("max_depth", list(range(int(ranges["max_depth_min"]), int(ranges["max_depth_max"]) + 1)) + ([None] if allow_none else []))
        min_split = trial.suggest_int("min_samples_split", int(ranges["min_split_min"]), int(ranges["min_split_max"]))
        min_leaf = trial.suggest_int("min_samples_leaf", int(ranges["min_leaf_min"]), int(ranges["min_leaf_max"]))
        if bool(ranges["use_max_features_cats"]):
            max_features = trial.suggest_categorical("max_features", list(ranges["max_features_cats"]))
        else:
            max_features = trial.suggest_float("max_features", float(ranges["max_features_frac_min"]), float(ranges["max_features_frac_max"]))
        bootstrap = trial.suggest_categorical("bootstrap", [True, False]) if bool(ranges["bootstrap_search"]) else True
        if bootstrap:
            max_samples = trial.suggest_float("max_samples", float(ranges["max_samples_frac_min"]), float(ranges["max_samples_frac_max"]))
        else:
            max_samples = None
        params = {
            "n_estimators": n_estimators,
            "max_depth": max_depth,
            "min_samples_split": min_split,
            "min_samples_leaf": min_leaf,
            "max_features": max_features,
            "bootstrap": bootstrap,
            "max_samples": max_samples,
        }
        model = _build_rf_from_params(params, seed)
        model.fit(X_tr, y_tr)
        y_pred = model.predict(X_te)
        score = metric_fn(y_te, y_pred)
        return score if maximize else float(score)

    study = _optuna_rf.create_study(direction="maximize" if metric_key == "R2" else "minimize")
    study.optimize(objective, n_trials=int(rf_optuna_trials.value), show_progress_bar=False)
    best_params = study.best_trial.params.copy()
    model = _build_rf_from_params(best_params, seed)
    model.fit(X_tr, y_tr)
    y_pred = model.predict(X_te)
    metrics = compute_metrics(y_te, y_pred)
    hist_df = _pd_rf.DataFrame({"value": [t.value for t in study.trials], "number": [t.number for t in study.trials]})
    return {"engine": "Optuna", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hist_df}




def _run_rf_bayesopt(X_tr, y_tr, X_te, y_te, metric_key: str, seed: int, ranges: _Dict[str, _Any]):
    if not _HAS_BAYESOPT_RF:
        raise RuntimeError("bayes_opt no disponible.")
    skey, maximize, metric_fn = metric_and_direction(metric_key)

    def objective_fun(n_estimators, max_depth_cont, min_split, min_leaf, max_features_frac, bootstrap_flag, max_samples_frac):
        params = {
            "n_estimators": int(round(n_estimators)),
            "max_depth": int(round(max_depth_cont)),
            "min_samples_split": int(round(min_split)),
            "min_samples_leaf": int(round(min_leaf)),
            "max_features": float(max_features_frac),
            "bootstrap": bool(int(round(bootstrap_flag))) if bool(ranges["bootstrap_search"]) else True,
            "max_samples": float(max_samples_frac) if bool(ranges["bootstrap_search"]) else None,
        }
        if bool(ranges["allow_none_depth"]) and params["max_depth"] < int(ranges["max_depth_min"]) + 1:
            params["max_depth"] = None
        model = _build_rf_from_params(params, seed)
        model.fit(X_tr, y_tr)
        y_pred = model.predict(X_te)
        score = metric_fn(y_te, y_pred)
        return score if maximize else float(score)

    pbounds = {
        "n_estimators": (float(ranges["n_estimators_min"]), float(ranges["n_estimators_max"])) ,
        "max_depth_cont": (float(ranges["max_depth_min"]), float(ranges["max_depth_max"])) ,
        "min_split": (float(ranges["min_split_min"]), float(ranges["min_split_max"])) ,
        "min_leaf": (float(ranges["min_leaf_min"]), float(ranges["min_leaf_max"])) ,
        "max_features_frac": (float(ranges["max_features_frac_min"]), float(ranges["max_features_frac_max"])) ,
        "bootstrap_flag": (0.0, 1.0),
        "max_samples_frac": (float(ranges["max_samples_frac_min"]), float(ranges["max_samples_frac_max"])) ,
    }
    optimizer = _BO_rf(f=objective_fun, pbounds=pbounds, random_state=seed, verbose=0)
    optimizer.maximize(init_points=10, n_iter=int(rf_n_iter_random.value))
    best = optimizer.max
    params_best = best.get("params", {})
    best_params = {
        "n_estimators": int(round(params_best.get("n_estimators", 200))),
        "max_depth": int(round(params_best.get("max_depth_cont", ranges["max_depth_max"]))),
        "min_samples_split": int(round(params_best.get("min_split", 2))),
        "min_samples_leaf": int(round(params_best.get("min_leaf", 1))),
        "max_features": float(params_best.get("max_features_frac", 1.0)),
        "bootstrap": bool(int(round(params_best.get("bootstrap_flag", 1.0)))) if bool(ranges["bootstrap_search"]) else True,
        "max_samples": float(params_best.get("max_samples_frac", 1.0)) if bool(ranges["bootstrap_search"]) else None,
    }
    if bool(ranges["allow_none_depth"]) and best_params["max_depth"] < int(ranges["max_depth_min"]) + 1:
        best_params["max_depth"] = None
    model = _build_rf_from_params(best_params, seed)
    model.fit(X_tr, y_tr)
    y_pred = model.predict(X_te)
    metrics = compute_metrics(y_te, y_pred)
    # Construir historial de manera robusta a versiones
    try:
        logs = getattr(optimizer, 'space', None)
        targets = getattr(logs, 'target', None)
        if targets is not None and len(targets) > 0:
            hist_df = _pd_rf.DataFrame({"iter": list(range(1, len(targets)+1)), "target": list(targets)})
        else:
            hist_df = _pd_rf.DataFrame()
    except Exception:
        hist_df = _pd_rf.DataFrame()
    return {"engine": "BayesianOptimization (bayes_opt)", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hist_df}


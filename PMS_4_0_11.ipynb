def get_long_explanation(kind: str, feature: str = None) -> widgets.HTML:
    key = kind
    if key not in _LONG_TEXTS:
        _LONG_TEXTS[key] = widgets.HTML(value=_make_long(kind))
    return _LONG_TEXTS[key]


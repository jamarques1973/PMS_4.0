def _rnn_collect_ranges() -> _Dict[str, Any]:
	return {
		"seq_len": int(rnn_seq_len.value),
		"layers_min": int(rnn_layers_min.value),
		"layers_max": int(rnn_layers_max.value),
		"units_min": int(rnn_units_min.value),
		"units_max": int(rnn_units_max.value),
		"dropout_min": float(rnn_dropout_min.value),
		"dropout_max": float(rnn_dropout_max.value),
		"rec_dropout_min": float(rnn_rec_drop_min.value),
		"rec_dropout_max": float(rnn_rec_drop_max.value),
		"lr_min": float(rnn_lr_min.value),
		"lr_max": float(rnn_lr_max.value),
		"allow_bidirectional": bool(rnn_allow_bidir.value),
		"use_LSTM": bool(rnn_use_lstm.value),
		"use_GRU": bool(rnn_use_gru.value),
		"use_SimpleRNN": bool(rnn_use_srnn.value),
	}


def _plot_history_grid(items: _List[_Tuple[str, np.ndarray, np.ndarray, str]]):
	if not items:
		return
	cols = 2
	rows = int(math.ceil(len(items)/cols))
	fig, axes = plt.subplots(rows, cols, figsize=(5.4*cols, 2.8*rows))
	if rows == 1 and cols == 1:
		axes = np.array([[axes]])
	axes = axes.reshape(rows, cols)
	for idx, (name, x, y, ylab) in enumerate(items):
		r = idx // cols; c = idx % cols
		ax = axes[r, c]
		ax.plot(x, y, marker='o', lw=1.0)
		ax.set_title(name)
		ax.set_xlabel('iter')
		ax.set_ylabel(ylab)
	for i in range(rows * cols - len(items)):
		fig.delaxes(axes.flatten()[-(i+1)])
	plt.tight_layout(); plt.show()


def on_run_rnn(_):
	global HAS_OPTUNA_RNN, HAS_HYPEROPT_RNN, HAS_SKOPT_RNN, HAS_BAYESOPT_RNN
	rnn_alert.clear_output(); rnn_histories_out.clear_output(); rnn_tables_out.clear_output(); rnn_best_out.clear_output(); rnn_progress_out.clear_output()
	with rnn_progress_out:
		prog = widgets.IntProgress(value=0, min=0, max=6, description='HPO', bar_style='info')
		prog_label = widgets.HTML(value='Preparando...')
		display(widgets.VBox([prog_label, prog]))
	# consola de log
	rnn_log_out.clear_output()
	with rnn_log_out:
		print("[RNN] Inicio de optimización")
	# Validaciones
	if getattr(app, 'X', None) is None or getattr(app, 'Y', None) is None:
		with rnn_alert:
			display(widgets.HTML(value="<div style='color:#b00'>Cargue X e Y antes de optimizar.</div>"))
		return
	# Columna Y
	y_col = None
	try:
		if 'sel_y_col' in globals() and sel_y_col.value is not None:
			y_col = sel_y_col.value
		elif 'y_col_dropdown' in globals() and y_col_dropdown.value is not None:
			y_col = y_col_dropdown.value
	except Exception:
		pass
	if y_col is None:
		with rnn_alert:
			display(widgets.HTML(value="<div style='color:#b00'>Seleccione una columna Y.</div>"))
		return
	if not getattr(app, 'segments', []):
		with rnn_alert:
			display(widgets.HTML(value="<div style='color:#b00'>Genere la segmentación (Train/Test).</div>"))
		return
	# TF disponible
	if not ensure_dl_packages(progress_output=rnn_alert):
		return
	# Preparar datos
	seg = app.segments[0]
	use_sel = globals().get('use_selected_chk').value if globals().get('use_selected_chk') is not None else True
	scale_x = globals().get('scale_x_chk').value if globals().get('scale_x_chk') is not None else True
	scale_y = globals().get('scale_y_chk').value if globals().get('scale_y_chk') is not None else False
	X_tr, y_tr, X_te, y_te, cols, _, _ = prepare_train_test(app.X, app.Y[y_col], seg, use_sel, scale_x, scale_y)
	seq_len = int(max(1, rnn_seq_len.value))
	X_tr_seq, y_tr_seq = make_sequences(X_tr, y_tr, seq_len)
	X_te_seq, y_te_seq = make_sequences(X_te, y_te, seq_len)
	if X_tr_seq.shape[0] < 10 or X_te_seq.shape[0] < 5:
		with rnn_alert:
			display(widgets.HTML(value=f"<div style='color:#b00'>Secuencias insuficientes para entrenar (Train={X_tr_seq.shape[0]}, Test={X_te_seq.shape[0]}). Reduzca seq_len.</div>"))
		return
	# Rango y motores
	ranges = _rnn_collect_ranges()
	seed = int(rnn_seed.value)
	metric_key = rnn_metric_dropdown.value
	epochs = int(rnn_epochs.value); batch = int(rnn_batch_size.value); patience = int(rnn_patience.value)
	# incluir verbosity en params base de motores
	ranges["fit_verbose"] = int(rnn_fit_verbose.value)
	ranges["trace_epochs"] = bool(rnn_trace_epochs.value)
	# Instalar paquetes opcionales HPO si faltan
	need_opt = (rnn_run_optuna_chk.value and not HAS_OPTUNA_RNN) or (rnn_run_hyperopt_chk.value and not HAS_HYPEROPT_RNN) or (rnn_run_skopt_chk.value and not HAS_SKOPT_RNN) or (rnn_run_bayesopt_chk.value and not HAS_BAYESOPT_RNN)
	if need_opt and 'ensure_optional_packages' in globals():
		prog_label.value = 'Instalando dependencias HPO...'
		ensure_optional_packages(progress_output=rnn_alert)
		prog.value = min(prog.max, prog.value + 1)
		# Re-evaluar flags
		try:
			import optuna; HAS_OPTUNA_RNN = True
		except Exception:
			HAS_OPTUNA_RNN = False
		try:
			from hyperopt import hp as _hp_rnn  # noqa: F401
			HAS_HYPEROPT_RNN = True
		except Exception:
			HAS_HYPEROPT_RNN = False
		try:
			from skopt import gp_minimize as _gp_minimize_rnn  # noqa: F401
			HAS_SKOPT_RNN = True
		except Exception:
			HAS_SKOPT_RNN = False
		try:
			from bayes_opt import BayesianOptimization as _BO_rnn  # noqa: F401
			HAS_BAYESOPT_RNN = True
		except Exception:
			HAS_BAYESOPT_RNN = False
	results = []
	history_items: _List[_Tuple[str, np.ndarray, np.ndarray, str]] = []
	# RandomSearch
	try:
		if rnn_run_random_chk.value:
			prog_label.value = 'RandomSearch corriendo...'; prog.value = min(prog.max, prog.value + 1)
			with rnn_log_out:
				print("[RandomSearch] inicio")
			res = run_rnn_random_search(X_tr_seq, y_tr_seq, X_te_seq, y_te_seq, metric_key=metric_key, seed=seed, ranges=ranges, epochs=epochs, batch_size=batch, patience=patience, n_iter=int(rnn_random_n_iter.value))
			with rnn_log_out:
				print("[RandomSearch] fin")
			results.append(res)
			hdf = res.get("history", pd.DataFrame())
			if not hdf.empty:
				history_items.append(("RandomSearch", hdf["iter"].to_numpy(), hdf["value"].to_numpy(), "objetivo"))
	except Exception as e:
		with rnn_alert:
			display(widgets.HTML(value=f"<div style='color:#b00'>Error RandomSearch: {e}</div>"))
	# Halving
	try:
		if rnn_run_halving_chk.value:
			prog_label.value = 'Halving corriendo...'; prog.value = min(prog.max, prog.value + 1)
			with rnn_log_out:
				print("[Halving] inicio")
			res = run_rnn_halving(X_tr_seq, y_tr_seq, X_te_seq, y_te_seq, metric_key=metric_key, seed=seed, ranges=ranges, n_candidates=int(rnn_halving_n_cands.value), factor=int(rnn_halving_factor.value), min_epochs=int(rnn_halving_min_epochs.value), max_epochs=int(rnn_halving_max_epochs.value), batch_size=batch, patience=patience)
			with rnn_log_out:
				print("[Halving] fin")
			results.append(res)
			hdf = res.get("history", pd.DataFrame())
			if not hdf.empty:
				xcol = "round" if "round" in hdf.columns else ("epochs" if "epochs" in hdf.columns else None)
				if xcol is not None and "value" in hdf.columns:
					history_items.append(("Halving", hdf[xcol].to_numpy(), hdf["value"].to_numpy(), "objetivo"))
	except Exception as e:
		with rnn_alert:
			display(widgets.HTML(value=f"<div style='color:#b00'>Error Halving: {e}</div>"))
	# Optuna
	try:
		if rnn_run_optuna_chk.value and HAS_OPTUNA_RNN:
			prog_label.value = 'Optuna corriendo...'; prog.value = min(prog.max, prog.value + 1)
			_rnn_log("[Optuna] inicio")
			res = run_rnn_optuna(X_tr_seq, y_tr_seq, X_te_seq, y_te_seq, metric_key=metric_key, seed=seed, ranges=ranges, trials=int(rnn_optuna_trials.value), epochs=epochs, batch_size=batch, patience=patience)
			_rnn_log("[Optuna] fin")
			results.append(res)
			hdf = res.get("history", pd.DataFrame())
			if not hdf.empty and "number" in hdf.columns and "value" in hdf.columns:
				history_items.append(("Optuna", hdf["number"].to_numpy(), hdf["value"].to_numpy(), "valor objetivo"))
	except Exception as e:
		with rnn_alert:
			display(widgets.HTML(value=f"<div style='color:#b00'>Error Optuna: {e}</div>"))
	# Hyperopt
	try:
		if rnn_run_hyperopt_chk.value and HAS_HYPEROPT_RNN:
			prog_label.value = 'Hyperopt corriendo...'; prog.value = min(prog.max, prog.value + 1)
			_rnn_log("[Hyperopt] inicio")
			res = run_rnn_hyperopt(X_tr_seq, y_tr_seq, X_te_seq, y_te_seq, metric_key=metric_key, seed=seed, ranges=ranges, max_evals=int(rnn_hyperopt_evals.value), epochs=epochs, batch_size=batch, patience=patience)
			_rnn_log("[Hyperopt] fin")
			results.append(res)
			hdf = res.get("history", pd.DataFrame())
			if not hdf.empty and "iter" in hdf.columns:
				history_items.append(("Hyperopt", hdf["iter"].to_numpy(), hdf["value"].to_numpy(), "objetivo"))
	except Exception as e:
		with rnn_alert:
			display(widgets.HTML(value=f"<div style='color:#b00'>Error Hyperopt: {e}</div>"))
	# skopt
	try:
		if rnn_run_skopt_chk.value and HAS_SKOPT_RNN:
			prog_label.value = 'Bayes (skopt) corriendo...'; prog.value = min(prog.max, prog.value + 1)
			_rnn_log("[skopt] inicio")
			res = run_rnn_skopt(X_tr_seq, y_tr_seq, X_te_seq, y_te_seq, metric_key=metric_key, seed=seed, ranges=ranges, n_calls=int(max(10, rnn_skopt_calls.value)), epochs=epochs, batch_size=batch, patience=patience)
			_rnn_log("[skopt] fin")
			results.append(res)
			hdf = res.get("history", pd.DataFrame())
			if not hdf.empty and "iter" in hdf.columns and "value" in hdf.columns:
				history_items.append(("Bayes (skopt)", hdf["iter"].to_numpy(), hdf["value"].to_numpy(), "objetivo"))
	except Exception as e:
		with rnn_alert:
			display(widgets.HTML(value=f"<div style='color:#b00'>Error skopt: {e}</div>"))
	# bayes_opt
	try:
		if rnn_run_bayesopt_chk.value and HAS_BAYESOPT_RNN:
			prog_label.value = 'BayesianOptimization corriendo...'; prog.value = min(prog.max, prog.value + 1)
			_rnn_log("[bayes_opt] inicio")
			res = run_rnn_bayesopt(X_tr_seq, y_tr_seq, X_te_seq, y_te_seq, metric_key=metric_key, seed=seed, ranges=ranges, init_points=int(rnn_bayesopt_init.value), n_iter=int(rnn_bayesopt_iter.value), epochs=epochs, batch_size=batch, patience=patience)
			_rnn_log("[bayes_opt] fin")
			results.append(res)
			hdf = res.get("history", pd.DataFrame())
			if not hdf.empty and "iter" in hdf.columns:
				history_items.append(("BayesianOptimization", hdf["iter"].to_numpy(), hdf["value"].to_numpy(), "objetivo"))
	except Exception as e:
		with rnn_alert:
			display(widgets.HTML(value=f"<div style='color:#b00'>Error bayes_opt: {e}</div>"))

	if not results:
		with rnn_alert:
			display(widgets.HTML(value="<div style='color:#b00'>Seleccione y ejecute al menos un motor.</div>"))
		return
	prog_label.value = 'Compilando resultados...'; prog.value = prog.max
	# Historiales en grid
	if history_items:
		with rnn_histories_out:
			_plot_history_grid(history_items)
	# Comparativa y mejor
	rows = []
	for r in results:
		m = r.get("metrics", {})
		rows.append({
			"engine": r.get("engine"),
			"r2": m.get("r2"),
			"rmse": m.get("rmse"),
			"mae": m.get("mae"),
			"mse": m.get("mse"),
			"residual_kurtosis": m.get("residual_kurtosis"),
			"p_normal": m.get("p_normal"),
			"best_params": json.dumps(r.get("best_params", {}), ensure_ascii=False),
		})
	comp_df = pd.DataFrame(rows)
	# Elegir mejor
	metric_key = rnn_metric_dropdown.value
	if metric_key == "R2":
		best_idx = int(comp_df["r2"].astype(float).idxmax())
	elif metric_key == "RMSE":
		best_idx = int(comp_df["rmse"].astype(float).idxmin())
	elif metric_key == "MAE":
		best_idx = int(comp_df["mae"].astype(float).idxmin())
	else:
		best_idx = int(comp_df["mse"].astype(float).idxmin())
	comp_df["is_best"] = False; comp_df.loc[best_idx, "is_best"] = True
	with rnn_tables_out:
		display(widgets.HTML(value=f"<i>Función objetivo:</i> {metric_key}."))
		display(comp_df)
	# Diagnóstico del mejor
	best = results[best_idx]
	y_pred = best.get("y_pred", np.zeros_like(y_te_seq))
	from IPython.display import HTML as _HTML
	with rnn_best_out:
		try:
			plot_best_diagnostics(y_te_seq, y_pred, title_prefix=f"RNN [{best.get('engine')}] best")
		except Exception:
			# Plot mínimo si la utilidad no existe
			fig, axes = plt.subplots(2, 2, figsize=(12, 10))
			ax = axes[0,0]; ax.scatter(y_te_seq, y_pred, s=16, alpha=0.6); lims=[min(y_te_seq.min(), y_pred.min()), max(y_te_seq.max(), y_pred.max())]; ax.plot(lims, lims, 'r--'); ax.set_title('Y vs Ypred'); ax = axes[0,1]; res=y_te_seq-y_pred; ax.scatter(y_pred, res, s=16, alpha=0.6); ax.axhline(0, color='r', ls='--'); ax.set_title('Residuos'); ax=axes[1,0]; sns.histplot(res, kde=True, ax=ax); ax.set_title('Hist resid'); ax=axes[1,1]; stats.probplot(res, dist='norm', plot=ax); ax.set_title('QQ-Plot'); plt.tight_layout(); plt.show()
	# Persistir para comparaciones
	try:
		persist_results_for_comparison("RNN", {"engines": rows, "best": rows[best_idx]})
	except Exception:
		pass

btn_run_rnn.on_click(on_run_rnn)


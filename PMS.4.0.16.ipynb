if 'prepare_train_test' not in globals():
	from sklearn.preprocessing import StandardScaler
	def prepare_train_test(X: pd.DataFrame, y: pd.Series, segment: dict, use_selected: bool = True, scale_x: bool = True, scale_y: bool = False):
		cols = (app.selected_X_columns if use_selected and getattr(app, 'selected_X_columns', []) else list(X.columns))
		X_use = X[cols].copy()
		X_num = X_use.apply(pd.to_numeric, errors='coerce').fillna(method='ffill').fillna(method='bfill')
		y_num = pd.to_numeric(y, errors='coerce')
		tr_idx = np.array(segment.get('train_index', []), dtype=int)
		te_idx = np.array(segment.get('test_index', []), dtype=int)
		X_tr = X_num.iloc[tr_idx].copy(); X_te = X_num.iloc[te_idx].copy()
		y_tr = y_num.iloc[tr_idx].copy(); y_te = y_num.iloc[te_idx].copy()
		x_scaler = StandardScaler(with_mean=True, with_std=True) if scale_x else None
		y_scaler = StandardScaler(with_mean=True, with_std=True) if scale_y else None
		if x_scaler is not None:
			X_tr.loc[:, :] = x_scaler.fit_transform(X_tr.values); X_te.loc[:, :] = x_scaler.transform(X_te.values)
		if y_scaler is not None:
			y_tr_vals = y_scaler.fit_transform(y_tr.values.reshape(-1,1)).ravel(); y_te_vals = y_scaler.transform(y_te.values.reshape(-1,1)).ravel()
		else:
			y_tr_vals = y_tr.values; y_te_vals = y_te.values
		return X_tr.values, y_tr_vals, X_te.values, y_te_vals, cols, x_scaler, y_scaler

if 'metric_and_direction' not in globals():
	from sklearn.metrics import r2_score, mean_squared_error, mean_absolute_error
	def metric_and_direction(metric_key: str):
		if metric_key == 'R2':
			return ('r2', True, r2_score)
		if metric_key == 'RMSE':
			return ('neg_root_mean_squared_error', False, lambda yt, yp: math.sqrt(mean_squared_error(yt, yp)))
		if metric_key == 'MAE':
			return ('neg_mean_absolute_error', False, mean_absolute_error)
		return ('neg_mean_squared_error', False, mean_squared_error)

if 'compute_metrics' not in globals():
	from sklearn.metrics import r2_score, mean_squared_error, mean_absolute_error
	def compute_metrics(y_true: np.ndarray, y_pred: np.ndarray) -> dict:
		mse = mean_squared_error(y_true, y_pred); rmse = float(math.sqrt(mse)); mae = float(mean_absolute_error(y_true, y_pred)); r2 = float(r2_score(y_true, y_pred))
		residuals = y_true - y_pred
		try:
			kurt = float(stats.kurtosis(residuals, fisher=True, nan_policy='omit'))
		except Exception:
			kurt = float('nan')
		try:
			if len(residuals) < 5000:
				_, pnorm = stats.shapiro(residuals)
			else:
				_, pnorm = stats.normaltest(residuals)
			pnorm = float(pnorm)
		except Exception:
			pnorm = float('nan')
		return {"r2": r2, "rmse": rmse, "mse": float(mse), "mae": mae, "residual_kurtosis": kurt, "p_normal": pnorm}

# Secuencias (RNN)

def make_sequences(X: np.ndarray, y: np.ndarray, seq_len: int) -> _Tuple[np.ndarray, np.ndarray]:
	seq_len = int(max(1, seq_len))
	if X.ndim != 2:
		raise ValueError("X debe ser 2D (n, p) antes de secuenciar.")
	n, p = X.shape
	if n < seq_len:
		return np.zeros((0, seq_len, p)), np.zeros((0,), dtype=float)
	Xs = np.lib.stride_tricks.sliding_window_view(X, window_shape=(seq_len, p))
	Xs = Xs.reshape(-1, seq_len, p)
	# sliding_window_view devuelve ventanas por bloque; recortar a n-seq_len+1
	Xs = Xs[: (n - seq_len + 1)]
	ys = y[seq_len - 1:]
	return Xs, ys


# Construcción de modelo Keras

def build_rnn_model(params: _Dict[str, Any], input_shape: _Tuple[int, int]) -> "keras.Model":
	if not _HAS_TF:
		raise RuntimeError("TensorFlow no disponible.")
	cell_type = str(params.get('cell_type', 'LSTM'))
	num_layers = int(params.get('num_layers', 1))
	units = int(params.get('units', 64))
	dropout = float(params.get('dropout', 0.0))
	rec_dropout = float(params.get('recurrent_dropout', 0.0))
	bidirectional = bool(params.get('bidirectional', False))
	dense_units = int(params.get('dense_units', 0))
	activation = str(params.get('activation', 'tanh'))
	lr = float(params.get('lr', 1e-3))
	optimizer_name = str(params.get('optimizer', 'adam'))

	model = keras.Sequential()
	# Primera capa RNN
	RNNLayer = { 'LSTM': keras.layers.LSTM, 'GRU': keras.layers.GRU, 'SimpleRNN': keras.layers.SimpleRNN }.get(cell_type, keras.layers.LSTM)
	for i in range(max(1, num_layers)):
		return_sequences = (i < num_layers - 1)
		layer = RNNLayer(units=units, activation=activation, dropout=dropout, recurrent_dropout=rec_dropout, return_sequences=return_sequences)
		if i == 0:
			if bidirectional:
				model.add(keras.layers.Bidirectional(layer, input_shape=input_shape))
			else:
				model.add(layer.__class__(**layer.get_config(), input_shape=input_shape))
		else:
			if bidirectional:
				model.add(keras.layers.Bidirectional(layer))
			else:
				model.add(layer.__class__(**layer.get_config()))
	# Capa densa intermedia opcional
	if dense_units and dense_units > 0:
		model.add(keras.layers.Dense(int(dense_units), activation='relu'))
	# Salida lineal para regresión
	model.add(keras.layers.Dense(1, activation='linear'))
	# Optimizador
	if optimizer_name.lower() == 'adam':
		opt = keras.optimizers.Adam(learning_rate=lr)
	elif optimizer_name.lower() == 'rmsprop':
		opt = keras.optimizers.RMSprop(learning_rate=lr)
	else:
		opt = keras.optimizers.Adam(learning_rate=lr)
	model.compile(optimizer=opt, loss='mse', metrics=[keras.metrics.MeanAbsoluteError(name='mae')])
	return model


def train_predict_rnn(params: _Dict[str, Any], X_tr_seq: np.ndarray, y_tr: np.ndarray, X_te_seq: np.ndarray, y_te: np.ndarray, use_val_for_es: bool = True, trace_epochs: bool = False) -> _Tuple[np.ndarray, _Dict[str, Any]]:
	model = build_rnn_model(params, input_shape=(X_tr_seq.shape[1], X_tr_seq.shape[2]))
	epochs = int(params.get('epochs', 50))
	batch_size = int(params.get('batch_size', 64))
	patience = int(params.get('patience', 10))
	fit_verbose = int(params.get('fit_verbose', 0))
	# Callback para traza por época
	class EpochLogger(keras.callbacks.Callback):
		def __init__(self, out: widgets.Output, every: int = 1) -> None:
			self.out = out; self.every = max(1, int(every))
		def on_epoch_end(self, epoch, logs=None):
			if epoch % self.every == 0:
				try:
					with self.out:
						print(f"[fit] epoch={epoch+1}/{epochs} loss={logs.get('loss'):.4f} val_loss={logs.get('val_loss'):.4f if logs and 'val_loss' in logs else float('nan'):.4f}")
				except Exception:
					pass
	es = keras.callbacks.EarlyStopping(monitor='val_loss' if use_val_for_es else 'loss', patience=patience, restore_best_weights=True)
	callbacks = [es]
	if trace_epochs:
		callbacks.append(EpochLogger(rnn_log_out, every=1))
	history = model.fit(
		X_tr_seq, y_tr,
		validation_data=(X_te_seq, y_te) if use_val_for_es else None,
		epochs=epochs, batch_size=batch_size, verbose=fit_verbose,
		callbacks=callbacks
	)
	y_pred = model.predict(X_te_seq, verbose=0).ravel()
	return y_pred, {"history": history.history}


# Espacios de búsqueda y muestreo aleatorio

def _sample_params(rng: np.random.Generator, ranges: _Dict[str, Any]) -> _Dict[str, Any]:
	def _log_uniform(a: float, b: float) -> float:
		return float(np.exp(np.log(a) + rng.random() * (np.log(b) - np.log(a))))
	cell_types = [ct for ct, on in [("LSTM", ranges.get("use_LSTM", True)), ("GRU", ranges.get("use_GRU", True)), ("SimpleRNN", ranges.get("use_SimpleRNN", False))] if on]
	if not cell_types:
		cell_types = ["LSTM"]
	return {
		"cell_type": rng.choice(cell_types),
		"num_layers": int(rng.integers(int(ranges["layers_min"]), int(ranges["layers_max"]) + 1)),
		"units": int(rng.integers(int(ranges["units_min"]), int(ranges["units_max"]) + 1)),
		"dropout": float(rng.uniform(float(ranges["dropout_min"]), float(ranges["dropout_max"]))),
		"recurrent_dropout": float(rng.uniform(float(ranges["rec_dropout_min"]), float(ranges["rec_dropout_max"]))),
		"bidirectional": bool(rng.choice([True, False])) if bool(ranges.get("allow_bidirectional", True)) else False,
		"dense_units": int(rng.choice([0, 32, 64, 128, 256])),
		"activation": str(rng.choice(["tanh", "relu"])),
		"lr": float(_log_uniform(float(ranges["lr_min"]), float(ranges["lr_max"]))),
		"optimizer": str(rng.choice(["adam", "rmsprop"])),
		"fit_verbose": int(ranges.get("fit_verbose", 0)),
	}


# Motores de optimización

def run_rnn_random_search(X_tr_seq: np.ndarray, y_tr: np.ndarray, X_te_seq: np.ndarray, y_te: np.ndarray, metric_key: str, seed: int, ranges: _Dict[str, Any], epochs: int, batch_size: int, patience: int, n_iter: int) -> _Dict[str, Any]:
	rng = np.random.default_rng(int(seed))
	skey, maximize, metric_fn = metric_and_direction(metric_key)
	history_df = []
	best_score = -1e300 if maximize else 1e300
	best_params, best_pred, best_metrics = None, None, None
	for it in range(int(n_iter)):
		params = _sample_params(rng, ranges)
		params.update({"epochs": epochs, "batch_size": batch_size, "patience": patience})
		try:
			_rnn_log(f"[RandomSearch] iter {it+1}/{int(n_iter)} …")
			y_pred, hist = train_predict_rnn(params, X_tr_seq, y_tr, X_te_seq, y_te, use_val_for_es=True, trace_epochs=bool(ranges.get('trace_epochs', True)))
			score = float(metric_fn(y_te, y_pred))
			_rnn_log(f"[RandomSearch] iter {it+1} value={score:.6f}")
			history_df.append({"iter": it, "value": score})
			is_better = (score > best_score) if maximize else (score < best_score)
			if is_better:
				best_score = score; best_params = params.copy(); best_pred = y_pred.copy(); best_metrics = compute_metrics(y_te, y_pred)
		except Exception as _e:
			_rnn_log(f"[RandomSearch] iter {it+1} error: {_e}")
			continue
	hdf = pd.DataFrame(history_df)
	return {"engine": "RandomSearch", "best_params": best_params or {}, "y_pred": best_pred if best_pred is not None else np.zeros_like(y_te), "metrics": best_metrics or {}, "history": hdf}


def run_rnn_halving(X_tr_seq: np.ndarray, y_tr: np.ndarray, X_te_seq: np.ndarray, y_te: np.ndarray, metric_key: str, seed: int, ranges: _Dict[str, Any], n_candidates: int, factor: int, min_epochs: int, max_epochs: int, batch_size: int, patience: int) -> _Dict[str, Any]:
	rng = np.random.default_rng(int(seed))
	skey, maximize, metric_fn = metric_and_direction(metric_key)
	cands = [ _sample_params(rng, ranges) for _ in range(int(n_candidates)) ]
	epochs = int(min_epochs)
	all_hist = []
	while len(cands) > 1 and epochs <= int(max_epochs):
		results = []
		for i, p in enumerate(cands):
			pp = p.copy(); pp.update({"epochs": epochs, "batch_size": batch_size, "patience": max(2, patience//2)})
			try:
				y_pred, _ = train_predict_rnn(pp, X_tr_seq, y_tr, X_te_seq, y_te, use_val_for_es=True)
				score = float(metric_fn(y_te, y_pred))
				results.append((i, score, y_pred, pp))
				all_hist.append({"round": len(all_hist)+1, "value": score})
			except Exception:
				all_hist.append({"round": len(all_hist)+1, "value": float('nan')})
		if not results:
			break
		# Selección sucesiva
		results.sort(key=lambda t: t[1], reverse=bool(maximize))
		keep = max(1, int(math.ceil(len(results) / int(factor))))
		cands = [ results[j][3] for j in range(keep) ]
		epochs = int(min(int(max_epochs), epochs * int(factor)))
	# última evaluación a máxima época
	best_params = cands[0] if cands else {}
	if best_params:
		best_params.update({"epochs": int(max_epochs), "batch_size": batch_size, "patience": patience})
		try:
			y_pred, _ = train_predict_rnn(best_params, X_tr_seq, y_tr, X_te_seq, y_te, use_val_for_es=True)
			best_metrics = compute_metrics(y_te, y_pred)
			return {"engine": "Halving (custom)", "best_params": best_params, "y_pred": y_pred, "metrics": best_metrics, "history": pd.DataFrame(all_hist)}
		except Exception:
			pass
	return {"engine": "Halving (custom)", "best_params": best_params, "y_pred": np.zeros_like(y_te), "metrics": {}, "history": pd.DataFrame(all_hist)}


def run_rnn_optuna(X_tr_seq: np.ndarray, y_tr: np.ndarray, X_te_seq: np.ndarray, y_te: np.ndarray, metric_key: str, seed: int, ranges: _Dict[str, Any], trials: int, epochs: int, batch_size: int, patience: int) -> _Dict[str, Any]:
	if not HAS_OPTUNA_RNN:
		raise RuntimeError("Optuna no disponible.")
	skey, maximize, metric_fn = metric_and_direction(metric_key)
	def objective(trial: "optuna.trial.Trial") -> float:
		try:
			_rnn_log(f"[Optuna] trial {trial.number+1}")
		except Exception:
			pass
		params = {
			"cell_type": trial.suggest_categorical("cell_type", [ct for ct, on in [("LSTM", ranges.get("use_LSTM", True)), ("GRU", ranges.get("use_GRU", True)), ("SimpleRNN", ranges.get("use_SimpleRNN", False))] if on] or ["LSTM"]),
			"num_layers": trial.suggest_int("num_layers", int(ranges["layers_min"]), int(ranges["layers_max"])) ,
			"units": trial.suggest_int("units", int(ranges["units_min"]), int(ranges["units_max"])) ,
			"dropout": trial.suggest_float("dropout", float(ranges["dropout_min"]), float(ranges["dropout_max"])) ,
			"recurrent_dropout": trial.suggest_float("recurrent_dropout", float(ranges["rec_dropout_min"]), float(ranges["rec_dropout_max"])) ,
			"bidirectional": trial.suggest_categorical("bidirectional", [True, False]) if bool(ranges.get("allow_bidirectional", True)) else False ,
			"dense_units": trial.suggest_categorical("dense_units", [0, 32, 64, 128, 256]) ,
			"activation": trial.suggest_categorical("activation", ["tanh", "relu"]) ,
			"lr": trial.suggest_float("lr", float(ranges["lr_min"]), float(ranges["lr_max"]), log=True) ,
			"optimizer": trial.suggest_categorical("optimizer", ["adam", "rmsprop"]) ,
			"epochs": int(epochs), "batch_size": int(batch_size), "patience": int(patience)
		}
		try:
			y_pred, _ = train_predict_rnn(params, X_tr_seq, y_tr, X_te_seq, y_te, use_val_for_es=True)
			score = float(metric_fn(y_te, y_pred))
			return score if maximize else score
		except Exception:
			return -1e9 if maximize else 1e9
	study = optuna.create_study(direction="maximize" if maximize else "minimize")
	study.optimize(objective, n_trials=int(trials), show_progress_bar=False)
	best = study.best_trial.params.copy()
	best.update({"epochs": int(epochs), "batch_size": int(batch_size), "patience": int(patience)})
	y_pred, _ = train_predict_rnn(best, X_tr_seq, y_tr, X_te_seq, y_te, use_val_for_es=True)
	metrics = compute_metrics(y_te, y_pred)
	hdf = pd.DataFrame({"number": [t.number for t in study.trials], "value": [t.value for t in study.trials]})
	return {"engine": "Optuna", "best_params": best, "y_pred": y_pred, "metrics": metrics, "history": hdf}


def run_rnn_hyperopt(X_tr_seq: np.ndarray, y_tr: np.ndarray, X_te_seq: np.ndarray, y_te: np.ndarray, metric_key: str, seed: int, ranges: _Dict[str, Any], max_evals: int, epochs: int, batch_size: int, patience: int) -> _Dict[str, Any]:
	if not HAS_HYPEROPT_RNN:
		raise RuntimeError("Hyperopt no disponible.")
	skey, maximize, metric_fn = metric_and_direction(metric_key)
	space = {
		"cell_type": _hp_rnn.choice("cell_type", [ct for ct, on in [("LSTM", ranges.get("use_LSTM", True)), ("GRU", ranges.get("use_GRU", True)), ("SimpleRNN", ranges.get("use_SimpleRNN", False))] if on] or ["LSTM"]),
		"num_layers": _hp_rnn.quniform("num_layers", int(ranges["layers_min"]), int(ranges["layers_max"]), 1),
		"units": _hp_rnn.quniform("units", int(ranges["units_min"]), int(ranges["units_max"]), 1),
		"dropout": _hp_rnn.uniform("dropout", float(ranges["dropout_min"]), float(ranges["dropout_max"])) ,
		"recurrent_dropout": _hp_rnn.uniform("recurrent_dropout", float(ranges["rec_dropout_min"]), float(ranges["rec_dropout_max"])) ,
		"bidirectional": _hp_rnn.choice("bidirectional", [True, False]) if bool(ranges.get("allow_bidirectional", True)) else False ,
		"dense_units": _hp_rnn.choice("dense_units", [0, 32, 64, 128, 256]) ,
		"activation": _hp_rnn.choice("activation", ["tanh", "relu"]) ,
		"lr": _hp_rnn.loguniform("lr", np.log(float(ranges["lr_min"])), np.log(float(ranges["lr_max"]))),
		"optimizer": _hp_rnn.choice("optimizer", ["adam", "rmsprop"]) ,
	}
	trials = _Trials_rnn()
	def _obj(hp):
		try:
			idx = len(trials.trials) + 1
			_rnn_log(f"[Hyperopt] trial {idx}")
		except Exception:
			pass
		params = {
			"cell_type": hp["cell_type"],
			"num_layers": int(round(hp["num_layers"])),
			"units": int(round(hp["units"])),
			"dropout": float(hp["dropout"]),
			"recurrent_dropout": float(hp["recurrent_dropout"]),
			"bidirectional": bool(hp["bidirectional"]) if isinstance(hp.get("bidirectional"), (bool, np.bool_)) else bool(hp.get("bidirectional", False)),
			"dense_units": int(hp["dense_units"]),
			"activation": str(hp["activation"]),
			"lr": float(hp["lr"]),
			"optimizer": str(hp["optimizer"]),
			"epochs": int(epochs), "batch_size": int(batch_size), "patience": int(patience)
		}
		try:
			y_pred, _ = train_predict_rnn(params, X_tr_seq, y_tr, X_te_seq, y_te, use_val_for_es=True)
			r2 = float(metric_fn(y_te, y_pred)) if metric_key == 'R2' else None
			if metric_key == 'R2':
				loss = -r2
			elif metric_key == 'RMSE':
				from sklearn.metrics import mean_squared_error as _mse
				loss = float(math.sqrt(_mse(y_te, y_pred)))
			elif metric_key == 'MAE':
				from sklearn.metrics import mean_absolute_error as _mae
				loss = float(_mae(y_te, y_pred))
			else:
				from sklearn.metrics import mean_squared_error as _mse
				loss = float(_mse(y_te, y_pred))
			record = {"loss": loss, "status": _STATUS_OK_rnn}
			return record
		except Exception:
			return {"loss": 1e9, "status": _STATUS_OK_rnn}
	best = _fmin_rnn(fn=_obj, space=space, algo=_tpe_rnn.suggest, max_evals=int(max_evals), trials=trials, rstate=np.random.default_rng(int(seed)))
	best_params = {
		"cell_type": [ct for ct, on in [("LSTM", ranges.get("use_LSTM", True)), ("GRU", ranges.get("use_GRU", True)), ("SimpleRNN", ranges.get("use_SimpleRNN", False))] if on or ct=="LSTM"][int(best.get("cell_type", 0))] if isinstance(best.get("cell_type"), (int, np.integer)) else best.get("cell_type", "LSTM"),
		"num_layers": int(round(best.get("num_layers", 1))),
		"units": int(round(best.get("units", 64))),
		"dropout": float(best.get("dropout", 0.0)),
		"recurrent_dropout": float(best.get("recurrent_dropout", 0.0)),
		"bidirectional": bool(best.get("bidirectional", False)) if isinstance(best.get("bidirectional"), (bool, np.bool_)) else bool(int(best.get("bidirectional", 0))>0),
		"dense_units": int(best.get("dense_units", 0)),
		"activation": str(best.get("activation", "tanh")),
		"lr": float(best.get("lr", 1e-3)),
		"optimizer": str(best.get("optimizer", "adam")),
		"epochs": int(epochs), "batch_size": int(batch_size), "patience": int(patience)
	}
	y_pred, _ = train_predict_rnn(best_params, X_tr_seq, y_tr, X_te_seq, y_te, use_val_for_es=True)
	metrics = compute_metrics(y_te, y_pred)
	# Historial
	try:
		vals = []
		for i, tr in enumerate(trials.trials):
			v = tr.get('result', {}).get('loss', np.nan)
			vals.append((i, (-v if metric_key=='R2' else v)))
		hdf = pd.DataFrame(vals, columns=["iter", "value"]) if vals else pd.DataFrame()
	except Exception:
		hdf = pd.DataFrame()
	return {"engine": "Hyperopt", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hdf}


def run_rnn_skopt(X_tr_seq: np.ndarray, y_tr: np.ndarray, X_te_seq: np.ndarray, y_te: np.ndarray, metric_key: str, seed: int, ranges: _Dict[str, Any], n_calls: int, epochs: int, batch_size: int, patience: int) -> _Dict[str, Any]:
	if not HAS_SKOPT_RNN:
		raise RuntimeError("scikit-optimize no disponible.")
	skey, maximize, metric_fn = metric_and_direction(metric_key)
	space = [
		_Categorical_rnn([ct for ct, on in [("LSTM", ranges.get("use_LSTM", True)), ("GRU", ranges.get("use_GRU", True)), ("SimpleRNN", ranges.get("use_SimpleRNN", False))] if on] or ["LSTM"], name="cell_type"),
		_Integer_rnn(int(ranges["layers_min"]), int(ranges["layers_max"]), name="num_layers"),
		_Integer_rnn(int(ranges["units_min"]), int(ranges["units_max"]), name="units"),
		_Real_rnn(float(ranges["dropout_min"]), float(ranges["dropout_max"]), name="dropout"),
		_Real_rnn(float(ranges["rec_dropout_min"]), float(ranges["rec_dropout_max"]), name="recurrent_dropout"),
		_Categorical_rnn([True, False], name="bidirectional") if bool(ranges.get("allow_bidirectional", True)) else _Categorical_rnn([False], name="bidirectional"),
		_Categorical_rnn([0, 32, 64, 128, 256], name="dense_units"),
		_Categorical_rnn(["tanh", "relu"], name="activation"),
		_Real_rnn(float(ranges["lr_min"]), float(ranges["lr_max"]), prior='log-uniform', name="lr"),
		_Categorical_rnn(["adam", "rmsprop"], name="optimizer"),
	]
	def _obj(x):
		keys = ["cell_type","num_layers","units","dropout","recurrent_dropout","bidirectional","dense_units","activation","lr","optimizer"]
		params = {k:v for k,v in zip(keys, x)}
		params.update({"epochs": int(epochs), "batch_size": int(batch_size), "patience": int(patience)})
		try:
			y_pred, _ = train_predict_rnn(params, X_tr_seq, y_tr, X_te_seq, y_te, use_val_for_es=True)
			score = float(metric_fn(y_te, y_pred))
			return -score if maximize else score
		except Exception:
			return 1e9
	res = _gp_minimize_rnn(_obj, space, n_calls=int(n_calls), random_state=int(seed), verbose=False)
	best_x = res.x; keys = ["cell_type","num_layers","units","dropout","recurrent_dropout","bidirectional","dense_units","activation","lr","optimizer"]
	best = {k:v for k,v in zip(keys, best_x)}
	best.update({"epochs": int(epochs), "batch_size": int(batch_size), "patience": int(patience)})
	y_pred, _ = train_predict_rnn(best, X_tr_seq, y_tr, X_te_seq, y_te, use_val_for_es=True)
	metrics = compute_metrics(y_te, y_pred)
	try:
		hdf = pd.DataFrame({"iter": np.arange(len(res.func_vals)), "value": ( -res.func_vals if maximize else res.func_vals )})
	except Exception:
		hdf = pd.DataFrame()
	return {"engine": "Bayes (skopt)", "best_params": best, "y_pred": y_pred, "metrics": metrics, "history": hdf}


def run_rnn_bayesopt(X_tr_seq: np.ndarray, y_tr: np.ndarray, X_te_seq: np.ndarray, y_te: np.ndarray, metric_key: str, seed: int, ranges: _Dict[str, Any], init_points: int, n_iter: int, epochs: int, batch_size: int, patience: int) -> _Dict[str, Any]:
	if not HAS_BAYESOPT_RNN:
		raise RuntimeError("bayes_opt no disponible.")
	skey, maximize, metric_fn = metric_and_direction(metric_key)
	def objective(units, lr, dropout, recurrent_dropout, num_layers, dense_units, bidirectional_idx, act_idx, opt_idx, cell_idx):
		cell_opts = [ct for ct, on in [("LSTM", ranges.get("use_LSTM", True)), ("GRU", ranges.get("use_GRU", True)), ("SimpleRNN", ranges.get("use_SimpleRNN", False))] if on] or ["LSTM"]
		activation_opts = ["tanh","relu"]; opt_opts=["adam","rmsprop"]; bi_opts=[False, True] if bool(ranges.get("allow_bidirectional", True)) else [False]
		params = {
			"cell_type": cell_opts[int(round(cell_idx)) % len(cell_opts)],
			"num_layers": int(round(num_layers)),
			"units": int(round(units)),
			"dropout": float(dropout),
			"recurrent_dropout": float(recurrent_dropout),
			"bidirectional": bi_opts[int(round(bidirectional_idx)) % len(bi_opts)],
			"dense_units": int(round(dense_units)),
			"activation": activation_opts[int(round(act_idx)) % len(activation_opts)],
			"lr": float(lr),
			"optimizer": opt_opts[int(round(opt_idx)) % len(opt_opts)],
			"epochs": int(epochs), "batch_size": int(batch_size), "patience": int(patience)
		}
		try:
			y_pred, _ = train_predict_rnn(params, X_tr_seq, y_tr, X_te_seq, y_te, use_val_for_es=True)
			score = float(metric_fn(y_te, y_pred))
			return score if maximize else -score  # bayes_opt maximiza
		except Exception:
			return -1e9 if maximize else 1e9
	pbounds = {
		"units": (float(ranges["units_min"]), float(ranges["units_max"])) ,
		"lr": (float(ranges["lr_min"]), float(ranges["lr_max"])) ,
		"dropout": (float(ranges["dropout_min"]), float(ranges["dropout_max"])) ,
		"recurrent_dropout": (float(ranges["rec_dropout_min"]), float(ranges["rec_dropout_max"])) ,
		"num_layers": (float(ranges["layers_min"]), float(ranges["layers_max"])) ,
		"dense_units": (0.0, 256.0) ,
		"bidirectional_idx": (0.0, 1.0) if bool(ranges.get("allow_bidirectional", True)) else (0.0, 0.0) ,
		"act_idx": (0.0, 1.0) ,
		"opt_idx": (0.0, 1.0) ,
		"cell_idx": (0.0, 2.0 if ranges.get("use_SimpleRNN", False) else 1.0) ,
	}
	opt = _BO_rnn(f=objective, pbounds=pbounds, random_state=int(seed), verbose=0)
	opt.maximize(init_points=int(init_points), n_iter=int(n_iter))
	best = opt.max.get("params", {})
	# Reconstruir parámetros discretos
	best_params = {
		"cell_type": [ct for ct, on in [("LSTM", ranges.get("use_LSTM", True)), ("GRU", ranges.get("use_GRU", True)), ("SimpleRNN", ranges.get("use_SimpleRNN", False))] if on] or ["LSTM"][int(round(best.get("cell_idx", 0.0))) % (3 if ranges.get("use_SimpleRNN", False) else 2)],
		"num_layers": int(round(best.get("num_layers", 1))),
		"units": int(round(best.get("units", 64))),
		"dropout": float(best.get("dropout", 0.0)),
		"recurrent_dropout": float(best.get("recurrent_dropout", 0.0)),
		"bidirectional": (int(round(best.get("bidirectional_idx", 0.0))) == 1) if bool(ranges.get("allow_bidirectional", True)) else False,
		"dense_units": int(round(best.get("dense_units", 0.0))),
		"activation": ["tanh","relu"][int(round(best.get("act_idx",0.0)))%2],
		"lr": float(best.get("lr", 1e-3)),
		"optimizer": ["adam","rmsprop"][int(round(best.get("opt_idx",0.0)))%2],
		"epochs": int(epochs), "batch_size": int(batch_size), "patience": int(patience)
	}
	y_pred, _ = train_predict_rnn(best_params, X_tr_seq, y_tr, X_te_seq, y_te, use_val_for_es=True)
	metrics = compute_metrics(y_te, y_pred)
	try:
		hdf = pd.DataFrame({"iter": np.arange(len(getattr(getattr(opt, 'space', None), 'target', []))), "value": list(getattr(getattr(opt, 'space', None), 'target', []))})
	except Exception:
		hdf = pd.DataFrame()
	return {"engine": "BayesianOptimization (bayes_opt)", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hdf}



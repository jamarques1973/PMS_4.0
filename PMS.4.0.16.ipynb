# Construcción dinámica de pestañas (incluye xIA NN si está disponible)
import ipywidgets as widgets
children = []
titles = []

def add_if_exists(name: str, title: str):
	obj = globals().get(name)
	if obj is not None:
		children.append(obj)
		titles.append(title)

add_if_exists('paste_form', 'Copiar/Pegar')
add_if_exists('excel_form', 'Excel')
add_if_exists('seg_form', 'Segmentación')
add_if_exists('selection_form', 'Selección')
add_if_exists('nn_form', 'NN (HPO)')
add_if_exists('rnn_form', 'RNN (HPO)')
add_if_exists('xnn_tab', 'xIA NN')
add_if_exists('svr_form', 'SVR (HPO)')
add_if_exists('xai_form', 'xIA SVR')
add_if_exists('rf_form', 'Random Forest RF (HPO)')
add_if_exists('xrf_tab', 'xIA Random Forest')
add_if_exists('xgb_form', 'XGBoost (HPO)')
add_if_exists('xgbx_tab', 'xIA XGBoost')

if not children:
	# UI mínima si nada está construido aún
	tabs = widgets.Tab(children=[widgets.VBox([widgets.HTML(value='<i>UI no inicializada</i>')])])
	tabs.set_title(0, 'UI')
else:
	tabs = widgets.Tab(children=children)
	# Establecer títulos completos y envolverlos en saltos de línea suaves
	for i, t in enumerate(titles):
		try:
			# Insertar saltos zero-width para permitir quebrar palabras largas
			t_wrapped = t.replace(' ', '\n') if len(t) > 14 else t
			tabs.set_title(i, t_wrapped)
		except Exception:
			pass

widgets.VBox([header, tabs, footer])
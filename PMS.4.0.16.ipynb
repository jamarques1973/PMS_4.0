	_HAS_PYALE = False

# Utilidades de tiempo y auditoría

def _xnn_now_iso():
	import datetime as _dt
	return _dt.datetime.utcnow().isoformat() + 'Z'

def _xnn_log(msg: str):
	try:
		if 'xnn_log_out' in globals() and isinstance(xnn_log_out, _widgets.Output):
			with xnn_log_out:
				print(msg)
	except Exception:
		pass

def _xnn_append_audit(record: dict):
	try:
		if 'app' not in globals():
			from types import SimpleNamespace
			globals()['app'] = SimpleNamespace()
		if not hasattr(app, 'xai_audit') or app.xai_audit is None:
			app.xai_audit = []
		app.xai_audit.append(record)
	except Exception:
		pass

# Recuperar mejor NN y datos

def get_best_nn_and_data():
	if 'app' not in globals() or not hasattr(app, 'nn_optim_results') or not app.nn_optim_results:
		raise RuntimeError("Ejecute primero NN (HPO) para obtener el mejor modelo.")
	res = app.nn_optim_results
	y_col = res.get('y_column') or getattr(app, 'y_column_for_sort', None)
	seg_name = res.get('segment')
	if y_col is None or not getattr(app, 'segments', []):
		raise RuntimeError("Faltan Y o segmentos. Revise NN (HPO).")
	seg = next((s for s in app.segments if s.get('name') == seg_name), app.segments[0])
	use_sel = globals().get('use_selected_chk').value if globals().get('use_selected_chk') is not None else True
	scale_x = globals().get('scale_x_chk').value if globals().get('scale_x_chk') is not None else True
	scale_y = globals().get('scale_y_chk').value if globals().get('scale_y_chk') is not None else False
	X_tr, y_tr, X_te, y_te, cols, _, _ = prepare_train_test(app.X, app.Y[y_col], seg, use_sel, scale_x, scale_y)
	from sklearn.neural_network import MLPRegressor as _MLPRegressor
	params = {k: v for k, v in (res.get('best_params', {}) or {}).items() if k not in ("random_state",)}
	seed = int(res.get('seed', 42))
	model = _MLPRegressor(**{**params, "random_state": seed})
	model.fit(X_tr, y_tr)
	return model, X_tr, y_tr, X_te, y_te, cols

# Cálculos xAI

def _compute_permutation_importance(model, X_te, y_te, cols, repeats: int = 10):
	r = _permutation_importance(model, X_te, y_te, n_repeats=int(max(1, repeats)), random_state=42, scoring='r2')
	return _pd.Series(r.importances_mean, index=list(cols)).sort_values(ascending=False)

def _compute_shap_kernel(model, X_tr, X_te, cols, bg_size: int, top_k: int):
	if not _HAS_SHAP:
		raise RuntimeError("SHAP no disponible (instale 'shap').")
	bg = X_tr[:int(max(20, bg_size))]
	expl = _shap.KernelExplainer(model.predict, bg)
	n_bees = int(min(max(20, 2 * len(cols)), X_te.shape[0]))
	sample_idx = _np.linspace(0, X_te.shape[0] - 1, num=n_bees, dtype=int)
	vals = expl.shap_values(X_te[sample_idx], nsamples=int(2 * X_tr.shape[1] + 2048))
	vals = _np.array(vals)
	return vals, sample_idx

def _compute_lime_local(model, X_tr, X_te, cols, idx: int, top_k: int):
	if not _HAS_LIME:
		raise RuntimeError("LIME no disponible (instale 'lime').")
	exp = _LimeTabularExplainer(X_tr, feature_names=list(cols), class_names=None, discretize_continuous=True, mode='regression')
	expln = exp.explain_instance(X_te[idx], model.predict, num_features=int(top_k))
	df_weights = _pd.DataFrame(expln.as_list(), columns=['feature', 'weight']).sort_values('weight', ascending=False)
	return df_weights.head(int(top_k))

def _compute_pdp_ice(model, X_te, cols, feat, grid_resolution: int, show_ice: bool):
	fig, ax = _plt.subplots(figsize=(4.8, 3.2))
	try:
		kind = 'both' if show_ice else 'average'
		_PDPDisplay.from_estimator(model, X_te, features=[feat], feature_names=list(cols), ax=ax, grid_resolution=int(max(10, grid_resolution)), kind=kind)
	except Exception:
		_PDPDisplay.from_estimator(model, X_te, features=[feat], feature_names=list(cols), ax=ax, grid_resolution=int(max(10, grid_resolution)))
	_plt.suptitle(f'PDP/ICE: {feat}')
	_plt.tight_layout()
	return fig

def _compute_ale(model, X_te, cols, feat):
	try:
		from PyALE import ALE as _ALE
		_USE_ALE_CLASS = True
	except Exception:
		try:
			from PyALE import ale as _ale_fn
			_USE_ALE_CLASS = False
		except Exception:
			raise RuntimeError("PyALE no disponible (instale 'PyALE').")
	if _USE_ALE_CLASS:
		ale = _ALE(X=_pd.DataFrame(X_te, columns=list(cols)), model=model.predict, feature=[str(feat)])
		fig = ale.plot(); _plt.title(f"ALE 1D: {feat}")
		return fig
	else:
		_ale_fn(X=_pd.DataFrame(X_te, columns=list(cols)), model=model, feature=[str(feat)])
		_plt.title(f"ALE 1D: {feat}")
		return _plt.gcf()

def _train_surrogate_tree(model, X_te, cols, max_depth: int):
	y_hat = model.predict(X_te)
	tree = _DecisionTreeRegressor(max_depth=int(max(2, max_depth)), random_state=42)
	tree.fit(X_te, y_hat)
	y_tree = tree.predict(X_te)
	r2 = float(_r2_score(y_hat, y_tree))
	imp = _pd.Series(tree.feature_importances_, index=list(cols)).sort_values(ascending=False)
	rules = _export_tree_text(tree, feature_names=list(cols))
	return tree, r2, imp, rules

# Parámetros de usuario
xai_idx = _widgets.BoundedIntText(value=0, min=0, max=10**9, step=1, description="idx local")
xai_bg = _widgets.BoundedIntText(value=100, min=20, max=5000, step=10, description="bg size")
xai_topk = _widgets.BoundedIntText(value=10, min=1, max=100, step=1, description="top k")
xai_pi_repeats = _widgets.BoundedIntText(value=10, min=1, max=200, step=1, description="PI reps")
xai_grid = _widgets.BoundedIntText(value=50, min=10, max=200, step=5, description="PDP grid")
xai_tree_depth = _widgets.BoundedIntText(value=3, min=2, max=8, step=1, description="Tree depth")
xai_feat = _widgets.Dropdown(options=[], description="feature")
btn_prefill_features = _widgets.Button(description="Poblar Feature", icon="list")

def _on_prefill_features(_):
	try:
		_maybe_prefill_xai_features()
	except Exception:
		pass
btn_prefill_features.on_click(_on_prefill_features)

# Prefill features before running xIA if data is available
try:
	_maybe_prefill_xai_features()
except Exception:
	pass

xai_do_shap = _widgets.Checkbox(value=_HAS_SHAP, description="SHAP")
xai_do_lime = _widgets.Checkbox(value=_HAS_LIME and not _HAS_SHAP, description="LIME")
xai_do_pdp = _widgets.Checkbox(value=True, description="PDP/ICE")
xai_show_ice = _widgets.Checkbox(value=True, description="ICE")
xai_do_ale = _widgets.Checkbox(value=_HAS_PYALE, description="ALE")
xai_do_tree = _widgets.Checkbox(value=True, description="Surrogate tree")

# Salidas y logs
xnn_alert = _widgets.Output()
xnn_log_out = _widgets.Output()
xnn_out_local = _widgets.Output()
xnn_out_global = _widgets.Output()
xnn_out_pdp = _widgets.Output()
xnn_out_ale = _widgets.Output()
xnn_out_tree = _widgets.Output()

# Auxiliar de features

def _prefill_xai_features(cols):
	try:
		opts = ["All"] + list(cols)
		xai_feat.options = opts
		if not xai_feat.value:
			xai_feat.value = opts[0]
	except Exception:
		pass

def _maybe_prefill_xai_features():
	try:
		cols = []
		use_sel = globals().get('use_selected_chk').value if globals().get('use_selected_chk') is not None else True
		if 'app' in globals():
			if use_sel and hasattr(app, 'selected_X_columns') and app.selected_X_columns:
				cols = list(app.selected_X_columns)
			elif getattr(app, 'X', None) is not None:
				cols = list(getattr(app.X, 'columns', []))
		if cols:
			_prefill_xai_features(cols)
	except Exception:
		pass

# Run principal

def _run_xai_nn(_):
	for area in (xnn_alert, xnn_log_out, xnn_out_local, xnn_out_global, xnn_out_pdp, xnn_out_ale, xnn_out_tree):
		area.clear_output()
	prog = _widgets.IntProgress(value=0, min=0, max=5, description='xIA', bar_style='info')
	lbl = _widgets.HTML(value='Preparando...')
	with xnn_alert:
		_display(_widgets.VBox([lbl, prog]))
	try:
		model, X_tr, y_tr, X_te, y_te, cols = get_best_nn_and_data()
		_prefill_xai_features(cols)
		lbl.value = 'Locales...'; prog.value = 1
		with xnn_out_local:
			try:
				if xai_do_shap.value:
					vals, sample_idx = _compute_shap_kernel(model, X_tr, X_te, cols, xai_bg.value, xai_topk.value)
					_shap.summary_plot(vals, _pd.DataFrame(X_te[sample_idx], columns=list(cols)), feature_names=list(cols), plot_type='dot', max_display=int(xai_topk.value), show=True)
					_xnn_log("SHAP completado.")
				elif xai_do_lime.value:
					idx = int(_np.clip(xai_idx.value, 0, X_te.shape[0]-1))
					df_l = _compute_lime_local(model, X_tr, X_te, cols, idx, xai_topk.value)
					colors = _display(df_l);
					colors = df_l['weight'].apply(lambda w: '#1f77b4' if w >= 0 else '#d62728').tolist()
					fig, ax = _plt.subplots(figsize=(5.8, 3.4))
					ax.barh(df_l['feature'][::-1], df_l['weight'][::-1], color=list(reversed(colors)))
					ax.set_title('LIME (local)'); ax.set_xlabel('peso'); ax.set_ylabel('feature')
					for y, v in enumerate(df_l['weight'][::-1]):
						ax.text(v + (0.01 if v >= 0 else -0.01), y, f"{v:.3f}", va='center', ha='left' if v >= 0 else 'right')
					_plt.tight_layout(); _plt.show()
					_xnn_log("LIME completado.")
				else:
					print("SHAP/LIME desactivados o no disponibles.")
			except Exception as e:
				print("Local error:", e)
		lbl.value = 'Permutation Importance...'; prog.value = 2
		with xnn_out_global:
			try:
				imp = _compute_permutation_importance(model, X_te, y_te, cols, repeats=int(xai_pi_repeats.value))
				_display(imp.head(int(xai_topk.value)).to_frame('importance'))
				fig, ax = _plt.subplots(1, 1, figsize=(6, 4))
				imp.head(int(xai_topk.value)).iloc[::-1].plot.barh(ax=ax)
				ax.set_title("Permutation Importance (Test)")
				_plt.tight_layout(); _plt.show()
				_xnn_log("Permutation importance completado.")
			except Exception as e:
				print("PI error:", e)
		lbl.value = 'Curvas...'; prog.value = 3
		with xnn_out_pdp:
			try:
				if xai_feat.value and xai_feat.value != 'All':
					fig = _compute_pdp_ice(model, X_te, cols, xai_feat.value, xai_grid.value, xai_show_ice.value)
					_plt.show(); _xnn_log("PDP/ICE completado.")
				else:
					outs = []
					for f in list(cols):
						o = _widgets.Output()
						with o:
							_ = _compute_pdp_ice(model, X_te, cols, f, xai_grid.value, xai_show_ice.value)
							_plt.tight_layout(); _plt.show()
						outs.append(o)
					grid = _widgets.GridBox(children=outs, layout=_widgets.Layout(grid_template_columns="1fr 1fr 1fr"))
					_display(grid); _xnn_log("PDP/ICE completado.")
			except Exception as e:
				print("PDP/ICE error:", e)
		with xnn_out_ale:
			try:
				if xai_do_ale.value:
					if xai_feat.value and xai_feat.value != 'All':
						_ = _compute_ale(model, X_te, cols, xai_feat.value)
						_plt.show(); _xnn_log("ALE completado.")
					else:
						outs = []
						for f in list(cols):
							o = _widgets.Output()
							with o:
								_ = _compute_ale(model, X_te, cols, f)
								_plt.tight_layout(); _plt.show()
							outs.append(o)
						grid = _widgets.GridBox(children=outs, layout=_widgets.Layout(grid_template_columns="1fr 1fr 1fr"))
						_display(grid); _xnn_log("ALE completado.")
				else:
					print("ALE desactivado o no disponible.")
			except Exception as e:
				print("ALE error:", e)
		lbl.value = 'Surrogate...'; prog.value = 4
		with xnn_out_tree:
			try:
				if xai_do_tree.value:
					tree, r2, imp, rules = _train_surrogate_tree(model, X_te, cols, xai_tree_depth.value)
					fig, ax = _plt.subplots(figsize=(6, 3.2))
					imp.head(int(xai_topk.value)).iloc[::-1].plot.barh(ax=ax)
					ax.set_title(f"Surrogate Tree (R²={r2:.3f})")
					_plt.tight_layout(); _plt.show()
					print("Reglas (árbol):")
					print(str(rules))
					_xnn_log("Surrogate tree completado.")
				else:
					print("Surrogate desactivado.")
			except Exception as e:
				print("Surrogate error:", e)
		prog.value = 5; prog.bar_style = 'success'; lbl.value = 'Completado'
		try:
			_xnn_append_audit({
				"run_id": _xnn_now_iso(),
				"top_k": int(xai_topk.value),
				"pi_repeats": int(xai_pi_repeats.value),
				"feat": str(xai_feat.value),
				"tree_depth": int(xai_tree_depth.value),
				"do": {
					"shap": bool(xai_do_shap.value), "lime": bool(xai_do_lime.value),
					"pdp": bool(xai_do_pdp.value), "ice": bool(xai_show_ice.value),
					"ale": bool(xai_do_ale.value), "surrogate": bool(xai_do_tree.value)
				}
			})
		except Exception:
			pass
		with xnn_alert:
			_display(_widgets.HTML(value="<div>xIA NN (refactorizada) completada.</div>"))
	except Exception as e:
		import traceback as _tb
		with xnn_alert:
			prog.bar_style = 'danger'; lbl.value = 'Error'
			_display(_widgets.HTML(value=f"<div style='color:#b00'>Error xIA NN: {e}</div>"))
			_display(_widgets.HTML(value="<pre style='white-space:pre-wrap'>" + _tb.format_exc() + "</pre>"))

# UI

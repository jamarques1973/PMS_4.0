# Utilidades comunes

def ensure_optional_packages(progress_output=None):
    global HAS_OPTUNA, HAS_HYPEROPT, HAS_SKOPT, HAS_HALVING
    install_list = []
    if not HAS_OPTUNA:
        install_list.append("optuna")
    if not HAS_HYPEROPT:

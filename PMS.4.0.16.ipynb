def _rf_build_from_params(params: dict, seed: int) -> _RF:
    params = dict(params or {})
    params.setdefault('n_estimators', 200)
    params.setdefault('n_jobs', -1)
    params.setdefault('random_state', seed)
    # Normalizar max_features
    mf = params.get('max_features', None)
    if isinstance(mf, _np.floating):
        params['max_features'] = float(mf)
    elif isinstance(mf, str):
        params['max_features'] = mf
    elif mf is None:
        params['max_features'] = None
    return _RF(**params)


def get_best_rf_and_data() -> tuple:
    if 'app' not in globals() or not hasattr(app, 'rf_optim_results') or not app.rf_optim_results:
        raise RuntimeError("Ejecute RF (HPO) primero.")
    res = app.rf_optim_results
    y_col = res.get('y_column') or getattr(app, 'y_column_for_sort', None)
    seg_name = res.get('segment_name') or res.get('segment')
    if y_col is None or not getattr(app, 'segments', []):
        raise RuntimeError("Faltan Y o segmentos. Revise RF (HPO).")
    seg = next((s for s in app.segments if s.get('name') == seg_name), app.segments[0])
    use_sel = globals().get('use_selected_chk').value if globals().get('use_selected_chk') is not None else True
    scale_x = globals().get('scale_x_chk').value if globals().get('scale_x_chk') is not None else True
    scale_y = globals().get('scale_y_chk').value if globals().get('scale_y_chk') is not None else False
    X_tr, y_tr, X_te, y_te, cols, _, _ = prepare_train_test(app.X, app.Y[y_col], seg, use_sel, scale_x, scale_y)
    # Elegir mejor engine y params
    engines = res.get('engines') or []
    metric_key = res.get('metric_selection') or 'R2'
    def metric_val(m):
        if metric_key == 'R2':
            return float(m.get('r2', float('nan')))
        if metric_key == 'RMSE':
            return -float(m.get('rmse', float('inf')))
        if metric_key == 'MAE':
            return -float(m.get('mae', float('inf')))
        return -float(m.get('mse', float('inf')))
    best = None; best_score = -1e300
    for r in engines:
        sc = metric_val(r.get('metrics', {}))
        if sc > best_score:
            best = r; best_score = sc
    best_params = (best or {}).get('best_params', {})
    seed = 42
    model = _rf_build_from_params(best_params, seed)
    model.fit(X_tr, y_tr)
    return model, X_tr, y_tr, X_te, y_te, cols, y_col



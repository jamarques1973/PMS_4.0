	import shap as _shap
	_HAS_SHAP = True
except Exception:
	_HAS_SHAP = False
try:
	from lime.lime_tabular import LimeTabularExplainer as _LimeTabularExplainer
	_HAS_LIME = True
except Exception:
	_HAS_LIME = False

        install_list.append("scikit-optimize")
    if install_list:
        import sys, subprocess
        # Barra de progreso
        prog = widgets.IntProgress(value=0, min=0, max=len(install_list), bar_style='info', description='HPO', orientation='horizontal')
        prog_label = widgets.HTML(value=f"Instalando dependencias HPO: {', '.join(install_list)}")

from scipy.stats import randint as sp_randint, uniform as sp_uniform

def run_nn_halving_random(X_tr, y_tr, X_te, y_te, scoring_key: str, min_resources: int = 20, factor: int = 3, rng_seed: int = 42):
    if not (HAS_TF and HAS_SCIKERAS and HAS_HALVING):
        raise RuntimeError("Requiere TensorFlow, scikeras y HalvingRandomSearchCV")
    sp = default_nn_space()
    param_distributions = {
        'model__n_layers': sp_randint(sp['n_layers'][0], sp['n_layers'][1] + 1),
        'model__units': sp_randint(sp['units'][0], sp['units'][1] + 1),
        'model__activation': sp['activation'],
        'model__dropout': sp_uniform(sp['dropout'][0], sp['dropout'][1] - sp['dropout'][0]),
        'model__batch_norm': sp['batch_norm'],
        'model__learning_rate': loguniform(sp['learning_rate'][0], sp['learning_rate'][1]),
        'model__optimizer': sp['optimizer'],
        'batch_size': sp_randint(sp['batch_size'][0], sp['batch_size'][1] + 1),
        'epochs': sp_randint(sp['epochs'][0], sp['epochs'][1] + 1),
        'patience': sp_randint(sp['patience'][0], sp['patience'][1] + 1),
    }
    base = KerasRegressor(model=build_dense_model, input_dim=X_tr.shape[1], verbose=0)
    X_all, y_all, cv = _build_cv_for_test(X_tr, y_tr, X_te, y_te)
    hrs = HalvingRandomSearchCV(estimator=base, param_distributions=param_distributions, factor=int(factor), min_resources=int(min_resources), scoring=scoring_key, cv=cv, random_state=rng_seed, refit=False, verbose=0, n_candidates="exhaust")
    hrs.fit(X_all, y_all)
    try:
        idx = int(hrs.best_index_)
        best_params = {k.replace('param_', '').replace('model__', ''): hrs.cv_results_[k][idx] for k in hrs.cv_results_ if k.startswith('param_')}
    except Exception:
        best_params = {}
    model, metrics, y_pred, _ = _fit_eval_nn(X_tr, y_tr, X_te, y_te, best_params, seed=rng_seed)
    hist_df = pd.DataFrame({'candidate': np.arange(len(hrs.cv_results_.get('mean_test_score', []))), 'mean_test_score': hrs.cv_results_.get('mean_test_score', [])})
    return {"engine": "HalvingRandomSearchCV", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hist_df}


def run_nn_hyperopt(X_tr, y_tr, X_te, y_te, metric_key: str, max_evals: int, rng_seed: int = 42):
    if not HAS_HYPEROPT:
        raise RuntimeError("Hyperopt no disponible")
    from hyperopt import hp, tpe, fmin, Trials, STATUS_OK, space_eval
    sp = default_nn_space()
    maximize = (metric_key == 'R2')
    space = {
        'n_layers': hp.quniform('n_layers', sp['n_layers'][0], sp['n_layers'][1], 1),
        'units': hp.qloguniform('units', np.log(sp['units'][0]), np.log(sp['units'][1]), 1),
        'activation': hp.choice('activation', sp['activation']),
        'dropout': hp.uniform('dropout', sp['dropout'][0], sp['dropout'][1]),
        'batch_norm': hp.choice('batch_norm', sp['batch_norm']),
        'learning_rate': hp.loguniform('learning_rate', np.log(sp['learning_rate'][0]), np.log(sp['learning_rate'][1])),
        'optimizer': hp.choice('optimizer', sp['optimizer']),
        'batch_size': hp.qloguniform('batch_size', np.log(sp['batch_size'][0]), np.log(sp['batch_size'][1]), 1),
        'epochs': hp.quniform('epochs', sp['epochs'][0], sp['epochs'][1], 1),
        'patience': hp.quniform('patience', sp['patience'][0], sp['patience'][1], 1),
    }
    trials = Trials()
    def objective(hp_params):
        params = {k: (int(v) if isinstance(v, float) and v.is_integer() else v) for k, v in hp_params.items()}
        _, metrics, _, _ = _fit_eval_nn(X_tr, y_tr, X_te, y_te, params, seed=rng_seed)
        score = metrics.get('r2') if maximize else metrics.get('rmse')
        loss = -score if maximize else score
        return {'loss': loss, 'status': STATUS_OK}
    best = fmin(fn=objective, space=space, algo=tpe.suggest, max_evals=int(max_evals), rstate=np.random.default_rng(rng_seed), trials=trials)
    best_params = space_eval(space, best)
    model, metrics, y_pred, _ = _fit_eval_nn(X_tr, y_tr, X_te, y_te, best_params, seed=rng_seed)
    hdf = pd.DataFrame([{'iter': i, 'value': (-t['result']['loss'] if maximize else t['result']['loss'])} for i, t in enumerate(trials.trials)])
    return {"engine": "Hyperopt", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hdf}


def run_nn_skopt(X_tr, y_tr, X_te, y_te, scoring_key: str, n_iter: int, rng_seed: int = 42):
    if not (HAS_SCIKERAS and HAS_SKOPT):
        raise RuntimeError("skopt no disponible o scikeras ausente")
    from skopt import BayesSearchCV
    from skopt.space import Real, Integer, Categorical
    sp = default_nn_space()
    base = KerasRegressor(model=build_dense_model, input_dim=X_tr.shape[1], verbose=0)
    search_spaces = {
        'model__n_layers': Integer(sp['n_layers'][0], sp['n_layers'][1]),
        'model__units': Integer(sp['units'][0], sp['units'][1]),
        'model__activation': Categorical(sp['activation']),
        'model__dropout': Real(sp['dropout'][0], sp['dropout'][1]),
        'model__batch_norm': Categorical(sp['batch_norm']),
        'model__learning_rate': Real(sp['learning_rate'][0], sp['learning_rate'][1], prior='log-uniform'),
        'model__optimizer': Categorical(sp['optimizer']),
        'batch_size': Integer(sp['batch_size'][0], sp['batch_size'][1]),
        'epochs': Integer(sp['epochs'][0], sp['epochs'][1]),
        'patience': Integer(sp['patience'][0], sp['patience'][1]),
    }
    X_all, y_all, cv = _build_cv_for_test(X_tr, y_tr, X_te, y_te)
    opt = BayesSearchCV(estimator=base, search_spaces=search_spaces, n_iter=int(n_iter), scoring=scoring_key, cv=cv, n_jobs=1, refit=False, random_state=rng_seed, verbose=0, return_train_score=False)
    opt.fit(X_all, y_all)
    try:
        idx = int(opt.best_index_)
        best_params = {k.replace('param_', '').replace('model__', ''): opt.cv_results_[k][idx] for k in opt.cv_results_ if k.startswith('param_')}
    except Exception:
        best_params = {}
    model, metrics, y_pred, _ = _fit_eval_nn(X_tr, y_tr, X_te, y_te, best_params, seed=rng_seed)
    hdf = pd.DataFrame(opt.cv_results_)
    return {"engine": "BayesSearchCV (skopt)", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hdf}


def run_nn_kerastuner(X_tr, y_tr, X_te, y_te, metric_key: str, max_trials: int, rng_seed: int = 42):
    if not HAS_KT:
        raise RuntimeError("KerasTuner no disponible")
    maximize = (metric_key == 'R2')
    def model_builder(hp):
        params = {
            'n_layers': hp.Int('n_layers', 1, 6),
            'units': hp.Int('units', 16, 512, step=16),
            'activation': hp.Choice('activation', ['relu','elu','tanh','selu']),
            'dropout': hp.Float('dropout', 0.0, 0.6, step=0.05),
            'batch_norm': hp.Choice('batch_norm', [True, False]),
            'learning_rate': hp.Float('learning_rate', 1e-5, 5e-2, sampling='log'),
            'optimizer': hp.Choice('optimizer', ['adam','rmsprop','sgd']),
        }
        return build_dense_model(X_tr.shape[1], params)
    tuner = kt.RandomSearch(model_builder, objective='val_loss', max_trials=int(max_trials), directory='/workspace/kt_nn', project_name='nn_hpo')
    stop = keras.callbacks.EarlyStopping(monitor='val_loss', patience=10, restore_best_weights=True)
    tuner.search(X_tr, y_tr, validation_data=(X_te, y_te), epochs=120, batch_size=64, callbacks=[stop], verbose=0)
    best_hp = tuner.get_best_hyperparameters(1)[0]
    best_params = {h.name: best_hp.get(h.name) for h in best_hp.space}
    model = tuner.hypermodel.build(best_hp)
    model.fit(X_tr, y_tr, validation_data=(X_te, y_te), epochs=120, batch_size=64, callbacks=[stop], verbose=0)
    y_pred = model.predict(X_te, verbose=0).ravel()
    try:
        metrics = compute_metrics(y_te, y_pred)  # type: ignore
    except Exception:
        mse = mean_squared_error(y_te, y_pred); rmse = float(math.sqrt(mse)); mae = float(mean_absolute_error(y_te, y_pred)); r2 = float(r2_score(y_te, y_pred))
        metrics = {"r2": r2, "rmse": rmse, "mse": float(mse), "mae": mae}
    return {"engine": "KerasTuner", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": pd.DataFrame()}
# NN: constructores y motores de HPO
from typing import Dict as _Dict, Any as _Any


def build_dense_model(input_dim: int, params: _Dict[str, _Any]):
    if not HAS_TF:
        raise RuntimeError("TensorFlow no disponible")
    n_layers = int(params.get('n_layers', 2))
    units = int(params.get('units', 64))
    activation = str(params.get('activation', 'relu'))
    dropout = float(params.get('dropout', 0.0))
    batch_norm = bool(params.get('batch_norm', False))
    learning_rate = float(params.get('learning_rate', 1e-3))
    optimizer_name = str(params.get('optimizer', 'adam'))

    model = keras.Sequential()
    model.add(keras.layers.Input(shape=(input_dim,)))
    for _ in range(n_layers):
        model.add(keras.layers.Dense(units, activation=None))
        if batch_norm:
            model.add(keras.layers.BatchNormalization())
        model.add(keras.layers.Activation(activation))
        if dropout > 0:
            model.add(keras.layers.Dropout(dropout))
    model.add(keras.layers.Dense(1, activation='linear'))

    if optimizer_name == 'adam':
        opt = keras.optimizers.Adam(learning_rate=learning_rate)
    elif optimizer_name == 'sgd':
        opt = keras.optimizers.SGD(learning_rate=learning_rate, momentum=float(params.get('momentum', 0.0)))
    elif optimizer_name == 'rmsprop':
        opt = keras.optimizers.RMSprop(learning_rate=learning_rate)
    else:
        opt = keras.optimizers.Adam(learning_rate=learning_rate)

    model.compile(optimizer=opt, loss='mse', metrics=['mse'])
    return model


def default_nn_space():
    # Solo hiperparámetros aceptados por el estimador scikeras (prefijo model__ para capa) y optimizador
    return {
        'n_layers': (1, 6),
        'units': (16, 512),
        'activation': ['relu','elu','tanh','selu'],
        'dropout': (0.0, 0.6),
        'batch_norm': [True, False],
        'learning_rate': (1e-5, 5e-2),
        'optimizer': ['adam','rmsprop','sgd'],
    }


def _build_cv_for_test(X_tr, y_tr, X_te, y_te):
    X_all = np.vstack([X_tr, X_te])
    y_all = np.concatenate([y_tr, y_te])
    test_fold = np.array([-1] * len(y_tr) + [0] * len(y_te))
    return X_all, y_all, PredefinedSplit(test_fold)


def _fit_eval_nn(X_tr, y_tr, X_te, y_te, params: _Dict[str, _Any], seed: int = 42):
    if not HAS_TF:
        raise RuntimeError("TensorFlow no disponible")
    tf.keras.utils.set_random_seed(seed)
    model = build_dense_model(X_tr.shape[1], params)
    batch_size = int(params.get('batch_size', 64))
    epochs = int(params.get('epochs', 120))
    patience = int(params.get('patience', 12))
    es = keras.callbacks.EarlyStopping(monitor='val_loss', patience=patience, restore_best_weights=True, verbose=0)
    hist = model.fit(X_tr, y_tr, validation_data=(X_te, y_te), batch_size=batch_size, epochs=epochs, verbose=0, callbacks=[es])
    y_pred = model.predict(X_te, verbose=0).ravel()
    # compute_metrics existe en PMS_4_0_9; si no, fallback mínimo
    try:
        metrics = compute_metrics(y_te, y_pred)  # type: ignore
    except Exception:
        mse = mean_squared_error(y_te, y_pred); rmse = float(math.sqrt(mse)); mae = float(mean_absolute_error(y_te, y_pred)); r2 = float(r2_score(y_te, y_pred))
        metrics = {"r2": r2, "rmse": rmse, "mse": float(mse), "mae": mae}
    return model, metrics, y_pred, hist


def run_nn_randomized_search(X_tr, y_tr, X_te, y_te, scoring_key: str, n_iter: int, rng_seed: int = 42):
    if not (HAS_TF and HAS_SCIKERAS):
        raise RuntimeError("Requiere TensorFlow y scikeras")
    sp = default_nn_space()
    from scipy.stats import randint as sp_randint, uniform as sp_uniform
    param_distributions = {
        'model__n_layers': sp_randint(sp['n_layers'][0], sp['n_layers'][1] + 1),
        'model__units': sp_randint(sp['units'][0], sp['units'][1] + 1),
        'model__activation': sp['activation'],
        'model__dropout': sp_uniform(sp['dropout'][0], sp['dropout'][1] - sp['dropout'][0]),
        'model__batch_norm': sp['batch_norm'],
        'model__learning_rate': loguniform(sp['learning_rate'][0], sp['learning_rate'][1]),
        'model__optimizer': sp['optimizer'],
        'batch_size': sp_randint(sp['batch_size'][0], sp['batch_size'][1] + 1),
        'epochs': sp_randint(sp['epochs'][0], sp['epochs'][1] + 1),
        'patience': sp_randint(sp['patience'][0], sp['patience'][1] + 1),
    }
    base = KerasRegressor(model=build_dense_model, input_dim=X_tr.shape[1], verbose=0)
    X_all, y_all, cv = _build_cv_for_test(X_tr, y_tr, X_te, y_te)
    rs = RandomizedSearchCV(estimator=base, param_distributions=param_distributions, n_iter=int(n_iter), scoring=scoring_key, n_jobs=1, cv=cv, refit=False, random_state=rng_seed, verbose=0, return_train_score=False)
    rs.fit(X_all, y_all)
    try:
        idx = int(rs.best_index_)
        best_params = {k.replace('param_', '').replace('model__', ''): rs.cv_results_[k][idx] for k in rs.cv_results_ if k.startswith('param_')}
    except Exception:
        best_params = {}
    # coerce
    bp = {}
    for k, v in best_params.items():
        try:
            bp[k] = int(v) if isinstance(v, (np.integer,)) else (float(v) if isinstance(v, (np.floating,)) else v)
        except Exception:
            bp[k] = v
    model, metrics, y_pred, hist = _fit_eval_nn(X_tr, y_tr, X_te, y_te, bp, seed=rng_seed)
    hist_df = pd.DataFrame({'epoch': np.arange(len(hist.history.get('loss', []))), 'loss': hist.history.get('loss', []), 'val_loss': hist.history.get('val_loss', [])})
    return {"engine": "RandomizedSearchCV", "best_params": bp, "y_pred": y_pred, "metrics": metrics, "history": hist_df}


def run_nn_optuna(X_tr, y_tr, X_te, y_te, metric_key: str, trials: int, rng_seed: int = 42):
    if not HAS_OPTUNA:
        raise RuntimeError("Optuna no disponible")
    maximize = (metric_key == 'R2')
    sp = default_nn_space()
    def objective(trial):
        params = {
            'n_layers': trial.suggest_int('n_layers', sp['n_layers'][0], sp['n_layers'][1]),
            'units': trial.suggest_int('units', sp['units'][0], sp['units'][1]),
            'activation': trial.suggest_categorical('activation', sp['activation']),
            'dropout': trial.suggest_float('dropout', sp['dropout'][0], sp['dropout'][1]),
            'batch_norm': trial.suggest_categorical('batch_norm', sp['batch_norm']),
            'learning_rate': trial.suggest_float('learning_rate', sp['learning_rate'][0], sp['learning_rate'][1], log=True),
            'optimizer': trial.suggest_categorical('optimizer', sp['optimizer']),
            'batch_size': trial.suggest_int('batch_size', sp['batch_size'][0], sp['batch_size'][1]),
            'epochs': trial.suggest_int('epochs', sp['epochs'][0], sp['epochs'][1]),
            'patience': trial.suggest_int('patience', sp['patience'][0], sp['patience'][1]),
        }
        _, metrics, _, _ = _fit_eval_nn(X_tr, y_tr, X_te, y_te, params, seed=rng_seed)
        return metrics.get('r2') if maximize else metrics.get('rmse')
    study = optuna.create_study(direction='maximize' if maximize else 'minimize')
    study.optimize(objective, n_trials=int(trials), show_progress_bar=False)
    best_params = study.best_trial.params.copy()
    model, metrics, y_pred, hist = _fit_eval_nn(X_tr, y_tr, X_te, y_te, best_params, seed=rng_seed)
    hdf = pd.DataFrame([{'number': t.number, 'value': t.value} for t in study.trials])
    return {"engine": "Optuna", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hdf}

def get_best_xgb_and_data() -> tuple:
	"""Recupera el mejor modelo XGB tras HPO y prepara los datos Train/Test y columnas."""
	if 'app' not in globals() or not hasattr(app, 'xgb_optim_results') or not app.xgb_optim_results:
		raise RuntimeError("Ejecute XGBoost (HPO) primero.")
	res = app.xgb_optim_results
	y_col = res.get('y_column') or getattr(app, 'y_column_for_sort', None)
	seg_name = res.get('segment_name') or res.get('segment')
	if y_col is None or not getattr(app, 'segments', []):
		raise RuntimeError("Faltan Y o segmentos. Revise XGB (HPO).")
	seg = next((s for s in app.segments if s.get('name') == seg_name), app.segments[0])
	use_sel = globals().get('use_selected_chk').value if globals().get('use_selected_chk') is not None else True
	scale_x = globals().get('scale_x_chk').value if globals().get('scale_x_chk') is not None else True
	scale_y = globals().get('scale_y_chk').value if globals().get('scale_y_chk') is not None else False
	X_tr, y_tr, X_te, y_te, cols, _, _ = prepare_train_test(app.X, app.Y[y_col], seg, use_sel, scale_x, scale_y)
	# Elegir mejor engine y params
	engines = res.get('engines') or []
	metric_key = res.get('metric_selection') or 'R2'
	def metric_val(m: dict) -> float:
		if metric_key == 'R2':
			return float(m.get('r2', float('-inf')))
		if metric_key == 'RMSE':
			return -float(m.get('rmse', float('inf')))
		if metric_key == 'MAE':
			return -float(m.get('mae', float('inf')))
		return -float(m.get('mse', float('inf')))
	best = None; best_score = -1e300
	for r in engines:
		m = r.get('metrics', {})
		sc = metric_val(m)
		if sc > best_score:
			best = r; best_score = sc
	best_params = (best or {}).get('best_params', {})
	seed = 42
	# Construcción del modelo
	try:
		model = _build_xgb_from_params(best_params, seed)  # definido en sección XGB (HPO)
	except Exception:
		try:
			from xgboost import XGBRegressor as _XGBR
			base = dict(best_params or {})
			base.setdefault('random_state', seed)
			base.setdefault('n_estimators', 400)
			base.setdefault('tree_method', 'hist')
			base.setdefault('n_jobs', -1)
			model = _XGBR(**base)
		except Exception as e:
			raise RuntimeError(f"No se pudo construir el modelo XGB: {e}")
	model.fit(X_tr, y_tr)
	return model, X_tr, y_tr, X_te, y_te, cols, y_col



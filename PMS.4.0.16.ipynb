# NN (HPO) - utilidades específicas y ejecución de motores
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from scipy import stats

from sklearn.neural_network import MLPRegressor
from sklearn.model_selection import RandomizedSearchCV
from sklearn.model_selection import PredefinedSplit
from sklearn.metrics import r2_score, mean_absolute_error, mean_squared_error

# Utilidades reutilizadas del cuaderno (si faltan, definimos mínimos)
if 'metric_and_direction' not in globals():
    def metric_and_direction(metric_key: str):
        import math
        from sklearn.metrics import r2_score, mean_squared_error, mean_absolute_error
        if metric_key == "R2":
            return ("r2", True, r2_score)
        if metric_key == "RMSE":
            return ("neg_root_mean_squared_error", False, lambda yt, yp: math.sqrt(mean_squared_error(yt, yp)))
        if metric_key == "MSE":
            return ("neg_mean_squared_error", False, mean_squared_error)
        if metric_key == "MAE":
            return ("neg_mean_absolute_error", False, mean_absolute_error)
        return ("r2", True, r2_score)

if 'prepare_train_test' not in globals():
    from sklearn.preprocessing import StandardScaler
    def prepare_train_test(X, y, segment, use_selected=True, scale_x=True, scale_y=False):
        cols = list(X.columns)
        X_use = X[cols].copy()
        X_num = X_use.apply(pd.to_numeric, errors="coerce")
        y_num = pd.to_numeric(y, errors="coerce")
        tr_idx = np.array(segment["train_index"], dtype=int)
        te_idx = np.array(segment["test_index"], dtype=int)
        X_tr = X_num.iloc[tr_idx].copy(); X_te = X_num.iloc[te_idx].copy()
        y_tr = y_num.iloc[tr_idx].copy(); y_te = y_num.iloc[te_idx].copy()
        x_scaler = StandardScaler(with_mean=True, with_std=True) if scale_x else None
        y_scaler = StandardScaler(with_mean=True, with_std=True) if scale_y else None
        if x_scaler is not None:
            X_tr.loc[:, :] = x_scaler.fit_transform(X_tr.values)
            X_te.loc[:, :] = x_scaler.transform(X_te.values)
        if y_scaler is not None:
            y_tr_vals = y_scaler.fit_transform(y_tr.values.reshape(-1, 1)).ravel()
            y_te_vals = y_scaler.transform(y_te.values.reshape(-1, 1)).ravel()
        else:
            y_tr_vals = y_tr.values; y_te_vals = y_te.values
        return X_tr.values, y_tr_vals, X_te.values, y_te_vals, cols, x_scaler, y_scaler

if 'build_predefined_cv' not in globals():
    def build_predefined_cv(X_tr, y_tr, X_te, y_te):
        X_all = np.vstack([X_tr, X_te])
        y_all = np.concatenate([y_tr, y_te])
        test_fold = np.array([-1] * len(y_tr) + [0] * len(y_te))
        cv = PredefinedSplit(test_fold)
        return X_all, y_all, cv

if 'compute_metrics' not in globals():
    import math
    from sklearn.metrics import r2_score, mean_absolute_error, mean_squared_error
    def compute_metrics(y_true, y_pred):
        mse = mean_squared_error(y_true, y_pred)
        rmse = float(math.sqrt(mse))
        mae = float(mean_absolute_error(y_true, y_pred))
        r2 = float(r2_score(y_true, y_pred))
        residuals = y_true - y_pred
        try:
            kurt = float(stats.kurtosis(residuals, fisher=True, nan_policy="omit"))
        except Exception:
            kurt = float("nan")
        try:
            if len(residuals) < 5000:
                _, pnorm = stats.shapiro(residuals)
                pnorm = float(pnorm)
            else:
                _, pnorm = stats.normaltest(residuals)
                pnorm = float(pnorm)
        except Exception:
            pnorm = float("nan")
        return {"r2": r2, "rmse": rmse, "mse": float(mse), "mae": mae, "residual_kurtosis": kurt, "p_normal": pnorm}

if 'sklearn_cv_results_to_df' not in globals():
    def sklearn_cv_results_to_df(cv) -> "pd.DataFrame":
        try:
            df = pd.DataFrame(cv.cv_results_)
            keep_cols = [c for c in df.columns if c.startswith("param_") or c in ["mean_test_score", "rank_test_score"]]
            return df[keep_cols].copy()
        except Exception:
            return pd.DataFrame()

# Espacio de búsqueda NN
rng = np.random.RandomState(42)

def sample_hidden_structures(min_layers: int, max_layers: int, min_units: int, max_units: int, n_samples: int, rng: np.random.RandomState):
    samples = []
    for _ in range(max(1, n_samples)):
        depth = rng.randint(min_layers, max_layers + 1)
        layers = tuple(int(rng.randint(min_units, max_units + 1)) for _ in range(depth))
        samples.append(layers)
    return list(sorted(set(samples)))

# Motores

def run_randomized_nn(X_tr, y_tr, X_te, y_te, scoring_key: str):
    seed = int(nn_seed.value)
    hidden_samples = sample_hidden_structures(nn_layers_min.value, nn_layers_max.value, nn_units_min.value, nn_units_max.value, nn_structures_samples.value, np.random.RandomState(seed))
    param_distributions = {
        "hidden_layer_sizes": hidden_samples,
        "activation": list(nn_activations.value) or ["relu", "tanh"],
        "solver": list(nn_solvers.value) or ["adam", "lbfgs"],
        "alpha": np.logspace(np.log10(float(nn_alpha_min.value)), np.log10(float(nn_alpha_max.value)), num=20),
        "learning_rate_init": np.logspace(np.log10(float(nn_lr_min.value)), np.log10(float(nn_lr_max.value)), num=20),
        "batch_size": list(nn_batch_sizes.value) or ["auto"],
        "early_stopping": [bool(nn_early_stopping.value)],
        "max_iter": [int(nn_max_iter.value)],
        "random_state": [seed],
    }
    base = MLPRegressor(random_state=seed)
    X_all, y_all, cv = build_predefined_cv(X_tr, y_tr, X_te, y_te)
    rs = RandomizedSearchCV(
        estimator=base,
        param_distributions=param_distributions,
        n_iter=int(nn_n_iter_random.value),
        scoring=scoring_key,
        cv=cv,
        refit=True,
        random_state=seed,
        n_jobs=-1,
        verbose=0,
    )
    rs.fit(X_all, y_all)
    best_params = rs.best_params_.copy()
    model = rs.best_estimator_
    y_pred = model.predict(X_te)
    metrics = compute_metrics(y_te, y_pred)
    hist_df = sklearn_cv_results_to_df(rs)
    return {"engine": "RandomizedSearchCV", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hist_df}


def run_halving_random_nn(X_tr, y_tr, X_te, y_te, scoring_key: str):
    if not HAS_HALVING:
        raise RuntimeError("HalvingRandomSearchCV no disponible.")
    seed = int(nn_seed.value)
    hidden_samples = sample_hidden_structures(nn_layers_min.value, nn_layers_max.value, nn_units_min.value, nn_units_max.value, nn_structures_samples.value, np.random.RandomState(seed))
    param_distributions = {
        "hidden_layer_sizes": hidden_samples,
        "activation": list(nn_activations.value) or ["relu", "tanh"],
        "solver": list(nn_solvers.value) or ["adam", "lbfgs"],
        "alpha": np.logspace(np.log10(float(nn_alpha_min.value)), np.log10(float(nn_alpha_max.value)), num=20),
        "learning_rate_init": np.logspace(np.log10(float(nn_lr_min.value)), np.log10(float(nn_lr_max.value)), num=20),
        "batch_size": list(nn_batch_sizes.value) or ["auto"],
        "early_stopping": [bool(nn_early_stopping.value)],
        "max_iter": [int(nn_max_iter.value)],
        "random_state": [seed],
    }
    base = MLPRegressor(random_state=seed)
    X_all, y_all, cv = build_predefined_cv(X_tr, y_tr, X_te, y_te)
    min_res = min(int(nn_halving_min_resources.value), len(y_tr))
    hrs = HalvingRandomSearchCV(
        estimator=base,
        param_distributions=param_distributions,
        factor=int(nn_halving_factor.value),
        resource='n_samples',
        min_resources=min_res,
        scoring=scoring_key,
        cv=cv,
        n_jobs=-1,
        refit=True,
        random_state=seed,
        verbose=0,
    )
    hrs.fit(X_all, y_all)
    best_params = hrs.best_params_.copy()
    model = hrs.best_estimator_
    y_pred = model.predict(X_te)
    metrics = compute_metrics(y_te, y_pred)
    hist_df = sklearn_cv_results_to_df(hrs)
    return {"engine": "HalvingRandomSearchCV", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hist_df}


def run_optuna_nn(X_tr, y_tr, X_te, y_te, metric_key: str):
    if not HAS_OPTUNA:
        raise RuntimeError("Optuna no disponible.")
    skey, maximize, metric_fn = metric_and_direction(metric_key)
    seed = int(nn_seed.value)

    def objective(trial):
        rng = np.random.RandomState(seed + trial.number)
        depth = rng.randint(nn_layers_min.value, nn_layers_max.value + 1)
        units = [int(rng.randint(nn_units_min.value, nn_units_max.value + 1)) for _ in range(depth)]
        params = {
            "hidden_layer_sizes": tuple(units),
            "activation": trial.suggest_categorical("activation", list(nn_activations.value) or ["relu", "tanh"]),
            "solver": trial.suggest_categorical("solver", list(nn_solvers.value) or ["adam", "lbfgs"]),
            "alpha": trial.suggest_float("alpha", float(nn_alpha_min.value), float(nn_alpha_max.value), log=True),
            "learning_rate_init": trial.suggest_float("learning_rate_init", float(nn_lr_min.value), float(nn_lr_max.value), log=True),
            "batch_size": trial.suggest_categorical("batch_size", list(nn_batch_sizes.value) or ["auto"]),
            "early_stopping": bool(nn_early_stopping.value),
            "max_iter": int(nn_max_iter.value),
            "random_state": seed,
        }
        model = MLPRegressor(**params)
        model.fit(X_tr, y_tr)
        y_pred = model.predict(X_te)
        score = metric_fn(y_te, y_pred)
        return score if maximize else float(score)

    study = optuna.create_study(direction="maximize" if metric_key == "R2" else "minimize")
    study.optimize(objective, n_trials=int(nn_optuna_trials.value), show_progress_bar=False)
    best_params = study.best_trial.params.copy()
    # Reconstruir y_pred en Test con mejor estructura generada aleatoriamente? La estructura va en RNG; reestimar con los params + RNG determinista
    depth = max(nn_layers_min.value, min(nn_layers_max.value, len(str(study.best_trial.number)) % (nn_layers_max.value - nn_layers_min.value + 1) + nn_layers_min.value))
    rng2 = np.random.RandomState(seed + 10)
    units = tuple(int(rng2.randint(nn_units_min.value, nn_units_max.value + 1)) for _ in range(depth))
    best_params["hidden_layer_sizes"] = best_params.get("hidden_layer_sizes", units)
    model = MLPRegressor(**{**best_params, "max_iter": int(nn_max_iter.value), "early_stopping": bool(nn_early_stopping.value), "random_state": seed})
    model.fit(X_tr, y_tr)
    y_pred = model.predict(X_te)
    metrics = compute_metrics(y_te, y_pred)
    try:
        hdf = study.trials_dataframe()
        hdf = hdf.rename(columns={"value": "value"})
    except Exception:
        hdf = pd.DataFrame()
    return {"engine": "Optuna", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hdf}


def run_hyperopt_nn(X_tr, y_tr, X_te, y_te, metric_key: str):
    if not HAS_HYPEROPT:
        raise RuntimeError("Hyperopt no disponible.")
    skey, maximize, metric_fn = metric_and_direction(metric_key)
    seed = int(nn_seed.value)
    space = {
        "activation": hp.choice("activation", list(nn_activations.value) or ["relu", "tanh"]),
        "solver": hp.choice("solver", list(nn_solvers.value) or ["adam", "lbfgs"]),
        "alpha": hp.loguniform("alpha", np.log(float(nn_alpha_min.value)), np.log(float(nn_alpha_max.value))),
        "learning_rate_init": hp.loguniform("learning_rate_init", np.log(float(nn_lr_min.value)), np.log(float(nn_lr_max.value))),
        "batch_size": hp.choice("batch_size", list(nn_batch_sizes.value) or ["auto"]),
    }
    rng = np.random.RandomState(seed)

    def objective(params):
        depth = rng.randint(nn_layers_min.value, nn_layers_max.value + 1)
        units = tuple(int(rng.randint(nn_units_min.value, nn_units_max.value + 1)) for _ in range(depth))
        model = MLPRegressor(
            hidden_layer_sizes=units,
            activation=params["activation"],
            solver=params["solver"],
            alpha=float(params["alpha"]),
            learning_rate_init=float(params["learning_rate_init"]),
            batch_size=params["batch_size"],
            early_stopping=bool(nn_early_stopping.value),
            max_iter=int(nn_max_iter.value),
            random_state=seed,
        )
        model.fit(X_tr, y_tr)
        y_pred = model.predict(X_te)
        score = metric_fn(y_te, y_pred)
        loss = -score if maximize else float(score)
        return {"loss": loss, "status": STATUS_OK}

    trials = Trials()
    # Compatibilidad Hyperopt: algunas versiones esperan numpy.Generator (integers) y otras RandomState (randint)
    try:
        best = fmin(fn=objective, space=space, algo=tpe.suggest, max_evals=int(nn_hyperopt_evals.value), rstate=np.random.default_rng(seed), trials=trials, verbose=False)
    except Exception:
        try:
            best = fmin(fn=objective, space=space, algo=tpe.suggest, max_evals=int(nn_hyperopt_evals.value), rstate=np.random.RandomState(seed), trials=trials, verbose=False)
        except Exception:
            best = fmin(fn=objective, space=space, algo=tpe.suggest, max_evals=int(nn_hyperopt_evals.value), trials=trials, verbose=False)

    # Mapear índices de hp.choice a valores reales
    try:
        from hyperopt import space_eval
        best_mapped = space_eval(space, best)
    except Exception:
        # Fallback manual
        choices_activation = list(nn_activations.value) or ["relu", "tanh"]
        choices_solver = list(nn_solvers.value) or ["adam", "lbfgs"]
        choices_batch = list(nn_batch_sizes.value) or ["auto"]
        act = best.get("activation", 0)
        sol = best.get("solver", 0)
        bs = best.get("batch_size", "auto")
        best_mapped = {
            "activation": choices_activation[int(act)] if isinstance(act, (int, np.integer)) else act,
            "solver": choices_solver[int(sol)] if isinstance(sol, (int, np.integer)) else sol,
            "alpha": best.get("alpha", float(nn_alpha_min.value)),
            "learning_rate_init": best.get("learning_rate_init", float(nn_lr_min.value)),
            "batch_size": choices_batch[int(bs)] if isinstance(bs, (int, np.integer)) else bs,
        }

    # Reconstruir mejor conjunto
    best_params = {
        "activation": str(best_mapped.get("activation", "relu")),
        "solver": str(best_mapped.get("solver", "adam")),
        "alpha": float(best_mapped.get("alpha", float(nn_alpha_min.value))),
        "learning_rate_init": float(best_mapped.get("learning_rate_init", float(nn_lr_min.value))),
        "batch_size": (int(best_mapped.get("batch_size")) if str(best_mapped.get("batch_size")).isdigit() else "auto"),
    }
    depth = rng.randint(nn_layers_min.value, nn_layers_max.value + 1)
    units = tuple(int(rng.randint(nn_units_min.value, nn_units_max.value + 1)) for _ in range(depth))
    best_params["hidden_layer_sizes"] = units
    model = MLPRegressor(**{**best_params, "early_stopping": bool(nn_early_stopping.value), "max_iter": int(nn_max_iter.value), "random_state": seed})
    model.fit(X_tr, y_tr)
    y_pred = model.predict(X_te)
    metrics = compute_metrics(y_te, y_pred)
    vals = []
    for i, tr in enumerate(trials.trials):
        res = tr.get("result", {})
        vals.append({"iter": i + 1, "loss": res.get("loss", np.nan)})
    hdf = pd.DataFrame(vals)
    if metric_key == "R2" and not hdf.empty:
        hdf["score"] = -hdf["loss"]
    return {"engine": "Hyperopt", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hdf}


def run_bayesopt_nn(X_tr, y_tr, X_te, y_te, metric_key: str):
    if not HAS_BAYESOPT:
        raise RuntimeError("bayes_opt no disponible.")
    # Fallback de import para garantizar nombre disponible
    try:
        BayesianOptimization  # type: ignore[name-defined]
    except Exception:
        from bayes_opt import BayesianOptimization as _BO
        globals()["BayesianOptimization"] = _BO
    skey, maximize, metric_fn = metric_and_direction(metric_key)
    seed = int(nn_seed.value)
    rng = np.random.RandomState(seed)

    def objective_fun(hidden_0, hidden_1, depth, alpha, lr, act_idx, solver_idx, bs_idx):
        d = int(round(np.clip(depth, nn_layers_min.value, nn_layers_max.value)))
        sizes = []
        if d >= 1:
            sizes.append(int(round(np.clip(hidden_0, nn_units_min.value, nn_units_max.value))))
        if d >= 2:
            sizes.append(int(round(np.clip(hidden_1, nn_units_min.value, nn_units_max.value))))
        params = {
            "hidden_layer_sizes": tuple(sizes) if sizes else (64,),
            "alpha": float(alpha),
            "learning_rate_init": float(lr),
            "activation": (list(nn_activations.value) or ["relu", "tanh","logistic","identity"])[int(round(act_idx)) % len(list(nn_activations.value) or ["relu","tanh","logistic","identity"])],
            "solver": (list(nn_solvers.value) or ["adam","lbfgs","sgd"])[int(round(solver_idx)) % len(list(nn_solvers.value) or ["adam","lbfgs","sgd"])],
            "batch_size": (list(nn_batch_sizes.value) or [32,64,128])[int(round(bs_idx)) % len(list(nn_batch_sizes.value) or [32,64,128])],
            "early_stopping": bool(nn_early_stopping.value),
            "max_iter": int(nn_max_iter.value),
            "random_state": seed,
        }
        model = MLPRegressor(**params)
        model.fit(X_tr, y_tr)
        y_pred = model.predict(X_te)
        score = metric_fn(y_te, y_pred)
        return score if maximize else -float(score)

    pbounds = {
        "hidden_0": (nn_units_min.value, nn_units_max.value),
        "hidden_1": (nn_units_min.value, nn_units_max.value),
        "depth": (nn_layers_min.value, max(nn_layers_min.value, nn_layers_max.value)),
        "alpha": (float(nn_alpha_min.value), float(nn_alpha_max.value)),
        "lr": (float(nn_lr_min.value), float(nn_lr_max.value)),
        "act_idx": (0, max(1, len(list(nn_activations.value) or ["relu","tanh","logistic","identity"]))-1),
        "solver_idx": (0, max(1, len(list(nn_solvers.value) or ["adam","lbfgs","sgd"]))-1),
        "bs_idx": (0, max(1, len(list(nn_batch_sizes.value) or [32,64,128]))-1),
    }

    optimizer = BayesianOptimization(f=objective_fun, pbounds=pbounds, random_state=seed, verbose=0)
    optimizer.maximize(init_points=10, n_iter=int(nn_n_iter_random.value))
    best = optimizer.max
    params_best = best.get("params", {})
    depth = int(round(params_best.get("depth", 1)))
    sizes = []
    if depth >= 1:
        sizes.append(int(round(params_best.get("hidden_0", 64))))
    if depth >= 2:
        sizes.append(int(round(params_best.get("hidden_1", 64))))
    best_params = {
        "hidden_layer_sizes": tuple(sizes) if sizes else (64,),
        "alpha": float(params_best.get("alpha", 1e-4)),
        "learning_rate_init": float(params_best.get("lr", 1e-3)),
        "activation": (list(nn_activations.value) or ["relu","tanh","logistic","identity"])[int(round(params_best.get("act_idx", 0))) % len(list(nn_activations.value) or ["relu","tanh","logistic","identity"])],
        "solver": (list(nn_solvers.value) or ["adam","lbfgs","sgd"]) [int(round(params_best.get("solver_idx", 0))) % len(list(nn_solvers.value) or ["adam","lbfgs","sgd"])],
        "batch_size": (list(nn_batch_sizes.value) or [32,64,128])[int(round(params_best.get("bs_idx", 0))) % len(list(nn_batch_sizes.value) or [32,64,128])],
    }
    model = MLPRegressor(**{**best_params, "early_stopping": bool(nn_early_stopping.value), "max_iter": int(nn_max_iter.value), "random_state": seed})
    model.fit(X_tr, y_tr)
    y_pred = model.predict(X_te)
    metrics = compute_metrics(y_te, y_pred)
    # Historial completo de la optimización
    try:
        hist_records = []
        try:
            res_list = list(getattr(optimizer, 'res'))
            for i, r in enumerate(res_list):
                hist_records.append({"iter": i + 1, "target": r.get("target", np.nan), **(r.get("params", {}) or {})})
        except Exception:
            # Fallback usando espacio interno
            try:
                targets = list(getattr(optimizer, '_space').target)
                params_list = list(getattr(optimizer, '_space').params)
                for i, (t, p) in enumerate(zip(targets, params_list)):
                    hist_records.append({"iter": i + 1, "target": t, **(p or {})})
            except Exception:
                hist_records = []
        hist_df = pd.DataFrame(hist_records)
    except Exception:
        hist_df = pd.DataFrame([{**params_best, "target": best.get("target", np.nan)}])
    return {"engine": "BayesianOptimization (bayes_opt)", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hist_df}


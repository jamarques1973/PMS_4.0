def _xgbx_log(msg: str):
	try:
		with xgbx_log:
			_display_xgbx(_HTML_xgbx(f"<div style='color:#555'>{msg}</div>"))
	except Exception:
		pass


def _xgbx_append_audit(record: dict):
	try:
		from datetime import datetime as _dt
		record = dict(record or {})
		record.setdefault('model', 'XGB')
		record.setdefault('timestamp', _dt.utcnow().isoformat())
		if not hasattr(app, 'xai_audit') or app.xai_audit is None:
			app.xai_audit = []
		app.xai_audit.append(record)
	except Exception:
		pass


def _prefill_xgbx_features(cols):
	try:
		xgbx_feat.options = ['All'] + list(cols)
		xgbx_feat2.options = ['(auto)'] + list(cols)
		# columnas de subgrupo: inferir categóricas por tipo/unique
		opts = ['(ninguno)']
		if hasattr(app, 'X') and getattr(app.X, 'columns', None) is not None:
			for c in app.X.columns:
				try:
					if app.X[c].dtype == 'object' or app.X[c].nunique() <= 10:
						opts.append(c)
				except Exception:
					pass
		xgbx_bias_col.options = opts
	except Exception:
		pass


def _xgbx_make_subgroups(_=None):
	try:
		if not hasattr(app, 'X') or getattr(app, 'X', None) is None:
			print('No hay X cargadas.')
			return
		df = app.X
		created = []
		for c in list(df.columns):
			try:
				ser = df[c]
				if _pd_xgbx.api.types.is_numeric_dtype(ser) and ser.nunique() > 10:
					try:
						q = _pd_xgbx.qcut(ser, q=4, duplicates='drop')
						name = f"{c}_q{q.nunique()}"
						if name not in df.columns:
							df[name] = q.astype(str)
							created.append(name)
					except Exception:
						pass
			except Exception:
				pass
		# Refrescar opciones de subgrupo
		opts = ['(ninguno)']
		for c in df.columns:
			try:
				ser = df[c]
				if ser.dtype == 'object' or ser.nunique() <= 10:
					opts.append(c)
			except Exception:
				pass
		xgbx_bias_col.options = opts
		if xgbx_bias_col.value not in opts:
			xgbx_bias_col.value = '(ninguno)'
		if created:
			print('Subgrupos creados:', ', '.join(created))
		else:
			print('No se generaron subgrupos nuevos.')
	except Exception as e:
		print('Error al generar subgrupos:', e)

xgbx_btn_make_subgroups.on_click(_xgbx_make_subgroups)


def _plot_grid_xgbx(figs, cols=3):
	outs = []
	for f in figs:
		o = _wxgbx.Output()
		with o:
			try:
				fig = getattr(f, 'figure', f)
				_plt_xgbx.figure(fig.number)
				_plt_xgbx.tight_layout(); _plt_xgbx.show()
				try:
					_plt_xgbx.close(fig)
				except Exception:
					pass
			except Exception:
				pass
		outs.append(o)
	grid = _wxgbx.GridBox(children=outs, layout=_wxgbx.Layout(grid_template_columns=' '.join(['1fr']*cols)))
	_display_xgbx(grid)


# Ejecución principal

def _run_xgbx(_=None):
	# Instalar dependencias xIA si faltan
	try:
		if 'ensure_xai_packages' in globals():
			ensure_xai_packages(progress_output=xgbx_alert)
	except Exception:
		pass
	# Limpiar salidas
	xgbx_alert.clear_output(); xgbx_log.clear_output()
	for o in (xgbx_out_local, xgbx_out_global, xgbx_out_curves, xgbx_out_surrog, xgbx_out_cf, xgbx_out_robust, xgbx_out_bias):
		o.clear_output()
	lbl, prog = xgbx_progress.children
	lbl.value = 'Preparando...'; prog.value = 0; prog.max = 8
	try:
		model, X_tr, y_tr, X_te, y_te, cols, y_col = get_best_xgb_and_data()
		_prefill_xgbx_features(cols)
		# Reducir muestra para xIA costosa
		n = int(min(len(X_te), max(50, xgbx_sample.value)))
		Xs = X_te[:n]; ys = y_te[:n]
		prog.value = 1; lbl.value = 'Locales y SHAP'
		# Local + SHAP
		with xgbx_out_local:
			figs = []
			if xgbx_do_shap.value and _HAS_SHAP_XGBX:
				try:
					expl = _shap_xgbx.TreeExplainer(model)
					shvals = expl.shap_values(Xs)
					_shap_xgbx.summary_plot(shvals, _pd_xgbx.DataFrame(Xs, columns=list(cols)), show=False, max_display=int(xgbx_topk.value))
					figs.append(_plt_xgbx.gcf())
					if xgbx_do_shap_int.value:
						try:
							ish = expl.shap_interaction_values(Xs)
							_shap_xgbx.summary_plot(ish, _pd_xgbx.DataFrame(Xs, columns=list(cols)), show=False, max_display=int(xgbx_topk.value))
							figs.append(_plt_xgbx.gcf())
						except Exception:
							print('SHAP interactions no disponibles.')
				except Exception as e:
					print('SHAP error:', e)
			_plot_grid_xgbx(figs, cols=2)
		prog.value = 2; lbl.value = 'Permutation Importance'
		with xgbx_out_global:
			try:
				# Bootstrap de PI
				boots = int(max(1, xgbx_pi_boot.value)); reps = int(max(1, xgbx_pi_repeats.value))
				imps = []
				rng = _np_xgbx.random.RandomState(42)
				for b in range(boots):
					idx = rng.choice(len(Xs), size=len(Xs), replace=True)
					r = _permimp_xgbx(model, Xs[idx], ys[idx], n_repeats=reps, random_state=rng, scoring='r2')
					imps.append(_pd_xgbx.Series(r.importances_mean, index=list(cols)))
				imp_df = _pd_xgbx.DataFrame(imps)
				imp_mean = imp_df.mean().sort_values(ascending=False)
				topk = imp_mean.head(int(xgbx_topk.value))
				ax = topk.iloc[::-1].plot.barh(figsize=(5.5,3.2), color='#1f77b4'); ax.set_title('PI (bootstrap)'); _plt_xgbx.tight_layout(); _plt_xgbx.show()
				ci = imp_df[topk.index].std()
				_display_xgbx(_pd_xgbx.DataFrame({'mean': topk, 'std': ci[topk.index]}))
			except Exception as e:
				print('PI error:', e)
		prog.value = 3; lbl.value = 'PDP/ICE/ALE'
		with xgbx_out_curves:
			try:
				# Determinar conjunto de features a graficar
				feats = [xgbx_feat.value] if (xgbx_feat.value and xgbx_feat.value!='All') else list(cols)[:int(max(1, xgbx_topk.value))]
				# PDP/ICE para todas las features seleccionadas (grid)
				if xgbx_do_pdp.value:
					out_panels = []
					for f in feats:
						o = _wxgbx.Output()
						with o:
							try:
								fig, ax = _plt_xgbx.subplots(1,1, figsize=(4.2,2.6))
								_PDP_xgbx.from_estimator(model, Xs, features=[f], feature_names=list(cols), ax=ax, kind='both', grid_resolution=int(max(10, xgbx_grid.value)))
								ax.set_title(f'PDP/ICE: {f}')
								_plt_xgbx.tight_layout(); _plt_xgbx.show(); _plt_xgbx.close(fig)
							except Exception:
								try:
									fig, ax = _plt_xgbx.subplots(1,1, figsize=(4.2,2.6))
									_PDP_xgbx.from_estimator(model, Xs, features=[f], feature_names=list(cols), ax=ax, grid_resolution=int(max(10, xgbx_grid.value)))
									ax.set_title(f'PDP: {f}')
									_plt_xgbx.tight_layout(); _plt_xgbx.show(); _plt_xgbx.close(fig)
								except Exception as _e_pdp:
									print('PDP error:', _e_pdp)
						out_panels.append(o)
					grid = _wxgbx.GridBox(children=out_panels, layout=_wxgbx.Layout(grid_template_columns='1fr 1fr 1fr'))
					_display_xgbx(grid)
				# ALE 1D/2D si está disponible
				if xgbx_do_ale.value and _HAS_PYALE_XGBX:
					try:
						dfXs = _pd_xgbx.DataFrame(Xs, columns=list(cols))
						ale_panels = []
						for f in feats:
							o = _wxgbx.Output()
							with o:
								try:
									ale = _ALE_xgbx(X=dfXs, model=model.predict, feature=[str(f)])
									fig = ale.plot(); _plt_xgbx.tight_layout(); _plt_xgbx.show(); _plt_xgbx.close(fig)
								except Exception as _e_ale1:
									print('ALE 1D error:', _e_ale1)
							ale_panels.append(o)
						# 2D ALE: pares
						pairs = []
						if xgbx_feat2.value and xgbx_feat2.value!='(auto)':
							pairs = [(f, xgbx_feat2.value) for f in feats if f != xgbx_feat2.value]
						else:
							# Auto: usar top importances del modelo si existen
							try:
								imp = _pd_xgbx.Series(getattr(model, 'feature_importances_', _np_xgbx.zeros(len(cols))), index=list(cols)).sort_values(ascending=False)
								top_feats = [f for f in imp.index if f in feats][:min(5, len(feats))]
								for i in range(len(top_feats)-1):
									pairs.append((top_feats[i], top_feats[i+1]))
							except Exception:
								pairs = []
						for f1, f2 in pairs[:6]:
							o2 = _wxgbx.Output()
							with o2:
								try:
									ale2 = _ALE_xgbx(X=dfXs, model=model.predict, feature=[str(f1), str(f2)])
									fig2 = ale2.plot(); _plt_xgbx.tight_layout(); _plt_xgbx.show(); _plt_xgbx.close(fig2)
								except Exception as _e_ale2:
									print('ALE 2D error:', _e_ale2)
							ale_panels.append(o2)
						if ale_panels:
							grid_ale = _wxgbx.GridBox(children=ale_panels, layout=_wxgbx.Layout(grid_template_columns='1fr 1fr 1fr'))
							_display_xgbx(grid_ale)
					except Exception as e:
						print('ALE error:', e)
			except Exception as e:
				print('Curvas error:', e)
		prog.value = 4; lbl.value = 'Sustitutos'
		with xgbx_out_surrog:
			figs = []
			try:
				tree = _DTR_xgbx(max_depth=int(xgbx_tree_depth.value), ccp_alpha=float(xgbx_tree_ccp.value), random_state=42)
				tree.fit(Xs, model.predict(Xs))
				r2 = float(_r2_xgbx(model.predict(Xs), tree.predict(Xs)))
				imp = _pd_xgbx.Series(getattr(tree, 'feature_importances_', _np_xgbx.zeros(len(cols))), index=list(cols)).sort_values(ascending=False)
				ax = imp.head(int(xgbx_topk.value)).iloc[::-1].plot.barh(figsize=(5.0,3.0)); ax.set_title(f'Surrogate Tree (R2={r2:.3f})'); figs.append(_plt_xgbx.gcf())
				txt = _export_text_xgbx(tree, feature_names=list(cols))
				_display_xgbx(_HTML_xgbx('<pre style="max-height:200px;overflow:auto">'+txt+'</pre>'))
			except Exception as e:
				print('Árbol sustituto error:', e)
			if xgbx_do_rulefit.value and _HAS_RULEFIT_XGBX:
				try:
					rf = _RuleFit_xgbx()
					rf.fit(Xs, model.predict(Xs), feature_names=list(cols))
					try:
						imp_df = rf.get_feature_importance()
						imp = _pd_xgbx.Series(imp_df.set_index('feature')['importance'])
					except Exception:
						# imodels.RuleFitRegressor: usar atributo feature_importances_ si existe
						imp = _pd_xgbx.Series(getattr(rf, 'feature_importances_', _np_xgbx.zeros(len(cols))), index=list(cols))
					ax = imp.sort_values(ascending=False).head(int(xgbx_topk.value)).iloc[::-1].plot.barh(figsize=(5.0,3.0)); ax.set_title('RuleFit importances'); figs.append(_plt_xgbx.gcf())
				except Exception as e:
					print('RuleFit error:', e)
			_plot_grid_xgbx(figs, cols=2)
		prog.value = 5; lbl.value = 'Contrafactuales'
		with xgbx_out_cf:
			if xgbx_do_dice.value and _HAS_DICE_XGBX:
				try:
					dfX = _pd_xgbx.DataFrame(Xs, columns=list(cols)); dfy = _pd_xgbx.Series(ys, name='y')
					data = _dice_xgbx.Data(dataframe=_pd_xgbx.concat([dfX, dfy], axis=1), continuous_features=list(cols), outcome_name='y')
					m = _dice_xgbx.Model(model=model, backend='sklearn', model_type='regressor')
					exp = _dice_xgbx.Dice(data, m, method='random')
					inst = dfX.iloc[[min(len(dfX)-1, 0)]]
					y_min, y_max = float(_np_xgbx.min(ys)), float(_np_xgbx.max(ys))
					ymin_adj = y_min + (xgbx_dice_range_min_pct.value/100.0)*(y_max - y_min)
					ymax_adj = y_min + (xgbx_dice_range_max_pct.value/100.0)*(y_max - y_min)
					if ymax_adj < ymin_adj:
						ymin_adj, ymax_adj = ymax_adj, ymin_adj
					cfs = exp.generate_counterfactuals(inst, total_CFs=int(xgbx_dice_k.value), desired_range=(float(ymin_adj), float(ymax_adj)), features_to_vary='all')
					try:
						_display_xgbx(_HTML_xgbx(cfs.to_html()))
					except Exception:
						_display_xgbx(_HTML_xgbx(str(cfs)))
				except Exception as e:
					# Mensaje orientativo para ayudar al usuario a obtener CFs
					_display_xgbx(_HTML_xgbx("<div style='color:#b00'>No se generaron contrafactuales con la configuración actual.</div>"))
					_display_xgbx(_HTML_xgbx("<ul><li>Amplíe el rango deseado (ymin/ymax).</li><li>Permita variar más variables (features_to_vary='all').</li><li>Pruebe con más #CFs y método 'genetic' si está disponible.</li><li>Revise el escalado de Y y que el modelo no sea demasiado rígido.</li></ul>"))
			else:
				print('DiCE no disponible o desactivado.')
		prog.value = 6; lbl.value = 'Robustez'
		with xgbx_out_robust:
			if xgbx_do_robust.value:
				try:
					it = int(xgbx_robust_iters.value)
					rng = _np_xgbx.random.RandomState(0)
					ranks = []
					for i in range(it):
						idx = rng.choice(len(Xs), size=len(Xs), replace=True)
						r = _permimp_xgbx(model, Xs[idx], ys[idx], n_repeats=4, random_state=rng, scoring='r2')
						ranks.append(_pd_xgbx.Series(r.importances_mean, index=list(cols)).rank(ascending=False))
					rank_df = _pd_xgbx.DataFrame(ranks)
					stab = rank_df.std().sort_values()
					_display_xgbx(_pd_xgbx.DataFrame({'rank_std': stab}))
				except Exception as e:
					print('Robustez error:', e)
			else:
				print('Robustez desactivada.')
				prog.value = 7; lbl.value = 'Sesgos/Subgrupos'
		with xgbx_out_bias:
			try:
				if xgbx_do_bias.value and xgbx_bias_col.value and xgbx_bias_col.value != '(ninguno)':
					df = _pd_xgbx.DataFrame(Xs, columns=list(cols))
					gcol = xgbx_bias_col.value
					if gcol in getattr(app.X, 'columns', []):
						groups = list(_pd_xgbx.Categorical(app.X.loc[app.X.index[:len(df)], gcol]).categories)
					else:
						groups = list(_pd_xgbx.Categorical(df[gcol]).categories) if gcol in df.columns else []
					panels = []
					for gg in groups[:6]:
						o = _wxgbx.Output()
						with o:
							try:
								mask = (app.X.loc[app.X.index[:len(df)], gcol].astype(str) == str(gg)) if gcol in getattr(app.X, 'columns', []) else (df[gcol].astype(str) == str(gg))
								Xg = df[mask.values].values; yg = ys[mask.values]
								if len(Xg) < 5:
									print(f'{gcol}={gg}: grupo pequeño (n<5).');
									continue
								pred = model.predict(Xg)
								r2 = float(_r2_xgbx(yg, pred))

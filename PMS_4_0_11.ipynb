def ensure_xai_packages(progress_output=None):
    global HAS_SHAP, HAS_LIME, HAS_PYALE, HAS_DICE, HAS_RULEFIT, HAS_SK_INSPECTION
    missing = []
    if not HAS_SHAP:
        missing.append("shap")
    if not HAS_LIME:
        missing.append("lime")
    if not HAS_PYALE:
        missing.append("PyALE")
    if not HAS_DICE:
        missing.append("dice-ml")
    if not HAS_RULEFIT:
        missing.append("rulefit")
    if missing:
        import sys, subprocess
        # Barra de progreso
        prog = widgets.IntProgress(value=0, min=0, max=len(missing), bar_style='info', description='xIA', orientation='horizontal')
        prog_label = widgets.HTML(value=f"Instalando dependencias xIA: {', '.join(missing)}")
        if progress_output is not None:
            with progress_output:
                display(widgets.VBox([prog_label, prog]))
        for i, pkg in enumerate(missing, start=1):
            try:
                if progress_output is not None:
                    prog_label.value = f"Instalando {pkg} ({i}/{len(missing)})…"
                subprocess.check_call([sys.executable, "-m", "pip", "install", "-q", pkg])
            except Exception as _e:
                if progress_output is not None:
                    with progress_output:
                        display(widgets.HTML(value=f"<div>⚠️ No se pudo instalar {pkg}: {str(_e)}</div>"))
            finally:
                prog.value = i
        if progress_output is not None:
            prog.bar_style = 'success'
            prog_label.value = "Instalación xIA completada."
    # reintentos
    try:
        import shap  # noqa: F401
        HAS_SHAP = True
    except Exception:
        HAS_SHAP = False
    try:
        from lime.lime_tabular import LimeTabularExplainer  # noqa: F401
        HAS_LIME = True
    except Exception:
        HAS_LIME = False
    try:
        from PyALE import ALE  # noqa: F401

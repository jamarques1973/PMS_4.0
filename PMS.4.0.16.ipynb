# Botón handler

def plot_diagnostics_matrix(y_true: np.ndarray, y_pred: np.ndarray, title_prefix: str = "NN"):
    residuals = y_true - y_pred
    fig, axes = plt.subplots(2, 2, figsize=(12, 10))
    # Y real vs Predicho
    ax = axes[0, 0]
    ax.scatter(y_true, y_pred, alpha=0.5, s=18)
    lims = [min(np.min(y_true), np.min(y_pred)), max(np.max(y_true), np.max(y_pred))]
    ax.plot(lims, lims, "r--", lw=1)
    ax.set_xlabel("Y real"); ax.set_ylabel("Y predicho"); ax.set_title(f"{title_prefix}: Y real vs Y predicho")
    # Residuos vs Predicción
    ax = axes[0, 1]
    ax.scatter(y_pred, residuals, alpha=0.5, s=18)
    ax.axhline(0.0, color="r", linestyle="--", lw=1)
    ax.set_xlabel("Y predicho"); ax.set_ylabel("Residuos"); ax.set_title("Residuos vs Predicción")
    # Histograma de residuos
    ax = axes[1, 0]
    sns.histplot(residuals, kde=True, ax=ax, color="#1f77b4")
    ax.set_title("Distribución de residuos"); ax.set_xlabel("Residuo")
    # QQ-Plot
    ax = axes[1, 1]
    stats.probplot(residuals, dist="norm", plot=ax); ax.set_title("QQ-Plot de residuos")
    plt.tight_layout(); plt.show()


def on_run_nn(_):
    nn_alert.clear_output(); nn_histories_out.clear_output(); nn_tables_out.clear_output(); nn_best_out.clear_output(); nn_progress_out.clear_output()
    prog = widgets.IntProgress(value=0, min=0, max=6, description='HPO', bar_style='info')
    prog_label = widgets.HTML(value='Preparando...')
    with nn_progress_out:
        display(widgets.VBox([prog_label, prog]))

    # Validaciones
    try:
        X_df = app.X; Y_df = app.Y
    except Exception:
        X_df = None; Y_df = None
    if X_df is None or Y_df is None:
        with nn_alert:
            display(make_alert_html("Cargue X e Y antes de optimizar.", level="warning"))
        return
    y_col = None
    try:
        y_col = y_col_dropdown.value
    except Exception:
        pass
    if y_col is None:
        with nn_alert:
            display(make_alert_html("Seleccione una columna Y.", level="warning"))
        return
    if not getattr(app, 'segments', []):
        with nn_alert:
            display(make_alert_html("Genere la segmentación (Train/Test).", level="warning"))
        return

    seg = app.segments[0]
    X_tr, y_tr, X_te, y_te, cols, _, _ = prepare_train_test(app.X, app.Y[y_col], seg, use_selected_chk.value, scale_x_chk.value, scale_y_chk.value)
    skey, maximize, _metric_fn = metric_and_direction(nn_metric_dropdown.value)

    # Instalar opcionales si se requieren (igual que SVR)
    try:
        need_opt = (
            (nn_run_optuna_chk.value and not HAS_OPTUNA) or
            (nn_run_hyperopt_chk.value and not HAS_HYPEROPT) or
            (nn_run_skopt_chk.value and not HAS_SKOPT) or
            (nn_run_bayesopt_chk.value and not HAS_BAYESOPT)
        )
    except Exception:
        need_opt = False
    if need_opt and 'ensure_optional_packages' in globals():
        ensure_optional_packages(progress_output=nn_alert)

    results = []
    history_items = []

    # Randomized
    try:
        if nn_run_random_chk.value:
            prog_label.value = 'RandomizedSearchCV corriendo...'; prog.value = min(prog.max, prog.value + 1)
            res = run_randomized_nn(X_tr, y_tr, X_te, y_te, scoring_key=skey)
            results.append(res)
            hdf = res.get("history", pd.DataFrame())
            if not hdf.empty and "mean_test_score" in hdf.columns:
                history_items.append(("RandomizedSearchCV", np.arange(len(hdf)), hdf["mean_test_score"], "score"))
    except Exception as e:
        with nn_alert:
            display(make_alert_html(f"Error RandomizedSearchCV: {e}", level="error"))

    # Halving
    try:
        if nn_run_halving_chk.value and HAS_HALVING:
            prog_label.value = 'HalvingRandomSearchCV corriendo...'; prog.value = min(prog.max, prog.value + 1)
            res = run_halving_random_nn(X_tr, y_tr, X_te, y_te, scoring_key=skey)
            results.append(res)
            hdf = res.get("history", pd.DataFrame())
            if not hdf.empty and "mean_test_score" in hdf.columns:
                history_items.append(("HalvingRandomSearchCV", np.arange(len(hdf)), hdf["mean_test_score"], "score"))
    except Exception as e:
        with nn_alert:
            display(make_alert_html(f"Error HalvingRandomSearchCV: {e}", level="error"))

    # Optuna
    try:
        if nn_run_optuna_chk.value and HAS_OPTUNA:
            prog_label.value = 'Optuna corriendo...'; prog.value = min(prog.max, prog.value + 1)
            res = run_optuna_nn(X_tr, y_tr, X_te, y_te, metric_key=nn_metric_dropdown.value)
            results.append(res)
            hdf = res.get("history", pd.DataFrame())
            if not hdf.empty and "value" in hdf.columns:
                history_items.append(("Optuna", hdf.index if 'number' not in hdf.columns else hdf["number"], hdf["value"], "valor objetivo"))
    except Exception as e:
        with nn_alert:
            display(make_alert_html(f"Error Optuna: {e}", level="error"))

    # Hyperopt
    try:
        if nn_run_hyperopt_chk.value and HAS_HYPEROPT:
            prog_label.value = 'Hyperopt corriendo...'; prog.value = min(prog.max, prog.value + 1)
            res = run_hyperopt_nn(X_tr, y_tr, X_te, y_te, metric_key=nn_metric_dropdown.value)
            results.append(res)
            hdf = res.get("history", pd.DataFrame())
            if not hdf.empty:
                y = (-hdf["loss"]) if nn_metric_dropdown.value == "R2" and "loss" in hdf.columns else hdf.get("score", pd.Series(dtype=float))
                ylab = "R2" if nn_metric_dropdown.value == "R2" else nn_metric_dropdown.value
                if y is not None and len(y) == len(hdf):
                    history_items.append(("Hyperopt", hdf.get("iter", pd.Series(range(1, len(hdf)+1))), y, ylab))
    except Exception as e:
        with nn_alert:
            display(make_alert_html(f"Error Hyperopt: {e}", level="error"))

    # bayes_opt (nuevo motor)
    try:
        if nn_run_bayesopt_chk.value and HAS_BAYESOPT:
            prog_label.value = 'BayesianOptimization (bayes_opt) corriendo...'; prog.value = min(prog.max, prog.value + 1)
            res = run_bayesopt_nn(X_tr, y_tr, X_te, y_te, metric_key=nn_metric_dropdown.value)
            results.append(res)
            hdf = res.get("history", pd.DataFrame())
            if not hdf.empty:
                x_series = hdf["iter"] if "iter" in hdf.columns else pd.Series(range(1, len(hdf)+1))
                y_series = hdf["target"] if "target" in hdf.columns else pd.Series(dtype=float)
                if len(y_series) == len(x_series) and len(y_series) > 0:
                    history_items.append(("BayesianOptimization (bayes_opt)", x_series, y_series, "target"))
    except Exception as e:
        with nn_alert:
            display(make_alert_html(f"Error bayes_opt: {e}", level="error"))

    if not results:
        with nn_alert:
            display(make_alert_html("Seleccione y ejecute al menos un motor.", level="warning"))
        return

    # Comparar y elegir mejor
    metric_key = nn_metric_dropdown.value
    skey2, maximize, metric_fn = metric_and_direction(metric_key)
    rows = []
    for res in results:
        met = res.get("metrics", {})
        rows.append({
            "engine": res.get("engine"),
            "r2": met.get("r2"),
            "rmse": met.get("rmse"),
            "mse": met.get("mse"),
            "mae": met.get("mae"),
            "residual_kurtosis": met.get("residual_kurtosis"),
            "p_normal": met.get("p_normal"),
        })
    comp_df = pd.DataFrame(rows)
    # Selección robusta del mejor motor usando una columna 'score' homogénea
    if not comp_df.empty:
        if metric_key == "R2":
            comp_df["score"] = comp_df["r2"]
            best_idx = int(comp_df["score"].idxmax())
        elif metric_key == "RMSE":
            comp_df["score"] = -comp_df["rmse"]
            best_idx = int(comp_df["score"].idxmax())
        elif metric_key == "MSE":
            comp_df["score"] = -comp_df["mse"]
            best_idx = int(comp_df["score"].idxmax())
        else:
            comp_df["score"] = -comp_df["mae"]
            best_idx = int(comp_df["score"].idxmax())
        comp_df["is_best"] = False; comp_df.loc[best_idx, "is_best"] = True
        best_engine_name = str(comp_df.loc[best_idx, "engine"]) if "engine" in comp_df.columns else None
    else:
        best_engine_name = None

    # Historiales en grid (mostrar engine en título)
    if history_items:
        with nn_histories_out:
            cols = 2
            rows_n = int(np.ceil(len(history_items)/cols))
            fig, axes = plt.subplots(rows_n, cols, figsize=(12, max(3, rows_n*3)))
            axes = np.array(axes).reshape(rows_n, cols)
            for i, (title, x, y, ylab) in enumerate(history_items):
                r = i // cols; c = i % cols
                ax = axes[r, c]
                sns.lineplot(x=x, y=y, ax=ax, color="#1f77b4", linewidth=2)
                ax.set_title(f"Historial — {title}"); ax.set_xlabel("iter"); ax.set_ylabel(ylab)
            for j in range(i+1, rows_n*cols):
                r = j // cols; c = j % cols
                axes[r, c].axis('off')
            plt.tight_layout(); plt.show()

    with nn_tables_out:
        display(widgets.HTML(value="<i>Función objetivo seleccionada:</i> " + metric_key + ". La tabla resume métricas en Test."))
        show_df(comp_df, caption="Tabla comparativa de motores (NN)")
        # Tabla de hiperparámetros
        params_rows = []
        for res in results:
            bp = res.get("best_params", {})
            params_rows.append({"engine": res.get("engine"), **{k.replace('param_', ''): v for k, v in bp.items()}})
        params_df = pd.DataFrame(params_rows)
        show_df(params_df, caption="Hiperparámetros óptimos por motor (NN)")
        # Indicar mejor motor seleccionado
        display(widgets.HTML(value=f"<b>Mejor motor:</b> {best_engine_name or results[best_idx].get('engine','?')}"))

    best_res = next((r for r in results if r.get('engine') == best_engine_name), results[best_idx])
    with nn_best_out:
        y_pred = best_res.get("y_pred")
        plot_diagnostics_matrix(y_te, y_pred, title_prefix=f"NN — mejor por {best_res.get('engine','?')}")
        display(widgets.HTML(value=f"<i>Métricas (Test) del mejor NN — motor: {best_res.get('engine','?')}</i>"))
        show_df(pd.DataFrame([best_res.get("metrics", {})]), caption=f"Mejor NN — métricas (Test) — {best_res.get('engine','?')}")

    # Persistir
    persist_payload = {
        "y_column": y_col,
        "segment": seg.get("name"),
        "metric": metric_key,
        "engines": [r.get("engine") for r in results],
        "comparison_table": comp_df.to_dict(orient="records"),
        "best_engine": best_res.get("engine"),
        "best_params": best_res.get("best_params", {}),
        "best_metrics": best_res.get("metrics", {}),
        "X_used_columns": cols,
    }
    persist_results_for_comparison("NN", persist_payload)

    # Guardar en estado app
    app.nn_optim_results = persist_payload

    prog.value = prog.max; prog.bar_style = 'success'; prog_label.value = 'HPO completado'
    with nn_alert:
        display(make_alert_html("Optimización NN finalizada.", level="success"))


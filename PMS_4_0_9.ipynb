def _engine_metric_value(metric_key: str, metrics: dict) -> float:
    if metric_key == "R2":
        return float(metrics.get("r2", float("nan")))
    if metric_key == "RMSE":
        return float(metrics.get("rmse", float("nan")))
    if metric_key == "MAE":
        return float(metrics.get("mae", float("nan")))
    if metric_key == "MSE":
        return float(metrics.get("mse", float("nan")))
    return float(metrics.get("r2", float("nan")))


def on_run_svr(_):
    svr_alert.clear_output(); svr_histories_out.clear_output(); svr_tables_out.clear_output(); svr_best_out.clear_output(); svr_progress_out.clear_output()
    # Barra de progreso (6 pasos máx.)
    prog = widgets.IntProgress(value=0, min=0, max=6, description='HPO', bar_style='info')
    prog_label = widgets.HTML(value='Preparando...')
    with svr_progress_out:
        display(widgets.VBox([prog_label, prog]))
    # Validaciones
    if app.X is None or app.Y is None:
        with svr_alert:
            display(make_alert_html("Cargue X e Y antes de optimizar.", level="warning"))
        return
    y_col = None
    if sel_y_col.value is not None:
        y_col = sel_y_col.value
    elif y_col_dropdown.value is not None:
        y_col = y_col_dropdown.value
    if y_col is None:
        with svr_alert:
            display(make_alert_html("Seleccione una columna Y.", level="warning"))
        return
    if not app.segments:
        with svr_alert:
            display(make_alert_html("Genere la segmentación (Train/Test).", level="warning"))
        return
    seg = app.segments[0]
    # Preparar datos
    X_tr, y_tr, X_te, y_te, cols, _, _ = prepare_train_test(app.X, app.Y[y_col], seg, use_selected_chk.value, scale_x_chk.value, scale_y_chk.value)
    skey, maximize, _metric_fn = metric_and_direction(metric_dropdown.value)

    # Instalar opcionales si se requieren
    need_opt = (run_optuna_chk.value and not HAS_OPTUNA) or (run_hyperopt_chk.value and not HAS_HYPEROPT) or (run_skopt_chk.value and not HAS_SKOPT)
    if need_opt:
        ensure_optional_packages(progress_output=svr_alert)
        # Normalizar flags tras instalación
        need_opt = (run_optuna_chk.value and not HAS_OPTUNA) or (run_hyperopt_chk.value and not HAS_HYPEROPT) or (run_skopt_chk.value and not HAS_SKOPT)

    results = []
    history_items: list = []
    # Motores sklearn
    try:
        if run_random_chk.value:
            prog_label.value = 'RandomizedSearchCV corriendo...'; prog.value = min(prog.max, prog.value + 1)
            res = run_randomized_search(X_tr, y_tr, X_te, y_te, scoring_key=skey)
            results.append(res)
            hdf = res.get("history", pd.DataFrame())
            if not hdf.empty and "mean_test_score" in hdf.columns:
                history_items.append(("RandomizedSearchCV", np.arange(len(hdf)), hdf["mean_test_score"], "score"))
    except Exception as e:
        with svr_alert:
            display(make_alert_html(f"Error RandomizedSearchCV: {e}", level="error"))
    try:
        if run_halving_chk.value and HAS_HALVING:
            prog_label.value = 'HalvingRandomSearchCV corriendo...'; prog.value = min(prog.max, prog.value + 1)
            res = run_halving_random_search(X_tr, y_tr, X_te, y_te, scoring_key=skey)
            results.append(res)
            hdf = res.get("history", pd.DataFrame())
            if not hdf.empty and "mean_test_score" in hdf.columns:
                history_items.append(("HalvingRandomSearchCV", np.arange(len(hdf)), hdf["mean_test_score"], "score"))
    except Exception as e:
        with svr_alert:
            display(make_alert_html(f"Error HalvingRandomSearchCV: {e}", level="error"))
    # Optuna
    try:
        if run_optuna_chk.value and HAS_OPTUNA:
            # Optuna: mostrar progreso con callback
            prog_label.value = 'Optuna corriendo...'
            res = run_optuna(X_tr, y_tr, X_te, y_te, metric_key=metric_dropdown.value)
            prog.value = min(prog.max, prog.value + 1)
            results.append(res)
            # Plot historial luego en grid pequeño
            hdf = res.get("history", pd.DataFrame())
            if not hdf.empty and "number" in hdf.columns and "value" in hdf.columns:
                history_items.append(("Optuna", hdf["number"], hdf["value"], "valor objetivo"))
    except Exception as e:
        with svr_alert:
            display(make_alert_html(f"Error Optuna: {e}", level="error"))
    # Hyperopt
    try:
        if run_hyperopt_chk.value and HAS_HYPEROPT:
            prog_label.value = 'Hyperopt corriendo...'
            res = run_hyperopt(X_tr, y_tr, X_te, y_te, metric_key=metric_dropdown.value)
            prog.value = min(prog.max, prog.value + 1)
            results.append(res)
            hdf = res.get("history", pd.DataFrame())
            if not hdf.empty and "iter" in hdf.columns:
                y = (-hdf["loss"]) if metric_dropdown.value == "R2" else hdf["loss"]
                ylab = "R2" if metric_dropdown.value == "R2" else metric_dropdown.value
                history_items.append(("Hyperopt", hdf["iter"], y, ylab))
    except Exception as e:
        with svr_alert:
            display(make_alert_html(f"Error Hyperopt: {e}", level="error"))
    # skopt
    try:
        if run_skopt_chk.value and HAS_SKOPT:
            prog_label.value = 'BayesSearchCV (skopt) corriendo...'
            res = run_skopt_bayes(X_tr, y_tr, X_te, y_te, scoring_key=skey)
            prog.value = min(prog.max, prog.value + 1)
            results.append(res)
            hdf = res.get("history", pd.DataFrame())
            if not hdf.empty and "mean_test_score" in hdf.columns:
                history_items.append(("BayesSearchCV (skopt)", np.arange(len(hdf)), hdf["mean_test_score"], "score"))
    except Exception as e:
        with svr_alert:
            display(make_alert_html(f"Error skopt: {e}", level="error"))

    if not results:
        with svr_alert:
            display(make_alert_html("Seleccione y ejecute al menos un motor.", level="warning"))
        return

    # Tablas comparativas
    rows = []
    for r in results:
        m = r.get("metrics", {})
        rows.append({
            "engine": r.get("engine"),
            "r2": m.get("r2"),
            "rmse": m.get("rmse"),
            "mae": m.get("mae"),
            "mse": m.get("mse"),
            "residual_kurtosis": m.get("residual_kurtosis"),
            "p_normal": m.get("p_normal"),
            "best_params": json.dumps(r.get("best_params", {}), ensure_ascii=False),
        })
    comp_df = pd.DataFrame(rows)
    # Elegir mejor
    metric_key = metric_dropdown.value
    if metric_key == "R2":
        best_idx = int(comp_df["r2"].astype(float).idxmax())
    elif metric_key == "RMSE":
        best_idx = int(comp_df["rmse"].astype(float).idxmin())
    elif metric_key == "MAE":
        best_idx = int(comp_df["mae"].astype(float).idxmin())
    else:
        best_idx = int(comp_df["mse"].astype(float).idxmin())
    comp_df["is_best"] = False
    comp_df.loc[best_idx, "is_best"] = True

    # Mostrar historiales en grid compacto con ayudas
    if history_items:
        with svr_histories_out:
            cols = 2
            rows = int(np.ceil(len(history_items)/cols))
            fig, axes = plt.subplots(rows, cols, figsize=(10, rows*2.2))
            axes = np.atleast_2d(axes)
            for idx, (name, x, y, ylab) in enumerate(history_items):
                r = idx // cols; c = idx % cols
                ax = axes[r, c]
                plot_history_uniform(ax, x, y, f"{name}", ylab)
            # Ocultar ejes sobrantes
            for k in range(len(history_items), rows*cols):
                r = k // cols; c = k % cols
                axes[r, c].axis('off')
            plt.tight_layout(); plt.show()
            display(widgets.HTML(value="<i>Ayuda historiales HPO:</i> cada curva muestra la evolución del score objetivo por iteración/candidato. La convergencia y estabilidad sugieren que el motor exploró suficiente el espacio. Compare las tendencias para entender velocidad y estabilidad de cada motor."))

    with svr_tables_out:
        display(widgets.HTML(value="<i>Función objetivo seleccionada:</i> " + metric_key + ". La tabla resume métricas en Test: R2 (↑ mejor), RMSE/MSE/MAE (↓ mejor)."))
        display(comp_df)
        display(widgets.HTML(value="<i>Interpretación:</i> utilice 'is_best' para identificar el mejor motor según la función objetivo. 'p_normal' y 'kurtosis de residuo' ayudan a evaluar supuestos y colas/picos."))

        # Tabla de hiperparámetros por motor
        hp_rows = []
        for r in results:
            bp = r.get("best_params", {})
            row = {"engine": r.get("engine")}
            for k, v in bp.items():
                row[str(k)] = v
            hp_rows.append(row)
        hp_df = pd.DataFrame(hp_rows).fillna("")
        display(widgets.HTML(value="<i>Hiperparámetros óptimos por motor</i>"))
        display(hp_df)
        display(widgets.HTML(value="<i>Cómo leer:</i> cada fila corresponde al mejor conjunto del motor. Úselo para reproducibilidad y para analizar sensibilidad (C, epsilon, gamma, tol, shrinking, etc.)."))

        # Gráfica comparativa de resultados
        fig, ax = plt.subplots(figsize=(8, 4))
        engines = comp_df["engine"].astype(str).tolist()
        if metric_key == "R2":
            vals = comp_df["r2"].astype(float).tolist()
            ax.bar(engines, vals, color="#1f77b4")
            ax.set_ylabel("R2 (más alto es mejor)")
        elif metric_key == "RMSE":
            vals = comp_df["rmse"].astype(float).tolist()
            ax.bar(engines, vals, color="#ff7f0e")
            ax.set_ylabel("RMSE (más bajo es mejor)")
        elif metric_key == "MAE":
            vals = comp_df["mae"].astype(float).tolist()
            ax.bar(engines, vals, color="#2ca02c")
            ax.set_ylabel("MAE (más bajo es mejor)")
        else:
            vals = comp_df["mse"].astype(float).tolist()
            ax.bar(engines, vals, color="#9467bd")
            ax.set_ylabel("MSE (más bajo es mejor)")
        ax.set_title("Comparativa de motores vs función objetivo")
        ax.set_xticks(range(len(engines)))
        ax.set_xticklabels(engines, rotation=15, ha="right")
        plt.tight_layout()
        plt.show()
        display(widgets.HTML(value="<i>Cómo leer la comparativa:</i> barras más favorables indican mejor ajuste según el objetivo. Útil para decidir el motor preferido y validar coherencia respecto a los historiales."))

    best_res = results[best_idx]
    y_pred_best = best_res.get("y_pred")
    with svr_best_out:
        plot_best_diagnostics(y_te, y_pred_best, title_prefix=f"SVR [{best_res.get('engine')}] best")
        m = best_res.get("metrics", {})
        diag_table = pd.DataFrame([{**m, "n_test": len(y_te)}])
        display(widgets.HTML(value="<i>Métricas del mejor modelo</i>"))
        display(diag_table)

    # Guardar en estado y persistir
    app.svr_optim_results = {
        "y_column": y_col,
        "segment_name": seg.get("name"),
        "X_used_columns": cols,
        "metric_selection": metric_key,
        "engines": results,
        "comparison_table": comp_df.to_dict(orient="records"),
    }
    persist_payload = {
        "y_column": y_col,
        "segment": seg.get("name"),
        "metric": metric_key,
        "comparison": comp_df.to_dict(orient="records"),
        "best_engine": best_res.get("engine"),
        "best_params": best_res.get("best_params", {}),
        "best_metrics": best_res.get("metrics", {}),
    }
    persist_results_for_comparison("SVR", persist_payload)

    prog.value = prog.max; prog.bar_style = 'success'; prog_label.value = 'HPO completado'
    with svr_alert:
        display(make_alert_html("Optimización finalizada.", level="success"))


btn_run_svr.on_click(on_run_svr)

svr_form = svr_controls
from typing import Any, Dict as _Dict, List as _List, Tuple as _Tuple
import numpy as np
import pandas as pd
from scipy.stats import loguniform
from sklearn.svm import SVR

# Aux: construir SVR con params

def build_svr_from_params(params: _Dict[str, Any]) -> "SVR":
    kernel = params.get("kernel", svr_kernel.value)
    kwargs: _Dict[str, Any] = {
        "kernel": kernel,
        "C": float(params.get("C", 1.0)),
        "epsilon": float(params.get("epsilon", 0.1)),
        "max_iter": int(max_iter_svr.value),
        "shrinking": bool(params.get("shrinking", True)),
        "tol": float(params.get("tol", 1e-3)),
    }
    gamma = params.get("gamma", None)
    if gamma is not None:
        kwargs["gamma"] = gamma
    if kernel == "poly":
        if "degree" in params:
            kwargs["degree"] = int(params["degree"])
        if "coef0" in params:
            kwargs["coef0"] = float(params["coef0"])
    return SVR(**kwargs)


def sklearn_cv_results_to_df(cv) -> "pd.DataFrame":
    try:
        df = pd.DataFrame(cv.cv_results_)
        cols = [c for c in df.columns if c.startswith("param_") or c in ("rank_test_score", "mean_test_score", "std_test_score")]
        return df[cols].sort_values("rank_test_score").reset_index(drop=True)
    except Exception:
        return pd.DataFrame()


def plot_sklearn_search_history(title: str, df: "pd.DataFrame"):
    if df.empty:
        return
    plt.figure(figsize=(8, 4))
    sns.lineplot(x=np.arange(len(df)), y=df["mean_test_score"].values, marker="o")
    plt.title(title + " — mean_test_score por candidato (ordenado)")
    plt.xlabel("Candidato (ordenado por rank)")
    plt.ylabel("mean_test_score")
    plt.tight_layout()
    plt.show()


def run_randomized_search(X_tr: np.ndarray, y_tr: np.ndarray, X_te: np.ndarray, y_te: np.ndarray, scoring_key: str) -> _Dict[str, Any]:
    seed = 42
    try:
        seed = int(svr_seed.value)  # type: ignore
    except Exception:
        pass
    kernel = svr_kernel.value
    param_distributions: _Dict[str, Any] = {
        "C": loguniform(float(C_min.value), float(C_max.value)),
        "epsilon": loguniform(float(eps_min.value), float(eps_max.value)),
    }
    if kernel in ("rbf", "sigmoid"):
        param_distributions["gamma"] = ["scale", "auto"]
    if kernel == "poly":
        param_distributions["degree"] = list(range(max(2, int(svr_degree.min)), int(svr_degree.max) + 1)) if hasattr(svr_degree, "max") else [2, 3, 4, 5, 6]
        param_distributions["coef0"] = list(np.round(np.linspace(-1.0, 1.0, 41), 3))
        param_distributions["gamma"] = ["scale", "auto"]
    # parámetros adicionales comunes
    param_distributions["tol"] = loguniform(1e-6, 1e-1)
    param_distributions["shrinking"] = [True, False]
    base = SVR(kernel=kernel, max_iter=int(max_iter_svr.value))
    X_all, y_all, cv = build_predefined_cv(X_tr, y_tr, X_te, y_te)
    rs = RandomizedSearchCV(
        estimator=base,
        param_distributions=param_distributions,
        n_iter=int(n_iter_random.value),
        scoring=scoring_key,
        n_jobs=-1,
        cv=cv,
        refit=False,
        random_state=seed,
        verbose=0,
        return_train_score=False,
    )
    rs.fit(X_all, y_all)
    best_params = {k.replace("param_", ""): v for k, v in rs.cv_results_.items() if k.startswith("param_")}
    # Obtener el mejor conjunto desde rs.best_index_
    try:
        idx = int(rs.best_index_)
        best_params = {k.replace("param_", ""): rs.cv_results_[k][idx] for k in rs.cv_results_ if k.startswith("param_")}
    except Exception:
        pass
    best_params = {k: (v.item() if hasattr(v, "item") else v) for k, v in best_params.items()}
    best_params["kernel"] = kernel
    # Reentrenar en Train únicamente con best_params
    model = build_svr_from_params(best_params)
    model.fit(X_tr, y_tr)
    y_pred = model.predict(X_te)
    metrics = compute_metrics(y_te, y_pred)
    hist_df = sklearn_cv_results_to_df(rs)
    return {"engine": "RandomizedSearchCV", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hist_df}


def run_halving_random_search(X_tr: np.ndarray, y_tr: np.ndarray, X_te: np.ndarray, y_te: np.ndarray, scoring_key: str) -> _Dict[str, Any]:
    if not HAS_HALVING:
        raise RuntimeError("HalvingRandomSearchCV no disponible en esta versión de sklearn.")
    seed = 42
    try:
        seed = int(svr_seed.value)  # type: ignore
    except Exception:
        pass
    kernel = svr_kernel.value
    param_distributions: _Dict[str, Any] = {
        "C": loguniform(float(C_min.value), float(C_max.value)),
        "epsilon": loguniform(float(eps_min.value), float(eps_max.value)),
    }
    if kernel in ("rbf", "sigmoid"):
        param_distributions["gamma"] = ["scale", "auto"]
    if kernel == "poly":
        param_distributions["degree"] = list(range(max(2, int(svr_degree.min)), int(svr_degree.max) + 1)) if hasattr(svr_degree, "max") else [2, 3, 4, 5, 6]
        param_distributions["coef0"] = list(np.round(np.linspace(-1.0, 1.0, 41), 3))
        param_distributions["gamma"] = ["scale", "auto"]
    # parámetros adicionales comunes
    param_distributions["tol"] = loguniform(1e-6, 1e-1)
    param_distributions["shrinking"] = [True, False]
    base = SVR(kernel=kernel, max_iter=int(max_iter_svr.value))
    X_all, y_all, cv = build_predefined_cv(X_tr, y_tr, X_te, y_te)
    min_res = min(int(halving_min_resources.value), len(y_tr))
    hrs = HalvingRandomSearchCV(
        estimator=base,
        param_distributions=param_distributions,
        factor=int(halving_factor.value),
        min_resources=min_res,
        scoring=scoring_key,
        n_jobs=-1,
        cv=cv,
        refit=False,
        random_state=seed,
        verbose=0,
        return_train_score=False,
    )
    hrs.fit(X_all, y_all)
    best_params = {k.replace("param_", ""): v for k, v in hrs.cv_results_.items() if k.startswith("param_")}
    try:
        idx = int(hrs.best_index_)
        best_params = {k.replace("param_", ""): hrs.cv_results_[k][idx] for k in hrs.cv_results_ if k.startswith("param_")}
    except Exception:
        pass
    best_params = {k: (v.item() if hasattr(v, "item") else v) for k, v in best_params.items()}
    best_params["kernel"] = kernel
    model = build_svr_from_params(best_params)
    model.fit(X_tr, y_tr)
    y_pred = model.predict(X_te)
    metrics = compute_metrics(y_te, y_pred)
    hist_df = sklearn_cv_results_to_df(hrs)
    return {"engine": "HalvingRandomSearchCV", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hist_df}


def run_skopt_bayes(X_tr: np.ndarray, y_tr: np.ndarray, X_te: np.ndarray, y_te: np.ndarray, scoring_key: str) -> _Dict[str, Any]:
    if not HAS_SKOPT:
        raise RuntimeError("scikit-optimize (skopt) no disponible.")
    kernel = svr_kernel.value
    space: _Dict[str, Any] = {
        "C": Real(float(C_min.value), float(C_max.value), prior="log-uniform"),
        "epsilon": Real(float(eps_min.value), float(eps_max.value), prior="log-uniform"),
    }
    if kernel in ("rbf", "sigmoid"):
        space["gamma"] = Categorical(["scale", "auto"])
    if kernel == "poly":
        space["degree"] = Integer(2, 8)
        space["coef0"] = Real(-1.0, 1.0)
        space["gamma"] = Categorical(["scale", "auto"])
    # parámetros adicionales comunes
    space["tol"] = Real(1e-6, 1e-1, prior="log-uniform")
    space["shrinking"] = Categorical([True, False])
    base = SVR(kernel=kernel, max_iter=int(max_iter_svr.value))
    X_all, y_all, cv = build_predefined_cv(X_tr, y_tr, X_te, y_te)
    seed = 42
    try:
        seed = int(svr_seed.value)  # type: ignore
    except Exception:
        pass
    opt = BayesSearchCV(
        estimator=base,
        search_spaces=space,
        n_iter=int(skopt_n_iter.value),
        scoring=scoring_key,
        cv=cv,
        refit=False,
        n_jobs=-1,
        random_state=seed,
        verbose=0,
    )
    opt.fit(X_all, y_all)
    best_params = opt.best_params_.copy()
    best_params["kernel"] = kernel
    model = build_svr_from_params(best_params)
    model.fit(X_tr, y_tr)
    y_pred = model.predict(X_te)
    metrics = compute_metrics(y_te, y_pred)
    hist_df = sklearn_cv_results_to_df(opt)
    return {"engine": "BayesSearchCV (skopt)", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hist_df}


def run_optuna(X_tr: np.ndarray, y_tr: np.ndarray, X_te: np.ndarray, y_te: np.ndarray, metric_key: str) -> _Dict[str, Any]:
    if not HAS_OPTUNA:
        raise RuntimeError("Optuna no disponible.")
    skey, maximize, metric_fn = metric_and_direction(metric_key)
    kernel = svr_kernel.value

    def objective(trial: "optuna.trial.Trial") -> float:
        C = trial.suggest_float("C", float(C_min.value), float(C_max.value), log=True)
        eps = trial.suggest_float("epsilon", float(eps_min.value), float(eps_max.value), log=True)
        params: _Dict[str, Any] = {"kernel": kernel, "C": C, "epsilon": eps}
        if kernel in ("rbf", "sigmoid"):
            params["gamma"] = trial.suggest_categorical("gamma", ["scale", "auto"])
        if kernel == "poly":
            params["degree"] = trial.suggest_int("degree", 2, 8)
            params["coef0"] = trial.suggest_float("coef0", -1.0, 1.0)
            params["gamma"] = trial.suggest_categorical("gamma", ["scale", "auto"])
        # parámetros adicionales comunes
        params["tol"] = trial.suggest_float("tol", 1e-6, 1e-1, log=True)
        params["shrinking"] = trial.suggest_categorical("shrinking", [True, False])
        model = build_svr_from_params(params)
        model.fit(X_tr, y_tr)
        y_pred = model.predict(X_te)
        score = metric_fn(y_te, y_pred)
        return score if maximize else float(score)

    study = optuna.create_study(direction="maximize" if metric_key == "R2" else "minimize")
    study.optimize(objective, n_trials=int(optuna_trials.value), show_progress_bar=False)
    best_params = study.best_trial.params.copy()
    best_params["kernel"] = kernel
    model = build_svr_from_params(best_params)
    model.fit(X_tr, y_tr)
    y_pred = model.predict(X_te)
    metrics = compute_metrics(y_te, y_pred)
    # Historial como df (plot uniforme lo hará on_run_svr)
    hist_df = pd.DataFrame({"value": [t.value for t in study.trials], "number": [t.number for t in study.trials]})
    return {"engine": "Optuna", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hist_df }


def run_hyperopt(X_tr: np.ndarray, y_tr: np.ndarray, X_te: np.ndarray, y_te: np.ndarray, metric_key: str) -> _Dict[str, Any]:
    if not HAS_HYPEROPT:
        raise RuntimeError("Hyperopt no disponible.")
    # Import defensivo por si la celda de imports no se ejecutó aún
    try:
        from hyperopt import hp, tpe, fmin, Trials, STATUS_OK
    except Exception as _e:
        raise RuntimeError(f"Hyperopt no disponible o import falló: {_e}")
    skey, maximize, metric_fn = metric_and_direction(metric_key)
    kernel = svr_kernel.value

    space: _Dict[str, Any] = {
        "C": hp.loguniform("C", np.log(float(C_min.value)), np.log(float(C_max.value))),
        "epsilon": hp.loguniform("epsilon", np.log(float(eps_min.value)), np.log(float(eps_max.value))),
    }
    if kernel in ("rbf", "sigmoid"):
        space["gamma"] = hp.choice("gamma", ["scale", "auto"])
    if kernel == "poly":
        space["degree"] = hp.quniform("degree", 2, 8, 1)
        space["coef0"] = hp.uniform("coef0", -1.0, 1.0)
        space["gamma"] = hp.choice("gamma", ["scale", "auto"])
    # parámetros adicionales comunes
    space["tol"] = hp.loguniform("tol", np.log(1e-6), np.log(1e-1))
    space["shrinking"] = hp.choice("shrinking", [True, False])

    def objective(params):
        params = params.copy()
        if "degree" in params:
            params["degree"] = int(params["degree"])  # quniform -> int
        params["kernel"] = kernel
        model = build_svr_from_params(params)
        model.fit(X_tr, y_tr)
        y_pred = model.predict(X_te)
        score = metric_fn(y_te, y_pred)
        loss = -float(score) if metric_key == "R2" else float(score)
        return {"loss": loss, "status": STATUS_OK}

    trials = Trials()
    seed = 42
    try:
        seed = int(svr_seed.value)  # type: ignore
    except Exception:
        pass
    # Usar Generator en lugar de RandomState para compatibilidad
    rng = np.random.default_rng(seed)
    best = fmin(
        fn=objective,
        space=space,
        algo=tpe.suggest,
        max_evals=int(hyperopt_evals.value),
        rstate=rng,
        trials=trials,
        verbose=False,
    )
    # Decodificar best con space_eval para choices
    try:
        from hyperopt import space_eval
        best_params = space_eval(space, best)
    except Exception:
        best_params = {**best}
        if kernel == "poly" and "degree" in best_params:
            best_params["degree"] = int(best_params["degree"])  # already int
    best_params["kernel"] = kernel
    model = build_svr_from_params(best_params)
    model.fit(X_tr, y_tr)
    y_pred = model.predict(X_te)
    metrics = compute_metrics(y_te, y_pred)
    # Historial (plot uniforme lo hará on_run_svr)
    vals = []
    for i, tr in enumerate(trials.trials):
        res = tr.get("result", {})
        vals.append({"iter": i + 1, "loss": res.get("loss", np.nan)})
    hist_df = pd.DataFrame(vals)
    return {"engine": "Hyperopt", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hist_df}

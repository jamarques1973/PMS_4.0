    + "<p>La explicabilidad (xIA) de modelos de redes neuronales en datos tabulares requiere combinar varias perspectivas complementarias. A nivel local, deseamos entender por qué una predicción concreta tomó cierto valor: qué variables impulsaron al alza o a la baja y en qué magnitud. Para ello empleamos <b>SHAP</b> (DeepExplainer), que descompone cada predicción en contribuciones aditivas por característica basadas en valores de Shapley, y <b>Integrated Gradients</b> (IG), que integra gradientes a lo largo de una trayectoria desde un baseline hasta el punto de interés. SHAP ofrece una lectura coherente con juegos cooperativos, y la suma de contribuciones más el valor base recupera la predicción; IG aporta robustez cuando DeepExplainer no es viable o como contraste. La consistencia entre ambos refuerza la confianza en la explicación.</p>"
    + "<p>Para una visión global (sobre el conjunto), utilizamos <b>Permutation Importance</b>, que mide la caída en desempeño (p. ej. ΔR2) al permutar una característica rompiendo su relación con la respuesta, y <b>SAGE</b>, que extiende la lógica de Shapley a la reducción de pérdida esperada para atribuir la ganancia marginal promedio de cada variable teniendo en cuenta redundancias e interacciones. Permutation es simple y modelo-agnóstico; SAGE, aunque más costoso, produce importancias globales coherentes con la métrica objetivo. Las discrepancias entre ambas medidas suelen indicar interacciones o colinealidad y sugieren profundizar con efectos marginales.</p>"
    + "<p>Para estudiar <i>cómo</i> cambia la predicción al variar una variable manteniendo las demás en su distribución, recurrimos a <b>PDP</b> (Partial Dependence Plots) e <b>ALE</b> (Accumulated Local Effects). PDP es intuitivo pero puede extrapolar a regiones sin datos; ALE corrige sesgos al integrar efectos locales por intervalos con soporte, ofreciendo curvas más fiables. Complementamos con <b>ICE</b> (Individual Conditional Expectation) para visualizar heterogeneidad entre observaciones: abanicos y cruces revelan interacciones. En la práctica, use ALE como referencia principal y PDP/ICE para enriquecer la lectura y detectar no linealidades e interacciones.</p>"
    + "<p>Finalmente, para análisis inverso, <b>DiCE</b> genera <i>contraejemplos</i> que sugieren cambios mínimos y factibles en variables seleccionadas para llevar la predicción a un objetivo. Resulta útil para diseñar acciones y evaluar impacto potencial. Como buenas prácticas: (1) elija muestras de fondo/baseline representativas para SHAP/IG; (2) contraste locales (SHAP/IG) con globales (Permutation/SAGE); (3) valide con ALE/PDP/ICE que la dirección de efecto concuerda; (4) use contraejemplos para explorar escenarios y documentar decisiones; (5) combine estas lecturas con diagnósticos de residuos y métricas para una imagen completa de desempeño y explicabilidad.</p>"
    + "</div>"
))

xai_nn_form = widgets.VBox([
    widgets.HTML(value="<h3 style='margin:6px 0'>xIA NN (Explicabilidad del mejor NN)</h3>"),
    xai_help,
    widgets.HBox([xai_samples, perm_repeats, ig_steps, btn_run_xai_nn], layout=widgets.Layout(gap="12px", flex_flow="row wrap")),
    xai_nn_progress,
    xai_nn_alert,
    widgets.HTML(value="<b>Locales (SHAP / IG)</b>"), xai_nn_locals_out,
    widgets.HTML(value="<b>Globales (Permutation / SAGE)</b>"), xai_nn_globals_out,
    widgets.HTML(value="<b>Efectos (PDP/ALE/ICE)</b>"), xai_nn_effects_out,
    widgets.HTML(value="<b>Contrafactuales (DiCE)</b>"), xai_nn_cf_out,
])


def _get_best_nn_and_data():
    if not hasattr(app, 'nn_optim_results') or not app.nn_optim_results:  # type: ignore
        raise RuntimeError("Ejecute NN (HPO) primero.")
    res = app.nn_optim_results  # type: ignore
    y_col = res.get('y_column'); seg_name = res.get('segment_name')
    if y_col is None or app.X is None or app.Y is None:  # type: ignore
        raise RuntimeError("Cargue datos y seleccione Y.")
    seg = next((s for s in app.segments if s.get('name') == seg_name), app.segments[0])  # type: ignore
    X_tr, y_tr, X_te, y_te, cols, _, _ = prepare_train_test(app.X, app.Y[y_col], seg, True, True, False)  # type: ignore
    params = res.get('best_params', {})
    model = build_dense_model(X_tr.shape[1], params)
    es = keras.callbacks.EarlyStopping(monitor='val_loss', patience=int(params.get('patience', 10)), restore_best_weights=True)
    model.fit(X_tr, y_tr, validation_data=(X_te, y_te), epochs=int(params.get('epochs', 100)), batch_size=int(params.get('batch_size', 64)), callbacks=[es], verbose=0)
    return model, X_tr, y_tr, X_te, y_te, cols


def on_run_xai_nn(_):
    xai_nn_alert.clear_output(); xai_nn_progress.clear_output(); xai_nn_locals_out.clear_output(); xai_nn_globals_out.clear_output(); xai_nn_effects_out.clear_output(); xai_nn_cf_out.clear_output()
    prog = widgets.IntProgress(value=0, min=0, max=6, description='xIA', bar_style='info'); prog_label = widgets.HTML(value='Preparando...')
    with xai_nn_progress: _display(widgets.VBox([prog_label, prog]))
    try:
        model, X_tr, y_tr, X_te, y_te, cols = _get_best_nn_and_data()
    except Exception as e:
        with xai_nn_alert: _display(_HTML(str(e))); return

    # Local: SHAP DeepExplainer
    try:
        if HAS_SHAP:
            prog_label.value = 'SHAP DeepExplainer...'; prog.value += 1
            bg_idx = np.random.choice(np.arange(X_tr.shape[0]), size=min(int(xai_samples.value), X_tr.shape[0]), replace=False)
            background = X_tr[bg_idx]
            explainer = shap.DeepExplainer(model, background)
            idx = np.random.choice(np.arange(X_te.shape[0]), size=min(int(xai_samples.value), X_te.shape[0]), replace=False)
            shap_values = explainer.shap_values(X_te[idx])[0]
            with xai_nn_locals_out:
                plt.figure(figsize=(8,4)); shap.summary_plot(shap_values, X_te[idx], feature_names=cols, show=False); plt.tight_layout(); plt.show()
        else:
            with xai_nn_locals_out: _display(_HTML("SHAP no disponible."))
    except Exception as e:
        with xai_nn_locals_out: _display(_HTML(f"Error SHAP: {e}"))

    # Local: Integrated Gradients
    try:
        if HAS_TFKVIS:
            prog_label.value = 'Integrated Gradients...'; prog.value += 1
            ig = IntegratedGradients(model)
            idx0 = np.random.randint(0, X_te.shape[0]); baseline = np.zeros_like(X_te[idx0])
            attributions = ig.explain(X_te[idx0:idx0+1], out_layer=model.output, steps=int(ig_steps.value), baselines=baseline)
            with xai_nn_locals_out:
                plt.figure(figsize=(8,3)); plt.bar(range(len(cols)), attributions[0]); plt.xticks(range(len(cols)), cols, rotation=90); plt.title('Integrated Gradients (ejemplo)'); plt.tight_layout(); plt.show()
        else:
            with xai_nn_locals_out: _display(_HTML("Integrated Gradients no disponible."))
    except Exception as e:
        with xai_nn_locals_out: _display(_HTML(f"Error IG: {e}"))

    # Global: Permutation Importance (ΔR2)
    try:
        prog_label.value = 'Permutation Importance...'; prog.value += 1
        baseline_pred = model.predict(X_te, verbose=0).ravel(); base_metrics = compute_metrics(y_te, baseline_pred)  # type: ignore
        drops = []
        rng = np.random.default_rng(42)
        for j, name in enumerate(cols):
            vals = []
            for _ in range(int(perm_repeats.value)):
                X_perm = X_te.copy(); rng.shuffle(X_perm[:, j])
                yp = model.predict(X_perm, verbose=0).ravel()
                m = compute_metrics(y_te, yp)  # type: ignore
                vals.append(m['r2'])
            drops.append({'feature': name, 'delta_r2': base_metrics['r2'] - float(np.mean(vals))})
        perm_df = pd.DataFrame(drops).sort_values('delta_r2', ascending=False)
        with xai_nn_globals_out:
            show_df(perm_df, caption="Permutation Importance (ΔR2)", max_height=400, font_px=12)
    except Exception as e:
        with xai_nn_globals_out: _display(_HTML(f"Error Permutation: {e}"))

    # Global: SAGE
    try:
        if HAS_SAGE:
            prog_label.value = 'SAGE...'; prog.value += 1
            imputer = sage.MarginalImputer(model.predict, X_tr[:min(1000, len(X_tr))])
            estimator = sage.PermutationEstimator(imputer, loss='mse')
            sage_values = estimator(X_te[:min(1000, len(X_te))], y_te[:min(1000, len(y_te))])
            sv = pd.DataFrame({'feature': cols, 'sage': sage_values.values})
            with xai_nn_globals_out: show_df(sv.sort_values('sage', ascending=False), caption="SAGE", max_height=400, font_px=12)
        else:
            with xai_nn_globals_out: _display(_HTML("SAGE no disponible."))
    except Exception as e:
        with xai_nn_globals_out: _display(_HTML(f"Error SAGE: {e}"))

    # Efectos PDP/ALE (univariantes para top4 por Permutation)
    try:
        prog_label.value = 'Efectos PDP/ALE...'; prog.value += 1
        top_feats = perm_df['feature'].head(4).tolist() if 'perm_df' in locals() and not perm_df.empty else cols[:4]
        with xai_nn_effects_out:
            fig, axes = plt.subplots(len(top_feats), 2, figsize=(10, 3.4*len(top_feats)))
            for i, f in enumerate(top_feats):
                j = cols.index(f); grid = np.linspace(np.percentile(X_te[:, j], 5), np.percentile(X_te[:, j], 95), 25)
                # PDP-like
                pdp_vals = []
                for v in grid:
                    X_tmp = X_te.copy(); X_tmp[:, j] = v; pdp_vals.append(model.predict(X_tmp, verbose=0).ravel().mean())
                axes[i,0].plot(grid, pdp_vals); axes[i,0].set_title(f"PDP {f}"); axes[i,0].set_xlabel(f); axes[i,0].set_ylabel('pred')
                # ALE-like
                bins = np.quantile(X_te[:, j], np.linspace(0,1,11))
                ale_x = []; ale_y = []
                for b0, b1 in zip(bins[:-1], bins[1:]):
                    mask = (X_te[:, j] >= b0) & (X_te[:, j] < b1)
                    if not np.any(mask):
                        continue
                    x_mid = 0.5*(b0+b1)
                    X_low = X_te.copy(); X_high = X_te.copy(); X_low[:, j] = b0; X_high[:, j] = b1
                    eff = model.predict(X_high, verbose=0).ravel() - model.predict(X_low, verbose=0).ravel()
                    ale_x.append(x_mid); ale_y.append(np.mean(eff))
                if ale_x:
                    cum = np.cumsum(ale_y); axes[i,1].plot(ale_x, cum - np.mean(cum))
                axes[i,1].set_title(f"ALE {f}"); axes[i,1].set_xlabel(f); axes[i,1].set_ylabel('effect')
            plt.tight_layout(); plt.show()
    except Exception as e:
        with xai_nn_effects_out: _display(_HTML(f"Error efectos: {e}"))

    # DiCE contraejemplos
    try:
        if HAS_DICE:
            prog_label.value = 'DiCE...'; prog.value += 1
            d = dice_ml.Data(dataframe=pd.DataFrame(X_tr, columns=cols).assign(y=y_tr), continuous_features=cols, outcome_name='y')
            m = dice_ml.Model(model=model, backend='TF')
            exp = dice_ml.Dice(d, m, method='random')
            sample_df = pd.DataFrame(X_te[:1], columns=cols); target = float(np.median(y_te))
            cf = exp.generate_counterfactuals(sample_df, total_CFs=3, desired_range=[target, target])
            with xai_nn_cf_out: _display(_HTML(cf.to_html()))
        else:
            with xai_nn_cf_out: _display(_HTML("DiCE no disponible."))
    except Exception as e:
        with xai_nn_cf_out: _display(_HTML(f"Error DiCE: {e}"))

btn_run_xai_nn.on_click(on_run_xai_nn)# NN HPO UI (controles, ejecución y visualización)

# Override de _fit_eval_nn para usar controles de entrenamiento
try:
    del _fit_eval_nn
except Exception:
    pass

def _fit_eval_nn(X_tr, y_tr, X_te, y_te, params: dict, seed: int = 42):
    if not HAS_TF:
        raise RuntimeError("TensorFlow no disponible")
    tf.keras.utils.set_random_seed(seed)
    model = build_dense_model(X_tr.shape[1], params)
    batch_size = int(getattr(nn_train_batch, 'value', 64))
    epochs = int(getattr(nn_train_epochs, 'value', 120))
    patience = int(getattr(nn_train_patience, 'value', 12))
    es = keras.callbacks.EarlyStopping(monitor='val_loss', patience=patience, restore_best_weights=True, verbose=0)
    hist = model.fit(X_tr, y_tr, validation_data=(X_te, y_te), batch_size=batch_size, epochs=epochs, verbose=0, callbacks=[es])
    y_pred = model.predict(X_te, verbose=0).ravel()
    try:
        metrics = compute_metrics(y_te, y_pred)  # type: ignore
    except Exception:
        mse = mean_squared_error(y_te, y_pred); rmse = float(math.sqrt(mse)); mae = float(mean_absolute_error(y_te, y_pred)); r2 = float(r2_score(y_te, y_pred))
        metrics = {"r2": r2, "rmse": rmse, "mse": float(mse), "mae": mae}
    return model, metrics, y_pred, hist

# Overrides HPO: sin batch_size/epochs en espacios
from scipy.stats import randint as sp_randint, uniform as sp_uniform

def run_nn_randomized_search(X_tr, y_tr, X_te, y_te, scoring_key: str, n_iter: int, rng_seed: int = 42):
    if not (HAS_TF and HAS_SCIKERAS):
        raise RuntimeError("Requiere TensorFlow y scikeras")
    sp = default_nn_space()
    param_distributions = {
        'model__n_layers': sp_randint(sp['n_layers'][0], sp['n_layers'][1] + 1),
        'model__units': sp_randint(sp['units'][0], sp['units'][1] + 1),
        'model__activation': sp['activation'],
        'model__dropout': sp_uniform(sp['dropout'][0], sp['dropout'][1] - sp['dropout'][0]),
        'model__batch_norm': sp['batch_norm'],
        'model__learning_rate': loguniform(sp['learning_rate'][0], sp['learning_rate'][1]),
        'model__optimizer': sp['optimizer'],
    }
    base = KerasRegressor(model=build_dense_model, input_dim=X_tr.shape[1], verbose=0)
    X_all, y_all, cv = _build_cv_for_test(X_tr, y_tr, X_te, y_te)
    rs = RandomizedSearchCV(estimator=base, param_distributions=param_distributions, n_iter=int(n_iter), scoring=scoring_key, n_jobs=1, cv=cv, refit=False, random_state=rng_seed, verbose=0, return_train_score=False)
    rs.fit(X_all, y_all)
    try:
        idx = int(rs.best_index_)
        best_params = {k.replace('param_', '').replace('model__', ''): rs.cv_results_[k][idx] for k in rs.cv_results_ if k.startswith('param_')}
    except Exception:
        best_params = {}
    # coerce simple
    bp = {}
    for k, v in best_params.items():
        bp[k] = int(v) if hasattr(v, 'item') else v
    model, metrics, y_pred, hist = _fit_eval_nn(X_tr, y_tr, X_te, y_te, bp, seed=rng_seed)
    hist_df = pd.DataFrame({'epoch': np.arange(len(hist.history.get('loss', []))), 'loss': hist.history.get('loss', []), 'val_loss': hist.history.get('val_loss', [])})
    return {"engine": "RandomizedSearchCV", "best_params": bp, "y_pred": y_pred, "metrics": metrics, "history": hist_df}


def run_nn_halving_random(X_tr, y_tr, X_te, y_te, scoring_key: str, min_resources: int = 20, factor: int = 3, rng_seed: int = 42):
    if not (HAS_TF and HAS_SCIKERAS and HAS_HALVING):
        raise RuntimeError("Requiere TensorFlow, scikeras y HalvingRandomSearchCV")
    sp = default_nn_space()
    param_distributions = {
        'model__n_layers': sp_randint(sp['n_layers'][0], sp['n_layers'][1] + 1),
        'model__units': sp_randint(sp['units'][0], sp['units'][1] + 1),
        'model__activation': sp['activation'],
        'model__dropout': sp_uniform(sp['dropout'][0], sp['dropout'][1] - sp['dropout'][0]),
        'model__batch_norm': sp['batch_norm'],
        'model__learning_rate': loguniform(sp['learning_rate'][0], sp['learning_rate'][1]),
        'model__optimizer': sp['optimizer'],
    }
    base = KerasRegressor(model=build_dense_model, input_dim=X_tr.shape[1], verbose=0)
    X_all, y_all, cv = _build_cv_for_test(X_tr, y_tr, X_te, y_te)
    hrs = HalvingRandomSearchCV(estimator=base, param_distributions=param_distributions, factor=int(factor), min_resources=int(min_resources), scoring=scoring_key, cv=cv, random_state=rng_seed, refit=False, verbose=0, n_candidates="exhaust")
    hrs.fit(X_all, y_all)
    try:
        idx = int(hrs.best_index_)
        best_params = {k.replace('param_', '').replace('model__', ''): hrs.cv_results_[k][idx] for k in hrs.cv_results_ if k.startswith('param_')}
    except Exception:
        best_params = {}
    model, metrics, y_pred, hist = _fit_eval_nn(X_tr, y_tr, X_te, y_te, best_params, seed=rng_seed)
    hist_df = pd.DataFrame({'candidate': np.arange(len(hrs.cv_results_.get('mean_test_score', []))), 'mean_test_score': hrs.cv_results_.get('mean_test_score', [])})
    return {"engine": "HalvingRandomSearchCV", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hist_df}


def run_nn_skopt(X_tr, y_tr, X_te, y_te, scoring_key: str, n_iter: int, rng_seed: int = 42):
    if not (HAS_SCIKERAS and HAS_SKOPT):
        raise RuntimeError("skopt no disponible o scikeras ausente")
    from skopt import BayesSearchCV
    from skopt.space import Real, Integer, Categorical
    sp = default_nn_space()
    base = KerasRegressor(model=build_dense_model, input_dim=X_tr.shape[1], verbose=0)
    search_spaces = {
        'model__n_layers': Integer(sp['n_layers'][0], sp['n_layers'][1]),
        'model__units': Integer(sp['units'][0], sp['units'][1]),
        'model__activation': Categorical(sp['activation']),
        'model__dropout': Real(sp['dropout'][0], sp['dropout'][1]),
        'model__batch_norm': Categorical(sp['batch_norm']),
        'model__learning_rate': Real(sp['learning_rate'][0], sp['learning_rate'][1], prior='log-uniform'),
        'model__optimizer': Categorical(sp['optimizer']),
    }
    X_all, y_all, cv = _build_cv_for_test(X_tr, y_tr, X_te, y_te)
    opt = BayesSearchCV(estimator=base, search_spaces=search_spaces, n_iter=int(n_iter), scoring=scoring_key, cv=cv, n_jobs=1, refit=False, random_state=rng_seed, verbose=0, return_train_score=False)
    opt.fit(X_all, y_all)
    try:
        idx = int(opt.best_index_)
        best_params = {k.replace('param_', '').replace('model__', ''): opt.cv_results_[k][idx] for k in opt.cv_results_ if k.startswith('param_')}
    except Exception:
        best_params = {}
    model, metrics, y_pred, hist = _fit_eval_nn(X_tr, y_tr, X_te, y_te, best_params, seed=rng_seed)
    hdf = pd.DataFrame(opt.cv_results_)
    return {"engine": "BayesSearchCV (skopt)", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": hdf}# Override handlers to include per-engine progress (time + counters)
import ipywidgets as widgets
from IPython.display import display as _display, HTML as _HTML

def on_run_nn(_):
    try:
        nn_alert.clear_output(); nn_histories_out.clear_output(); nn_tables_out.clear_output(); nn_best_out.clear_output(); nn_progress_out.clear_output()
    except Exception:
        pass
    header, cont = make_engine_panels("Progreso motores (NN)")
    with nn_progress_out:
        _display(widgets.VBox([header, cont]))
    # Validaciones
    if 'app' not in globals() or app.X is None or app.Y is None:  # type: ignore
        with nn_alert: _display(_HTML("<i>Cargue X e Y antes de optimizar.</i>")); return
    y_col = None
    if 'sel_y_col' in globals() and sel_y_col.value is not None: y_col = sel_y_col.value
    elif 'y_col_dropdown' in globals() and y_col_dropdown.value is not None: y_col = y_col_dropdown.value
    if y_col is None:
        with nn_alert: _display(_HTML("<i>Seleccione una columna Y.</i>")); return
    if not getattr(app, 'segments', []):  # type: ignore
        with nn_alert: _display(_HTML("<i>Genere la segmentación (Train/Test).</i>")); return
    seg = app.segments[0]  # type: ignore
    X_tr, y_tr, X_te, y_te, cols, _, _ = prepare_train_test(app.X, app.Y[y_col], seg, bool(nn_use_selected_chk.value), bool(nn_scale_x_chk.value), bool(nn_scale_y_chk.value))  # type: ignore
    skey, _, _ = metric_and_direction(nn_metric_dropdown.value)

    # Ensure packages if needed
    need = (run_nn_optuna_chk.value and not HAS_OPTUNA) or (run_nn_hyperopt_chk.value and not HAS_HYPEROPT) or (run_nn_skopt_chk.value and not HAS_SKOPT) or (run_nn_kt_chk.value and not HAS_KT) or (not HAS_TF) or (not HAS_SCIKERAS)
    if need:
        ensure_nn_packages(progress=nn_alert)

    results = []; history_items = []

    # Randomized
    if run_nn_random_chk.value and HAS_TF and HAS_SCIKERAS:
        st = EngineStatus("RandomizedSearch", total=int(nn_n_iter_random.value))
        cont.children = tuple(list(cont.children) + [st.box])
        try:
            res = run_nn_randomized_search(X_tr, y_tr, X_te, y_te, scoring_key=skey, n_iter=int(nn_n_iter_random.value), rng_seed=int(nn_seed.value))
            st.update(current=int(nn_n_iter_random.value))
            st.finish(final_message="completado")
            results.append(res)
            h = res.get('history', pd.DataFrame())
            if isinstance(h, pd.DataFrame) and not h.empty and {'epoch','val_loss'}.issubset(set(h.columns)):
                history_items.append(("RandomizedSearchCV", h['epoch'].values, h['val_loss'].values, 'val_loss'))
        except Exception as e:
            st.finish(success=False, final_message=f"error: {e}")
            with nn_alert: _display(_HTML(f"<i>Error RandomizedSearchCV:</i> {e}"))

    # Halving
    if run_nn_halving_chk.value and HAS_HALVING and HAS_TF and HAS_SCIKERAS:
        st = EngineStatus("HalvingRandomSearch")
        cont.children = tuple(list(cont.children) + [st.box])
        try:
            res = run_nn_halving_random(X_tr, y_tr, X_te, y_te, scoring_key=skey, min_resources=int(nn_halving_min_res.value), factor=int(nn_halving_factor.value), rng_seed=int(nn_seed.value))
            st.finish(final_message="completado")
            results.append(res)
            h = res.get('history', pd.DataFrame())
            if isinstance(h, pd.DataFrame) and not h.empty and 'mean_test_score' in h.columns:
                history_items.append(("HalvingRandomSearchCV", np.arange(len(h)), h['mean_test_score'].values, 'score'))
        except Exception as e:
            st.finish(success=False, final_message=f"error: {e}")
            with nn_alert: _display(_HTML(f"<i>Error Halving:</i> {e}"))

    # Optuna with callback
    if run_nn_optuna_chk.value and HAS_OPTUNA:
        st = EngineStatus("Optuna", total=int(nn_optuna_trials.value))
        cont.children = tuple(list(cont.children) + [st.box])
        try:
            def _optuna_cb(study, trial):
                cur = trial.number + 1
                st.update(current=cur, total=int(nn_optuna_trials.value), message=f"trial {cur}/{int(nn_optuna_trials.value)} — best: {study.best_value:.5f}")
            # override local run to add callback
            import optuna as _opt
            maximize = (nn_metric_dropdown.value == 'R2')
            sp = default_nn_space()
            def objective(trial):
                params = {
                    'n_layers': trial.suggest_int('n_layers', sp['n_layers'][0], sp['n_layers'][1]),
                    'units': trial.suggest_int('units', sp['units'][0], sp['units'][1]),
                    'activation': trial.suggest_categorical('activation', sp['activation']),
                    'dropout': trial.suggest_float('dropout', sp['dropout'][0], sp['dropout'][1]),
                    'batch_norm': trial.suggest_categorical('batch_norm', sp['batch_norm']),
                    'learning_rate': trial.suggest_float('learning_rate', sp['learning_rate'][0], sp['learning_rate'][1], log=True),
                    'optimizer': trial.suggest_categorical('optimizer', sp['optimizer']),
                    'batch_size': trial.suggest_int('batch_size', 16, 512),
                    'epochs': trial.suggest_int('epochs', 40, 500),
                }
                _, metrics, _, _ = _fit_eval_nn(X_tr, y_tr, X_te, y_te, params, seed=int(nn_seed.value))
                return metrics.get('r2') if maximize else metrics.get('rmse')
            study = _opt.create_study(direction='maximize' if maximize else 'minimize')
            study.optimize(objective, n_trials=int(nn_optuna_trials.value), show_progress_bar=False, callbacks=[_optuna_cb])
            best_params = study.best_trial.params.copy()
            model, metrics, y_pred, hist = _fit_eval_nn(X_tr, y_tr, X_te, y_te, best_params, seed=int(nn_seed.value))
            st.finish(final_message="completado")
            results.append({"engine":"Optuna", "best_params": best_params, "y_pred": y_pred, "metrics": metrics, "history": pd.DataFrame([{'number': t.number, 'value': t.value} for t in study.trials])})
        except Exception as e:
            st.finish(success=False, final_message=f"error: {e}")
            with nn_alert: _display(_HTML(f"<i>Error Optuna:</i> {e}"))

    # Hyperopt
    if run_nn_hyperopt_chk.value and HAS_HYPEROPT:
        st = EngineStatus("Hyperopt", total=int(nn_hyperopt_evals.value))
        cont.children = tuple(list(cont.children) + [st.box])
        try:
            res = run_nn_hyperopt(X_tr, y_tr, X_te, y_te, metric_key=nn_metric_dropdown.value, max_evals=int(nn_hyperopt_evals.value), rng_seed=int(nn_seed.value))
            st.update(current=int(nn_hyperopt_evals.value))
            st.finish(final_message="completado")
            results.append(res)
            h = res.get('history', pd.DataFrame())
            if isinstance(h, pd.DataFrame) and not h.empty and {'iter','value'}.issubset(set(h.columns)):
                history_items.append(("Hyperopt", h['iter'].values, h['value'].values, 'valor objetivo'))
        except Exception as e:
            st.finish(success=False, final_message=f"error: {e}")
            with nn_alert: _display(_HTML(f"<i>Error Hyperopt:</i> {e}"))

    # skopt
    if run_nn_skopt_chk.value and HAS_SKOPT and HAS_SCIKERAS:
        st = EngineStatus("skopt", total=int(nn_skopt_n_iter.value))
        cont.children = tuple(list(cont.children) + [st.box])
        try:
            res = run_nn_skopt(X_tr, y_tr, X_te, y_te, scoring_key=skey, n_iter=int(nn_skopt_n_iter.value), rng_seed=int(nn_seed.value))
            st.update(current=int(nn_skopt_n_iter.value))
            st.finish(final_message="completado")
            results.append(res)
            h = res.get('history', pd.DataFrame())
            if isinstance(h, pd.DataFrame) and not h.empty and 'mean_test_score' in h.columns:
                history_items.append(("BayesSearchCV (skopt)", np.arange(len(h)), h['mean_test_score'].values, 'score'))
        except Exception as e:
            st.finish(success=False, final_message=f"error: {e}")
            with nn_alert: _display(_HTML(f"<i>Error skopt:</i> {e}"))

    # KerasTuner
    if run_nn_kt_chk.value and HAS_KT:
        st = EngineStatus("KerasTuner", total=int(nn_n_iter_random.value))
        cont.children = tuple(list(cont.children) + [st.box])
        try:
            res = run_nn_kerastuner(X_tr, y_tr, X_te, y_te, metric_key=nn_metric_dropdown.value, max_trials=int(nn_n_iter_random.value), rng_seed=int(nn_seed.value))
            st.update(current=int(nn_n_iter_random.value))
            st.finish(final_message="completado")
            results.append(res)
            h = res.get('history', pd.DataFrame())
            if isinstance(h, pd.DataFrame) and not h.empty:
                yy = h['val_loss'].values if 'val_loss' in h.columns else h.iloc[:, -1].values
                history_items.append(("KerasTuner", np.arange(len(yy)), yy, 'val_loss'))
        except Exception as e:
            st.finish(success=False, final_message=f"error: {e}")
            with nn_alert: _display(_HTML(f"<i>Error KerasTuner:</i> {e}"))

    # Resto igual a definición previa: historia/tabla/diag/persistencia
    if not results:
        with nn_alert: _display(_HTML("<i>Seleccione y ejecute al menos un motor.</i>")); return
    if history_items:
        with nn_histories_out:
            _plot_histories_grid(history_items)
            _display(_HTML("<div style='max-width:900px;text-align:justify'><p>Interpretación: observe tendencias, estabilidad y margen de mejora; contraste motores.</p></div>"))
    metric_key = nn_metric_dropdown.value
    comp_rows = []; hp_rows = []
    for res in results:
        comp_rows.append({'engine': res.get('engine'), **res.get('metrics', {})})
        hp_rows.append({'engine': res.get('engine'), **res.get('best_params', {})})
    comp_df = pd.DataFrame(comp_rows)
    if metric_key == 'R2': best_idx = int(comp_df['r2'].idxmax())
    elif metric_key == 'RMSE': best_idx = int(comp_df['rmse'].idxmin())
    elif metric_key == 'MSE': best_idx = int(comp_df['mse'].idxmin())
    elif metric_key == 'MAE': best_idx = int(comp_df['mae'].idxmin())
    else: best_idx = int(comp_df['r2'].idxmax())
    comp_df['is_best'] = False; comp_df.loc[best_idx, 'is_best'] = True
    with nn_tables_out:
        _display(_HTML("<i>Función objetivo seleccionada:</i> " + metric_key))
        show_df(comp_df, caption="Tabla comparativa de motores", max_height=400, font_px=12)
        _display(_HTML("<i>Hiperparámetros óptimos por motor</i>"))
        show_df(pd.DataFrame(hp_rows).fillna(""), caption="Hiperparámetros óptimos por motor", max_height=400, font_px=12)
    best_res = results[best_idx]
    y_pred_best = best_res.get('y_pred')
    with nn_best_out:
        plot_best_diagnostics(y_te, y_pred_best, title_prefix=f"NN [{best_res.get('engine')}] best")
        diag_table = pd.DataFrame([{**best_res.get('metrics', {}), 'n_test': len(y_te)}]); _display(diag_table)
    try:
        persist_results_for_comparison("NN", {'y_column': y_col,'segment_name': seg.get('name'),'metric_key': metric_key,'engines': [r.get('engine') for r in results],'comp': comp_df.to_dict(orient='list'),'best_engine': best_res.get('engine'),'best_params': best_res.get('best_params'),'best_metrics': best_res.get('metrics')})
    except Exception:
        pass
    with nn_alert: _display(_HTML("<b>Optimización NN finalizada.</b>"))

try:
    btn_run_nn.on_click(on_run_nn)
except Exception:
    pass


def on_run_svr(_):
    try:
        svr_alert.clear_output(); svr_histories_out.clear_output(); svr_tables_out.clear_output(); svr_best_out.clear_output(); svr_progress_out.clear_output()
    except Exception:
        pass
    header, cont = make_engine_panels("Progreso motores (SVR)")
    with svr_progress_out:
        _display(widgets.VBox([header, cont]))
    if app.X is None or app.Y is None:
        with svr_alert: _display(_HTML("<i>Cargue X e Y antes de optimizar.</i>")); return
    y_col = None
    if 'sel_y_col' in globals() and sel_y_col.value is not None: y_col = sel_y_col.value
    elif 'y_col_dropdown' in globals() and y_col_dropdown.value is not None: y_col = y_col_dropdown.value
    if y_col is None:
        with svr_alert: _display(_HTML("<i>Seleccione una columna Y.</i>")); return
    if not app.segments:
        with svr_alert: _display(_HTML("<i>Genere la segmentación (Train/Test).</i>")); return
    seg = app.segments[0]
    X_tr, y_tr, X_te, y_te, cols, _, _ = prepare_train_test(app.X, app.Y[y_col], seg, use_selected_chk.value, scale_x_chk.value, scale_y_chk.value)
    skey, _, _ = metric_and_direction(metric_dropdown.value)

    results = []; history_items = []

    # RandomizedSearchCV
    if run_random_chk.value:
        st = EngineStatus("RandomizedSearch")
        cont.children = tuple(list(cont.children) + [st.box])
        try:
            res = run_randomized_search(X_tr, y_tr, X_te, y_te, scoring_key=skey)
            st.finish(final_message="completado")
            results.append(res)
            hdf = res.get("history", pd.DataFrame())
            if not hdf.empty and "mean_test_score" in hdf.columns:
                history_items.append(("RandomizedSearchCV", np.arange(len(hdf)), hdf["mean_test_score"], "score"))
        except Exception as e:
            st.finish(success=False, final_message=f"error: {e}")
            with svr_alert: _display(_HTML(f"<i>Error RandomizedSearchCV:</i> {e}"))

    # HalvingRandomSearchCV
    if run_halving_chk.value and HAS_HALVING:
        st = EngineStatus("HalvingRandomSearch")
        cont.children = tuple(list(cont.children) + [st.box])
        try:
            res = run_halving_random_search(X_tr, y_tr, X_te, y_te, scoring_key=skey)
            st.finish(final_message="completado")
            results.append(res)
            hdf = res.get("history", pd.DataFrame())
            if not hdf.empty and "mean_test_score" in hdf.columns:
                history_items.append(("HalvingRandomSearchCV", np.arange(len(hdf)), hdf["mean_test_score"], "score"))
        except Exception as e:
            st.finish(success=False, final_message=f"error: {e}")
            with svr_alert: _display(_HTML(f"<i>Error HalvingRandomSearchCV:</i> {e}"))

    # Optuna
    if run_optuna_chk.value and HAS_OPTUNA:
        st = EngineStatus("Optuna", total=int(optuna_trials.value))
        cont.children = tuple(list(cont.children) + [st.box])
        try:
            res = run_optuna(X_tr, y_tr, X_te, y_te, metric_key=metric_dropdown.value)
            st.update(current=int(optuna_trials.value))
            st.finish(final_message="completado")
            results.append(res)
            hdf = res.get("history", pd.DataFrame())
            if not hdf.empty and "number" in hdf.columns and "value" in hdf.columns:
                history_items.append(("Optuna", hdf["number"], hdf["value"], "valor objetivo"))
        except Exception as e:
            st.finish(success=False, final_message=f"error: {e}")
            with svr_alert: _display(_HTML(f"<i>Error Optuna:</i> {e}"))

    # Hyperopt
    if run_hyperopt_chk.value and HAS_HYPEROPT:
        st = EngineStatus("Hyperopt", total=int(hyperopt_evals.value))
        cont.children = tuple(list(cont.children) + [st.box])
        try:
            res = run_hyperopt(X_tr, y_tr, X_te, y_te, metric_key=metric_dropdown.value)
            st.update(current=int(hyperopt_evals.value))
            st.finish(final_message="completado")
            results.append(res)
            hdf = res.get("history", pd.DataFrame())
            if not hdf.empty and "iter" in hdf.columns:
                y = hdf["value"] if "value" in hdf.columns else hdf.iloc[:, -1]
                history_items.append(("Hyperopt", hdf["iter"], y, "valor objetivo"))
        except Exception as e:
            st.finish(success=False, final_message=f"error: {e}")
            with svr_alert: _display(_HTML(f"<i>Error Hyperopt:</i> {e}"))

    # skopt
    if run_skopt_chk.value and HAS_SKOPT:
        st = EngineStatus("skopt", total=int(skopt_n_iter.value))
        cont.children = tuple(list(cont.children) + [st.box])
        try:
            res = run_skopt_bayes(X_tr, y_tr, X_te, y_te, scoring_key=skey)
            st.update(current=int(skopt_n_iter.value))
            st.finish(final_message="completado")
            results.append(res)
            hdf = res.get("history", pd.DataFrame())
            if not hdf.empty and "mean_test_score" in hdf.columns:
                history_items.append(("BayesSearchCV (skopt)", np.arange(len(hdf)), hdf["mean_test_score"], "score"))
        except Exception as e:
            st.finish(success=False, final_message=f"error: {e}")
            with svr_alert: _display(_HTML(f"<i>Error skopt:</i> {e}"))

    # Si no hay resultados
    if not results:
        with svr_alert: _display(_HTML("<i>Seleccione y ejecute al menos un motor.</i>")); return

    # Mostrar historiales
    if history_items:
        with svr_histories_out:
            cols = 2
            rows = int(np.ceil(len(history_items)/cols))
            fig, axes = plt.subplots(rows, cols, figsize=(10, 3.2*rows)); axes = np.array(axes).reshape(rows, cols)
            for idx, (title, x, y, ylab) in enumerate(history_items):
                ax = axes[idx//cols, idx%cols]; ax.plot(x, y, marker='o', lw=1); ax.set_title(title); ax.set_xlabel('iter'); ax.set_ylabel(ylab)
            for j in range(len(history_items), rows*cols): axes[j//cols, j%cols].axis('off')
            plt.tight_layout(); plt.show()


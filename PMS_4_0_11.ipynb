# xIA NN — lógica principal

def on_run_xnn(_):
	xnn_alert.clear_output(); xnn_out_local.clear_output(); xnn_out_global.clear_output(); xnn_out_curves.clear_output(); xnn_out_cf.clear_output()
	# Asegurar dependencias xIA y barra de progreso
	ensure_xnn_packages(progress_output=xnn_alert)
	prog = widgets.IntProgress(value=0, min=0, max=4, description='xIA', bar_style='info')
	prog_lbl = widgets.HTML(value='Preparando...')
	with xnn_alert:
		display(widgets.VBox([prog_lbl, prog]))
	try:
		model, X_tr, y_tr, X_te, y_te, cols = get_best_nn_and_data()
		if not xnn_feat_select.options:
			xnn_feat_select.options = list(cols); xnn_feat_select.value = cols[0]
		# Local (SHAP Kernel)
		prog_lbl.value = 'SHAP...'; prog.value = 1
		with xnn_out_local:
			try:
				if HAS_SHAP:
					bg = X_tr[:int(xnn_bg.value)]
					expl = shap.KernelExplainer(model.predict, bg)
					idx = int(np.clip(xnn_idx.value, 0, len(X_te)-1))
					vals = expl.shap_values(X_te[idx:idx+1], nsamples=int(2*X_tr.shape[1]+2048))
					sh = np.array(vals).reshape(-1)
					imp = pd.Series(np.abs(sh), index=cols).sort_values(ascending=False)
					fig, axes = plt.subplots(1,2, figsize=(10,4))
					imp.head(int(xnn_top.value)).iloc[::-1].plot.barh(ax=axes[0]); axes[0].set_title("SHAP local (top)")
					shap.summary_plot(np.array(vals), pd.DataFrame(X_te[idx:idx+1], columns=cols), plot_type='bar', max_display=int(xnn_top.value), show=False)
					plt.tight_layout(); plt.show()
				else:
					print("SHAP no disponible.")
			except Exception as e:
				print("SHAP error:", e)
		# Global (Permutation Importance)
		prog_lbl.value = 'Permutation Importance...'; prog.value = 2
		with xnn_out_global:
			from sklearn.inspection import permutation_importance
			try:
				r = permutation_importance(model, X_te, y_te, n_repeats=int(xnn_pi_repeats.value), random_state=42, scoring='r2')
				imp = pd.Series(r.importances_mean, index=cols).sort_values(ascending=False)
				fig, ax = plt.subplots(1,1, figsize=(6,4)); imp.head(int(xnn_top.value)).iloc[::-1].plot.barh(ax=ax); ax.set_title("Permutation Importance (Test)"); plt.show()
			except Exception as e:
				print("PI error:", e)
			try:
				if HAS_SAGE:
					print("SAGE disponible (implementar pipeline según package).")
				else:
					print("SAGE no disponible.")
			except Exception as e:
				print("SAGE error:", e)
		# Curvas ALE/PDP
		prog_lbl.value = 'ALE/PDP...'; prog.value = 3
		with xnn_out_curves:
			try:
				if HAS_PYALE:
					feat = xnn_feat_select.value or cols[0]
					ale = ALE(X=pd.DataFrame(X_te, columns=cols), model=model.predict, feature=feat)
					fig = ale.plot(); plt.show()
				else:
					print("PyALE no disponible.")
			except Exception as e:
				print("ALE error:", e)
			try:
				if HAS_PDPBOX and len(cols) >= 1:
					feat = xnn_feat_select.value or cols[0]
					p = pdp.pdp_isolate(model=model, dataset=pd.DataFrame(X_te, columns=cols), model_features=cols, feature=feat)
					fig, axes = pdp.pdp_plot(p, feat); plt.show()
				else:
					print("PDPbox no disponible.")
			except Exception as e:
				print("PDP error:", e)
		# DiCE
		prog_lbl.value = 'DiCE...'; prog.value = 4
		with xnn_out_cf:
			try:
				if HAS_DICE:
					data = Data(dataframe=pd.DataFrame(X_tr, columns=cols).assign(Y=y_tr), continuous_features=cols, outcome_name='Y')
					class _Wrapper:
						def __init__(self, m): self.m=m
						def predict(self, X): return self.m.predict(np.asarray(X))
					mdl = Model(model=_Wrapper(model), backend='sklearn')
					dice = Dice(data, mdl, method='random')
					q = dice.generate_counterfactuals(pd.DataFrame([X_te[int(np.clip(xnn_idx.value,0,len(X_te)-1))]], columns=cols), total_CFs=3)
					print(q.cf_examples_list[0].final_cfs_df)
				else:
					print("DiCE no disponible.")
			except Exception as e:
				print("DiCE error:", e)
		with xnn_alert:
			prog.bar_style='success'; prog_lbl.value='xIA completada'
			display(widgets.HTML(value="<div>xIA NN completada.</div>"))
	except Exception as e:
		with xnn_alert:
			display(widgets.HTML(value=f"<div>Error xIA NN: {e}</div>"))


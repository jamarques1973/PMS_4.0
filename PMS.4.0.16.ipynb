xrf_do_bias = _w.Checkbox(value=False, description='Sesgos (subgrupos)')
xrf_bias_col = _w.Dropdown(options=['(ninguno)'], value='(ninguno)', description='Subgrupo')

xrf_alert = _w.Output()
xrf_log = _w.Output()

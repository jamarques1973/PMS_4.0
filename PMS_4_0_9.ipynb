def _get_best_model_and_data():
    if not hasattr(app, 'svr_optim_results') or not app.svr_optim_results:
        raise RuntimeError("Ejecute SVR (HPO) primero.")
    # Recuperar mejor motor y parámetros
    res = app.svr_optim_results
    best_engine = None
    best_params = None
    if isinstance(res.get('engines'), list) and len(res['engines']) > 0:
        # Reidentificar best a partir de comparison_table por seguridad
        comp = res.get('comparison_table', [])
        if isinstance(comp, list) and len(comp) > 0:
            best = None
            for r in comp:
                if r.get('is_best'):
                    best = r
                    break
            if best is None:
                best = comp[0]
            best_engine = best.get('engine')
            # buscar params por engine
            for e in res['engines']:
                if e.get('engine') == best_engine:
                    best_params = e.get('best_params')
                    break
    if best_params is None:
        # fallback: tomar primer engine
        e0 = res['engines'][0]
        best_params = e0.get('best_params')
    # Reconstruir datos
    y_col = res.get('y_column')
    if y_col is None:
        raise RuntimeError("No se encontró la columna Y.")
    seg_name = res.get('segment_name')
    if not app.segments:
        raise RuntimeError("Genere segmentación antes.")
    seg = next((s for s in app.segments if s.get('name') == seg_name), app.segments[0])
    X_tr, y_tr, X_te, y_te, cols, x_scaler, y_scaler = prepare_train_test(app.X, app.Y[y_col], seg, use_selected_chk.value, scale_x_chk.value, scale_y_chk.value)
    model = build_svr_from_params(best_params)
    model.fit(X_tr, y_tr)
    return model, X_tr, y_tr, X_te, y_te, cols


def on_run_xai(_):
    xai_alert.clear_output(); xai_shap_out.clear_output(); xai_lime_out.clear_output(); xai_perm_out.clear_output(); xai_pdp_out.clear_output(); xai_ale_out.clear_output(); xai_interact_out.clear_output(); xai_dice_out.clear_output(); xai_rulefit_out.clear_output()
    # Asegurar dependencias xIA antes de ejecutar
    ensure_xai_packages(progress_output=xai_alert)
    try:
        model, X_tr, y_tr, X_te, y_te, cols = _get_best_model_and_data()
        xai_progress.value = 0; xai_progress.bar_style = 'info'
    except Exception as e:
        # Intentar instalación automática y reintentar una vez
        ensure_xai_packages(progress_output=xai_alert)
        try:
            model, X_tr, y_tr, X_te, y_te, cols = _get_best_model_and_data()
        except Exception as e2:
            with xai_alert:
                display(make_alert_html(f"xIA error: {e2}", level="error"))
            return
    # SHAP (KernelSHAP)
    try:
        if HAS_SHAP:
            with xai_shap_out:
                bg = X_tr[:min(int(xai_bg_size.value), X_tr.shape[0])]
                explainer = shap.KernelExplainer(model.predict, bg)
                xt = X_te[:min(300, X_te.shape[0])]
                sv = explainer.shap_values(xt, nsamples=100)
                shap.summary_plot(sv, xt, feature_names=cols, show=False)
                plt.tight_layout(); plt.show(); xai_progress.value = 1
                display(widgets.HTML(value="<i>Interpretación SHAP:</i> colores=valor de la variable; puntos alejados de 0 indican mayor impacto. La gráfica de barras resume la importancia media absoluta."))
                shap.summary_plot(sv, xt, feature_names=cols, plot_type='bar', show=False)
                plt.tight_layout(); plt.show(); xai_progress.value = 2
                display(widgets.HTML(value="<i>Gráfico de barras SHAP:</i> mayor altura = mayor contribución global de la variable."))
        else:
            with xai_shap_out:
                display(make_alert_html("Instale 'shap' para ver explicaciones SHAP.", level="warning"))
    except Exception as e:
        with xai_shap_out:
            display(make_alert_html(f"SHAP error: {e}", level="error"))
    # LIME local
    try:
        if HAS_LIME:
            with xai_lime_out:
                idx = int(min(max(0, xai_sample_idx.value), X_te.shape[0]-1))
                exp = LimeTabularExplainer(X_tr, feature_names=cols, class_names=None, discretize_continuous=True, mode='regression')
                explanation = exp.explain_instance(X_te[idx], model.predict, num_features=int(xai_top_features.value))
                display(pd.DataFrame(explanation.as_list(), columns=['feature', 'weight']))
        else:
            with xai_lime_out:
                display(make_alert_html("Instale 'lime' para ver explicaciones locales.", level="warning"))
    except Exception as e:
        with xai_lime_out:
            display(make_alert_html(f"LIME error: {e}", level="error"))
    # Permutation importance
    try:
        if HAS_SK_INSPECTION:
            with xai_perm_out:
                pi = permutation_importance(model, X_te, y_te, n_repeats=10, random_state=42)
                imp = pd.DataFrame({'feature': cols, 'importance': pi.importances_mean}).sort_values('importance', ascending=False)
                fig, ax = plt.subplots(figsize=(8, 3.5))
                sns.barplot(x='importance', y='feature', data=imp.head(int(xai_top_features.value)), ax=ax, color="#1f77b4")
                ax.set_title('Permutation Importance (Test)'); ax.set_xlabel('Importancia media'); ax.set_ylabel('Variable'); plt.tight_layout(); plt.show(); xai_progress.value = 3
                display(widgets.HTML(value="<i>Interpretación PI:</i> mayor barra implica mayor sensibilidad del modelo a esa variable en Test."))
        else:
            with xai_perm_out:
                display(make_alert_html("sklearn.inspection no disponible.", level="warning"))
    except Exception as e:
        with xai_perm_out:
            display(make_alert_html(f"Permutation Importance error: {e}", level="error"))
    # PDP + ICE (top features)
    try:
        if HAS_SK_INSPECTION:
            with xai_pdp_out:
                top_feats = imp['feature'].head(int(xai_pdp_ice_top.value)).tolist() if 'imp' in locals() else cols[:int(xai_pdp_ice_top.value)]
                fig, ax = plt.subplots(figsize=(10, 6))
                PartialDependenceDisplay.from_estimator(model, X_te, features=top_feats, feature_names=cols, ax=ax)
                plt.suptitle('PDP/ICE - top features'); plt.tight_layout(); plt.show(); xai_progress.value = 4
                display(widgets.HTML(value="<i>Interpretación PDP/ICE:</i> líneas muestran efecto marginal de cada variable. Curvas planas = poco efecto."))
        else:
            with xai_pdp_out:
                display(make_alert_html("sklearn.inspection no disponible.", level="warning"))
    except Exception as e:
        with xai_pdp_out:
            display(make_alert_html(f"PDP/ICE error: {e}", level="error"))
    # ALE 1D (top features)
    try:
        with xai_ale_out:
            _USE_ALE_CLASS = False
            _ale_fn = None
            try:
                from PyALE import ALE as _ALE
                _USE_ALE_CLASS = True
            except Exception:
                try:
                    from PyALE import ale as _ale_fn  # función
                except Exception:
                    ensure_xai_packages(progress_output=xai_alert)
                    try:
                        from PyALE import ALE as _ALE
                        _USE_ALE_CLASS = True
                    except Exception:
                        try:
                            from PyALE import ale as _ale_fn
                        except Exception:
                            display(make_alert_html("Instale 'PyALE' para ver ALE.", level="warning"))
                            raise
            top_feats = imp['feature'].head(int(xai_pdp_ice_top.value)).tolist() if 'imp' in locals() else cols[:int(xai_pdp_ice_top.value)]
            for f in top_feats:
                if _USE_ALE_CLASS:
                    ale_obj = _ALE(X=pd.DataFrame(X_te, columns=cols), model=model, feature=[f])
                    ax = ale_obj.plot()
                else:
                    _ale_fn(X=pd.DataFrame(X_te, columns=cols), model=model, feature=[f])
                    ax = plt.gca()
                plt.title(f"ALE 1D: {f}"); plt.xlabel(f); plt.ylabel("Efecto local acumulado"); plt.tight_layout(); plt.show()
            xai_progress.value = 5
            display(widgets.HTML(value="<i>Interpretación ALE:</i> curvas muestran efecto promedio local al variar la variable manteniendo el contexto."))
    except Exception as e:
        with xai_ale_out:
            display(make_alert_html(f"ALE error: {e}", level="error"))
    # Interacciones (H-stat aprox) + ALE 2D
    try:
        if HAS_SK_INSPECTION:
            with xai_interact_out:
                # Aproximar interacción como var(2D PDP - suma 1D) / var(pred)
                if 'imp' in locals():
                    cand = imp['feature'].head(int(max(2, xai_pdp_ice_top.value))).tolist()
                else:
                    cand = cols[:int(max(2, xai_pdp_ice_top.value))]
                pairs = []
                for i in range(min(5, len(cand))):
                    for j in range(i+1, min(5, len(cand))):
                        pairs.append((cand[i], cand[j]))
                # PDP 2D en ejes correctos
                for f1, f2 in pairs[:3]:
                    fig, ax = plt.subplots(figsize=(6,5))
                    _ = PartialDependenceDisplay.from_estimator(model, X_te, features=[(cols.index(f1), cols.index(f2))], feature_names=cols, ax=ax)
                    ax.set_xlabel(f1); ax.set_ylabel(f2)
                    ax.set_title(f"PDP 2D: {f1} x {f2}")
                    plt.tight_layout(); plt.show()
                    # ALE 2D si disponible
                    try:
                        try:
                            from PyALE import ALE as _ALE2
                            _ale_class_ok = True; _ale_fn2 = None
                        except Exception:
                            from PyALE import ale as _ale_fn2
                            _ale_class_ok = False
                        if _ale_class_ok:
                            ale_obj2 = _ALE2(X=pd.DataFrame(X_te, columns=cols), model=model, feature=[f1, f2])
                            ax2 = ale_obj2.plot()
                        else:
                            _ale_fn2(X=pd.DataFrame(X_te, columns=cols), model=model, feature=[f1, f2])
                            ax2 = plt.gca()
                        plt.title(f"ALE 2D: {f1} x {f2}"); plt.xlabel(f1); plt.ylabel(f2); plt.tight_layout(); plt.show()
                    except Exception:
                        pass
                xai_progress.value = 6
                display(widgets.HTML(value="<i>Interpretación interacciones:</i> superficies curvadas sugieren interacción; planas o separables indican independencia. La vista PDP 2D muestra la respuesta promedio predicha (Y) sobre la malla de (X1, X2); ALE 2D complementa corrigiendo por la distribución local."))
        else:
            with xai_interact_out:
                display(make_alert_html("sklearn.inspection no disponible.", level="warning"))
    except Exception as e:
        with xai_interact_out:
            display(make_alert_html(f"Interacciones error: {e}", level="error"))
    # DiCE counterfactuals (regresión)
        if HAS_DICE:
            with xai_dice_out:
                # Import defensivo por si el import original aún no corrió
                try:
                    import dice_ml as _dice
                except Exception:
                    ensure_xai_packages(progress_output=xai_alert)
                    import dice_ml as _dice
                dfXtr = pd.DataFrame(X_tr, columns=cols); dfYtr = pd.Series(y_tr, name='Y')
                df = pd.concat([dfXtr, dfYtr], axis=1)
                d = _dice.Data(dataframe=df, continuous_features=cols, outcome_name='Y')
                m = _dice.Model(model=model, backend='sklearn', model_type='regressor')
                exp = _dice.Dice(d, m, method='random')
                idx = int(min(max(0, xai_sample_idx.value), X_te.shape[0]-1))
                xi = pd.DataFrame([X_te[idx]], columns=cols)
                desired_range = [float(y_te[idx] + xai_cf_delta.value - abs(xai_cf_delta.value)*0.5), float(y_te[idx] + xai_cf_delta.value + abs(xai_cf_delta.value)*0.5)] if xai_cf_delta.value != 0 else None
                if desired_range is None:
                    display(make_alert_html("Introduzca Δ y* para generar counterfactuals (regresión).", level="warning"))
                else:
                    try:
                        cf = exp.generate_counterfactuals(xi, total_CFs=3, desired_range=desired_range)
                    except Exception:
                        # Estrategia de respaldo: ampliar rango y probar método genético si disponible
                        dr_lo, dr_hi = desired_range
                        widen = (dr_hi - dr_lo) * 1.5 + 1e-6
                        desired_range2 = [float(y_te[idx] - widen/2.0), float(y_te[idx] + widen/2.0)]
                        try:
                            cf = exp.generate_counterfactuals(xi, total_CFs=3, desired_range=desired_range2, posthoc_sparsity_param=0.05)
                        except Exception as _e2:
                            display(make_alert_html("No se pudieron generar counterfactuals. Ajuste Δ y* o variables a variar.", level="warning"))
                            cf = None
                    if cf is not None:
                        display(cf.visualize_as_dataframe(show_only_changes=True))
        else:
            with xai_dice_out:
                display(make_alert_html("Instale 'dice-ml' para counterfactuals.", level="warning"))
        # Ayuda adicional para DiCE
        with xai_dice_out:
            display(widgets.HTML(value="<i>Ayuda DiCE:</i> Δ y* define la zona objetivo de la predicción en Test para generar contraejemplos. Si no aparecen resultados, amplíe Δ y* o limite features a variar. Cada fila muestra los cambios mínimos sugeridos para desplazar la predicción actual hacia el objetivo."))
    # RuleFit surrogate global
    try:
        if HAS_RULEFIT:
            with xai_rulefit_out:
                # Import defensivo
                try:
                    from rulefit import RuleFit as _RuleFit
                except Exception:
                    ensure_xai_packages(progress_output=xai_alert)
                    from rulefit import RuleFit as _RuleFit
                rf = _RuleFit(tree_generator=None, sample_fract='default', max_rules=200, memory_par=0.01, tree_size=4)
                rf.fit(X_tr, y_tr, feature_names=cols)
                rules = rf.get_rules()
                rules = rules[(rules.coef != 0) & (rules.type != 'linear')]
                display(rules.sort_values('importance', ascending=False).head(20))
        else:
            with xai_rulefit_out:
                display(make_alert_html("Instale 'rulefit' para ver surrogate global.", level="warning"))
        # Ayuda adicional para RuleFit
        with xai_rulefit_out:
            display(widgets.HTML(value="<i>Ayuda RuleFit:</i> se aprende un modelo de reglas (surrogate) que aproxima al SVR. Las reglas con mayor importancia y coeficiente distinto de 0 son las más influyentes. Use esta tabla para comunicar lógicas interpretables."))
    except Exception as e:
        with xai_rulefit_out:
            display(make_alert_html(f"RuleFit error: {e}", level="error"))
    with xai_alert:
        display(make_alert_html("xIA calculada.", level="success"))

btn_run_xai.on_click(on_run_xai)
def plot_history_uniform(ax, x, y, title, y_label):
    sns.set_style("whitegrid")
    sns.lineplot(x=x, y=y, ax=ax, color="#1f77b4", linewidth=2)
    ax.set_title(title)
    ax.set_ylabel(y_label)
    ax.set_xlabel("iter")

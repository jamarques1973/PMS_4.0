# Botón para generar subgrupos
btn_make_subgroups = _w.Button(description='Generar subgrupos', icon='users')

def _on_make_subgroups(_=None):
    try:
        if not hasattr(app, 'X') or getattr(app, 'X', None) is None:
            print('No hay X cargadas.')
            return
        df = app.X
        created = []
        for c in list(df.columns):
            try:
                ser = df[c]
                if _pd.api.types.is_numeric_dtype(ser) and ser.nunique() > 10:
                    try:
                        q = _pd.qcut(ser, q=4, duplicates='drop')
                        name = f"{c}_q{q.nunique()}"
                        if name not in df.columns:
                            df[name] = q.astype(str)
                            created.append(name)
                    except Exception:
                        pass
            except Exception:
                pass
        # Refrescar opciones de subgrupo
        opts = ['(ninguno)']
        for c in df.columns:
            try:
                ser = df[c]
                if ser.dtype == 'object' or ser.nunique() <= 10:
                    opts.append(c)
            except Exception:
                pass
        if len(opts) == 1:
            opts += list(getattr(df, 'columns', []))
        xrf_bias_col.options = opts
        if xrf_bias_col.value not in opts:
            xrf_bias_col.value = '(ninguno)'
        if created:
            print('Subgrupos creados:', ', '.join(created))
        else:
            print('No se generaron subgrupos nuevos.')
    except Exception as e:
        print('Error al generar subgrupos:', e)

btn_make_subgroups.on_click(_on_make_subgroups)

xrf_do_robust = _w.Checkbox(value=False, description='Robustez (bootstrap)')

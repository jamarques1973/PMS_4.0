def integrate_rnn_tab():
	try:
		if 'rnn_form' not in globals():
			return
		if 'tabs' in globals() and hasattr(tabs, 'children'):
			children = list(tabs.children)
			# Insertar tras NN (HPO) si existe
			insert_idx = 0
			for i, ch in enumerate(children):
				try:
					if isinstance(ch, widgets.VBox):
						html = getattr(ch.children[0], 'value', '') if ch.children else ''
						if 'NN (HPO)' in html:
							insert_idx = i + 1
							break
				except Exception:
					continue
			children.insert(insert_idx, rnn_form)
			tabs.children = tuple(children)
			try:
				tabs.set_title(insert_idx, "RNN (HPO)")
			except Exception:
				pass
		# Header versión
		if 'header' in globals():
			header.value = "<div style='font-size:20px;font-weight:700'>PMS 4.0.16</div>"
		# Construir grid de títulos (solo preparación; render en build_ui)
		try:
			btns = []
			for i in range(len(tabs.children)):
				title = tabs.get_title(i) or f"Tab {i+1}"
				b = widgets.Button(description=title.replace('\n', ' '), layout=widgets.Layout(width='auto'))
				b.style.button_color = '#f1f3f5'
				def _mk(ii):
					return lambda _ : setattr(tabs, 'selected_index', ii)
				b.on_click(_mk(i))
				btns.append(b)
			grid = widgets.GridBox(children=btns, layout=widgets.Layout(grid_template_columns='repeat(auto-fill, minmax(120px,1fr))', gap='6px'))
		except Exception:
			pass
	except Exception:
		pass


# Utilidades

def _prefill_xrf_features(cols):
    try:
        xrf_feat.options = ['All'] + list(cols)
        xrf_feat2.options = ['(auto)'] + list(cols)
        # columnas de subgrupo: inferir categóricas por tipo/unique
        opts = ['(ninguno)']
        if hasattr(app, 'X') and getattr(app.X, 'columns', None) is not None:
            for c in app.X.columns:
                try:
                    if app.X[c].dtype == 'object' or app.X[c].nunique() <= 10:
                        opts.append(c)
                except Exception:
                    pass
        xrf_bias_col.options = opts
    except Exception:
        pass


def _plot_grid(figs, cols=3):
    outs = []
    for f in figs:
        o = _w.Output()
        with o:
            try:
                fig = getattr(f, 'figure', f)
                _plt.figure(fig.number)
                _plt.tight_layout(); _plt.show()
                try:
                    _plt.close(fig)
                except Exception:
                    pass
            except Exception:
                pass
        outs.append(o)
    grid = _w.GridBox(children=outs, layout=_w.Layout(grid_template_columns=' '.join(['1fr']*cols)))
    _display(grid)


# Ejecución principal
xrf_out_local = _w.Output(); xrf_out_global = _w.Output(); xrf_out_curves = _w.Output()
xrf_out_surrog = _w.Output(); xrf_out_cf = _w.Output(); xrf_out_robust = _w.Output(); xrf_out_bias = _w.Output()


def _run_xrf(_=None):
    xrf_alert.clear_output(); xrf_log.clear_output()
    for o in (xrf_out_local, xrf_out_global, xrf_out_curves, xrf_out_surrog, xrf_out_cf, xrf_out_robust, xrf_out_bias):
        o.clear_output()
    lbl, prog = xrf_progress.children
    lbl.value = 'Preparando...'; prog.value = 0; prog.max = 8
    try:
        model, X_tr, y_tr, X_te, y_te, cols, y_col = get_best_rf_and_data()
        _prefill_xrf_features(cols)
        # Reducir muestra para xIA costosa
        n = int(min(len(X_te), max(50, xrf_sample.value)))
        Xs = X_te[:n]; ys = y_te[:n]
        prog.value = 1; lbl.value = 'Locales y SHAP'
        # Local + SHAP
        with xrf_out_local:
            figs = []
            if xrf_do_shap.value and _HAS_SHAP:
                try:
                    expl = _shap.TreeExplainer(model)
                    shvals = expl.shap_values(Xs)
                    _shap.summary_plot(shvals, _pd.DataFrame(Xs, columns=list(cols)), show=False, max_display=int(xrf_topk.value))
                    figs.append(_plt.gcf())
                    if xrf_do_shap_int.value:
                        try:
                            ish = expl.shap_interaction_values(Xs)
                            _shap.summary_plot(ish, _pd.DataFrame(Xs, columns=list(cols)), show=False, max_display=int(xrf_topk.value))
                            figs.append(_plt.gcf())
                        except Exception:
                            print('SHAP interactions no disponibles.')
                except Exception as e:
                    print('SHAP error:', e)
            _plot_grid(figs, cols=2)
        prog.value = 2; lbl.value = 'Permutation Importance'
        with xrf_out_global:
            try:
                # Bootstrap de PI
                boots = int(max(1, xrf_pi_boot.value)); reps = int(max(1, xrf_pi_repeats.value))
                imps = []
                rng = _np.random.RandomState(42)
                for b in range(boots):
                    idx = rng.choice(len(Xs), size=len(Xs), replace=True)
                    r = _permimp(model, Xs[idx], ys[idx], n_repeats=reps, random_state=rng, scoring='r2')
                    imps.append(_pd.Series(r.importances_mean, index=list(cols)))
                imp_df = _pd.DataFrame(imps)
                imp_mean = imp_df.mean().sort_values(ascending=False)
                topk = imp_mean.head(int(xrf_topk.value))
                ax = topk.iloc[::-1].plot.barh(figsize=(5.5,3.2), color='#1f77b4'); ax.set_title('PI (bootstrap)'); _plt.tight_layout(); _plt.show()
                # Intervalos
                ci = imp_df[topk.index].std()
                _display(_pd.DataFrame({'mean': topk, 'std': ci[topk.index]}))
            except Exception as e:
                print('PI error:', e)
        prog.value = 3; lbl.value = 'PDP/ICE/ALE'
        with xrf_out_curves:
            figs = []
            try:
                # Determinar conjunto de features a graficar
                feats = [xrf_feat.value] if (xrf_feat.value and xrf_feat.value!='All') else list(cols)[:int(max(1, xrf_topk.value))]
                # PDP/ICE para todas las features seleccionadas
                if xrf_do_pdp.value:
                    # Renderizar en grid (3 columnas por defecto)
                    out_panels = []
                    for f in feats:
                        o = _w.Output()
                        with o:
                            try:
                                fig, ax = _plt.subplots(1,1, figsize=(4.2,2.6))
                                _PDP.from_estimator(model, Xs, features=[f], feature_names=list(cols), ax=ax, kind='both')
                                ax.set_title(f'PDP/ICE: {f}')
                                _plt.tight_layout(); _plt.show(); _plt.close(fig)
                            except Exception:
                                try:
                                    fig, ax = _plt.subplots(1,1, figsize=(4.2,2.6))
                                    _PDP.from_estimator(model, Xs, features=[f], feature_names=list(cols), ax=ax)
                                    ax.set_title(f'PDP: {f}')
                                    _plt.tight_layout(); _plt.show(); _plt.close(fig)
                                except Exception as _e_pdp:
                                    print('PDP error:', _e_pdp)
                        out_panels.append(o)
                    grid = _w.GridBox(children=out_panels, layout=_w.Layout(grid_template_columns='1fr 1fr 1fr'))
                    _display(grid)
                # ALE 1D/2D si está disponible
                if xrf_do_ale.value and _HAS_PYALE:
                    try:
                        dfXs = _pd.DataFrame(Xs, columns=list(cols))
                        # 1D ALE para todas las features seleccionadas (grid)
                        ale_panels = []
                        for f in feats:
                            o = _w.Output()
                            with o:
                                try:
                                    ale = _ALE(X=dfXs, model=model.predict, feature=[str(f)])
                                    fig = ale.plot()
                                    _plt.tight_layout(); _plt.show(); _plt.close(fig)
                                except Exception as _e_ale1:
                                    print('ALE 1D error:', _e_ale1)
                            ale_panels.append(o)
                        # 2D ALE: pares
                        pairs = []
                        if xrf_feat2.value and xrf_feat2.value!='(auto)':
                            pairs = [(f, xrf_feat2.value) for f in feats if f != xrf_feat2.value]
                        else:
                            # Auto: usar top importances del modelo si existen
                            try:
                                imp = _pd.Series(getattr(model, 'feature_importances_', _np.zeros(len(cols))), index=list(cols)).sort_values(ascending=False)
                                top_feats = [f for f in imp.index if f in feats][:min(5, len(feats))]
                                for i in range(len(top_feats)-1):
                                    pairs.append((top_feats[i], top_feats[i+1]))
                            except Exception:
                                pairs = []
                        for f1, f2 in pairs[:6]:
                            o2 = _w.Output()
                            with o2:
                                try:
                                    ale2 = _ALE(X=dfXs, model=model.predict, feature=[str(f1), str(f2)])
                                    fig2 = ale2.plot()
                                    _plt.tight_layout(); _plt.show(); _plt.close(fig2)
                                except Exception as _e_ale2:
                                    print('ALE 2D error:', _e_ale2)
                            ale_panels.append(o2)
                        if ale_panels:
                            grid_ale = _w.GridBox(children=ale_panels, layout=_w.Layout(grid_template_columns='1fr 1fr 1fr'))
                            _display(grid_ale)
                    except Exception as e:
                        print('ALE error:', e)
            except Exception as e:
                print('Curvas error:', e)
            _plot_grid(figs, cols=3)
        prog.value = 4; lbl.value = 'Sustitutos'
        with xrf_out_surrog:
            figs = []
            try:
                tree = _DTR(max_depth=int(xrf_tree_depth.value), ccp_alpha=float(xrf_tree_ccp.value), random_state=42)
                tree.fit(Xs, model.predict(Xs))
                r2 = float(_r2(model.predict(Xs), tree.predict(Xs)))
                imp = _pd.Series(getattr(tree, 'feature_importances_', _np.zeros(len(cols))), index=list(cols)).sort_values(ascending=False)
                ax = imp.head(int(xrf_topk.value)).iloc[::-1].plot.barh(figsize=(5.0,3.0)); ax.set_title(f'Surrogate Tree (R2={r2:.3f})'); figs.append(_plt.gcf())
                txt = _export_text(tree, feature_names=list(cols))
                _display(_HTML('<pre style="max-height:200px;overflow:auto">'+txt+'</pre>'))
            except Exception as e:
                print('Árbol sustituto error:', e)
            if xrf_do_rulefit.value and _HAS_RULEFIT:
                try:
                    rf = _RuleFit()
                    rf.fit(Xs, model.predict(Xs), feature_names=list(cols))
                    imp = _pd.Series(rf.get_feature_importance().set_index('feature')['importance'])
                    ax = imp.sort_values(ascending=False).head(int(xrf_topk.value)).iloc[::-1].plot.barh(figsize=(5.0,3.0)); ax.set_title('RuleFit importances'); figs.append(_plt.gcf())
                except Exception as e:
                    print('RuleFit error:', e)
            _plot_grid(figs, cols=2)
        prog.value = 5; lbl.value = 'Contrafactuales'
        with xrf_out_cf:
            if xrf_do_dice.value and _HAS_DICE:
                try:
                    dfX = _pd.DataFrame(Xs, columns=list(cols)); dfy = _pd.Series(ys, name='y')
                    data = _dice.Data(dataframe=_pd.concat([dfX, dfy], axis=1), continuous_features=list(cols), outcome_name='y')
                    # Para regresión, especificar model_type y rango deseado
                    m = _dice.Model(model=model, backend='sklearn', model_type='regressor')
                    exp = _dice.Dice(data, m, method='random')
                    inst = dfX.iloc[[min(len(dfX)-1, 0)]]
                    y_min, y_max = float(_np.min(ys)), float(_np.max(ys))
                    # Ampliar con porcentajes seleccionables por el usuario
                    ymin_adj = y_min + (xrf_dice_range_min_pct.value/100.0)*(y_max - y_min)
                    ymax_adj = y_min + (xrf_dice_range_max_pct.value/100.0)*(y_max - y_min)
                    if ymax_adj < ymin_adj:
                        ymin_adj, ymax_adj = ymax_adj, ymin_adj
                    cfs = exp.generate_counterfactuals(inst, total_CFs=int(xrf_dice_k.value), desired_range=(float(ymin_adj), float(ymax_adj)), features_to_vary='all')
                    try:
                        _display(_HTML(cfs.to_html()))
                    except Exception:
                        _display(_HTML(str(cfs)))
                except Exception as e:
                    print('DiCE error:', e)
            else:
                print('DiCE no disponible o desactivado.')
        prog.value = 6; lbl.value = 'Robustez'
        with xrf_out_robust:
            if xrf_do_robust.value:
                try:
                    it = int(xrf_robust_iters.value)
                    rng = _np.random.RandomState(0)
                    ranks = []
                    for i in range(it):
                        idx = rng.choice(len(Xs), size=len(Xs), replace=True)
                        r = _permimp(model, Xs[idx], ys[idx], n_repeats=4, random_state=rng, scoring='r2')
                        s = _pd.Series(r.importances_mean, index=list(cols)).rank(ascending=False, method='min')
                        ranks.append(s)
                    rk = _pd.DataFrame(ranks)
                    _display(rk.describe())
                except Exception as e:
                    print('Robustez error:', e)
            else:
                print('Robustez desactivada.')
        prog.value = 7; lbl.value = 'Sesgos'
        with xrf_out_bias:
            try:
                if xrf_do_bias.value and xrf_bias_col.value and xrf_bias_col.value!='(ninguno)':
                    df = _pd.DataFrame(Xs, columns=list(cols))
                    g = app.X.loc[df.index, xrf_bias_col.value] if hasattr(app, 'X') else _pd.Series('(NA)', index=df.index)
                    groups = g.astype(str).unique().tolist()[:6]
                    figs = []
                    if _HAS_SHAP and xrf_do_shap.value:
                        try:
                            expl = _shap.TreeExplainer(model); sh = expl.shap_values(Xs)
                            for gg in groups:
                                idx = (g.astype(str)==gg).values
                                meanabs = _np.abs(sh[idx]).mean(axis=0)
                                ax = _pd.Series(meanabs, index=list(cols)).sort_values(ascending=False).head(int(xrf_topk.value)).iloc[::-1].plot.barh(figsize=(5.0,3.0))
                                ax.set_title(f'SHAP | grupo={gg}'); figs.append(_plt.gcf())
                        except Exception as e:
                            print('Sesgos-SHAP error:', e)
                    else:
                        # Fallback con Permutation Importance por subgrupos
                        try:
                            for gg in groups:
                                idx = (g.astype(str)==gg).values
                                r = _permimp(model, Xs[idx], ys[idx], n_repeats=6, random_state=0, scoring='r2')
                                imp = _pd.Series(r.importances_mean, index=list(cols)).sort_values(ascending=False)
                                ax = imp.head(int(xrf_topk.value)).iloc[::-1].plot.barh(figsize=(5.0,3.0))
                                ax.set_title(f'PI | grupo={gg}'); figs.append(_plt.gcf())
                        except Exception as e:
                            print('Sesgos-PI error:', e)
                    _plot_grid(figs, cols=3)
                else:
                    print('Sesgos desactivado.')
            except Exception as e:
                print('Sesgos error:', e)
        prog.value = 8; lbl.value = 'xIA RF completado'
        with xrf_log:
            print('xIA RF ejecutado correctamente.')
    except Exception as e:
        with xrf_alert:
            _display(_HTML(f"<div style='color:#b00'>Error xIA RF: {e}</div>"))


btn_run_xrf = _w.Button(description='Calcular xIA RF', button_style='primary', icon='search')
btn_run_xrf.on_click(_run_xrf)

xrf_params_row1 = _w.HBox([xrf_topk, xrf_sample, xrf_bg])
xrf_params_row2 = _w.HBox([xrf_feat, xrf_feat2, xrf_grid])
xrf_toggles = _w.HBox([xrf_do_pi, xrf_do_shap, xrf_do_shap_int, xrf_do_pdp, xrf_do_ale, xrf_do_tree, xrf_do_rulefit, xrf_do_dice, xrf_do_robust, xrf_do_bias], layout=_w.Layout(flex_flow='row wrap'))
xrf_extra = _w.HBox([xrf_pi_repeats, xrf_pi_boot, xrf_tree_depth, xrf_tree_ccp, xrf_dice_k, xrf_dice_range_box, xrf_robust_iters, _w.VBox([_w.HTML('<b>Subgrupos</b>'), xrf_bias_col, btn_make_subgroups]), _w.VBox([_w.HTML('<b>Sampling xIA</b>'), xrf_sample])], layout=_w.Layout(flex_flow='row wrap'))

xrf_tab = _w.VBox([
    _w.HTML(value="<h3 style='margin:6px 0'>xIA Random Forest (mejor modelo HPO)</h3>"),
    xrf_params_row1, xrf_params_row2, xrf_toggles, xrf_extra,

# Helper para mostrar tablas legibles
def show_df(df: pd.DataFrame, caption: str = "", max_height: int = 360, font_px: int = 12):
    try:
        html = df.to_html(index=True, escape=False)
    except Exception:
        html = "<pre>" + str(df) + "</pre>"
    cap = f"<div style='margin:4px 0; font-weight:600'>{caption}</div>" if caption else ""
    style = (
        "<style>table{table-layout:fixed;width:100%} th,td{white-space:normal;word-break:break-word;}</style>"
    )
    box = f"<div style='max-height:{max_height}px; overflow:auto; font-size:{font_px}px; line-height:1.25'>{style}{cap}{html}</div>"
    display(_HTML(box))

# Helper: grid 2xN
def make_grid(items: list, max_cols: int = 2) -> widgets.GridBox:
    n = max(1, len(items))
    ncols = 1 if n == 1 else min(max_cols, 2)
    cols_tpl = " ".join(["1fr"] * ncols)
    return widgets.GridBox(children=items, layout=widgets.Layout(grid_template_columns=cols_tpl, grid_gap="12px"))

# Helper: textos (<=300 palabras) explicativos por tipo de gráfico/modelo
_SHORT_TEXTS = {
    'shap_scatter': "<div style='max-width:900px;text-align:justify'><p><b>SHAP (dispersión)</b>. Esta vista resume, para muchas observaciones, cómo cada variable contribuye a la predicción (valores SHAP). La posición horizontal indica la magnitud del impacto (izquierda reduce, derecha incrementa), y el color representa el valor original de la variable (bajo/alto). Interprete así: (1) ordene mentalmente por el ‘abanico’ horizontal: mayor apertura = mayor importancia y variabilidad; (2) observe el gradiente de color: si los puntos rojos se concentran a la derecha, valores altos de la variable empujan la predicción al alza; (3) detecte colas o bimodalidades que sugieran subgrupos o interacciones. Use esta lectura para priorizar variables que explican el modelo y detectar zonas donde la respuesta cambia más. Combine con PDP/ALE para verificar la forma del efecto y con PI para validar sensibilidad global.</p></div>",
    'shap_bar': "<div style='max-width:900px;text-align:justify'><p><b>SHAP (barras)</b>. Las barras muestran la importancia media absoluta de cada variable, una medida global y estable de su contribución al modelo. Úsela para priorizar: las primeras variables concentran la mayor parte del efecto explicativo. Recomendaciones: (1) verifique si las variables de mayor SHAP también son relevantes en PI; coherencia entre ambas aumenta confianza; (2) si aparecen variables derivadas o correlacionadas en top posiciones, considere simplificar o regularizar; (3) utilice este ranking para focalizar esfuerzos de calidad de datos y control de proceso en las variables clave.</p></div>",
    'lime_barh': "<div style='max-width:900px;text-align:justify'><p><b>LIME (local)</b>. La barra horizontal indica, para la instancia analizada, cuánto aporta cada condición al valor predicho: pesos positivos elevan la predicción y negativos la reducen. Interprete así: (1) identifique las 3–5 contribuciones principales y confirme que son plausibles con el contexto; (2) contraste con SHAP local si lo desea; (3) si el patrón difiere de la intuición, explore si la muestra es atípica o si hay variables omitidas. Esta explicación es útil para auditorías puntuales y para recomendaciones locales (qué cambiar en esta instancia).</p></div>",
    'pi': "<div style='max-width:900px;text-align:justify'><p><b>Permutation Importance</b>. Mide la pérdida de desempeño al permutar una variable en Test; mayor caída = mayor dependencia del modelo. Úselo para confirmar relevancias: variables con alta PI merecen ser monitoreadas y gobernadas. Precaución con colinealidad: la importancia puede repartirse entre variables correlacionadas. Combine con SHAP y PDP/ALE para entender no solo ‘cuánto’ importa una variable, sino ‘cómo’ lo hace.</p></div>",
    'pdp_ice': "<div style='max-width:900px;text-align:justify'><p><b>PDP/ICE</b>. PDP muestra el efecto promedio de una variable; ICE, curvas por instancia. Interprete: tendencias monótonas sugieren relaciones consistentes; abanicos y cruces entre ICE delatan heterogeneidad o interacciones. Si hay correlaciones entre variables, PDP puede sesgarse; valide con ALE. Estas curvas guían decisiones de ajuste de setpoints y delimitan zonas de riesgo.</p></div>",
    'ale1d': "<div style='max-width:900px;text-align:justify'><p><b>ALE 1D</b>. Estima efectos marginales corrigiendo por la distribución local, por lo que es más robusto que PDP ante colinealidad. Interprete: pendientes y cambios de signo informan sobre direccionalidad y no linealidad; zonas planas señalan escaso efecto. Úselo para confirmar puntos de inflexión y para definir umbrales operativos seguros.</p></div>",
    'pdp2d': "<div style='max-width:900px;text-align:justify'><p><b>PDP 2D</b>. Superficie promedio de la predicción frente a dos variables. Curvaturas, crestas o valles oblicuos evidencian interacción; superficies separables sugieren independencia. Úselo para detectar combinaciones críticas y coordinar políticas de control en variables conjuntas.</p></div>",
    'ale2d': "<div style='max-width:900px;text-align:justify'><p><b>ALE 2D</b>. Complementa PDP 2D corrigiendo por distribución, reduciendo sesgos. Valide interacciones: si ambas vistas coinciden en la señal, la evidencia es más sólida. Empléelo para entender regiones del espacio donde pequeñas variaciones conjuntas producen cambios grandes en la respuesta.</p></div>",
    'interactions2d': "<div style='max-width:900px;text-align:justify'><p><b>Interacciones 2D (PDP + ALE)</b>. Esta sección muestra, para pares de variables, dos vistas complementarias: (1) PDP 2D, que representa la superficie promedio de la predicción sobre una malla (X1, X2) y permite identificar patrones globales; y (2) ALE 2D, que corrige por la distribución de los datos y reduce sesgos cuando existe colinealidad, proporcionando una lectura más fiable de efectos conjuntos. Cómo interpretar: busque curvaturas, crestas o valles diagonales; estas formas revelan que el efecto conjunto no es aditivo. Si la superficie es plana o separable (variación en bandas ortogonales), la interacción es débil o inexistente. Use ambas vistas de forma conjunta: coincidencia en la señal (picos/vales en similares regiones) refuerza la evidencia de interacción; discrepancias pueden indicar datos escasos en ciertas celdas o sesgos en la malla del PDP. Práctica: identifique regiones (rangos de X1, X2) donde pequeñas variaciones generan grandes cambios en la respuesta y priorice acciones ahí; al mismo tiempo, defina zonas de seguridad donde el sistema es estable ante cambios. Para mejorar la robustez, valide con más pares, incremente la resolución de la malla solo si hay suficientes datos, y considere segmentar el espacio si existen subpoblaciones con comportamientos distintos.</p></div>",
    'dice': "<div style='max-width:900px;text-align:justify'><p><b>Counterfactuals (DiCE)</b>. Propone cambios mínimos y factibles en variables seleccionadas para llevar la predicción a un rango objetivo. Úselo así: (1) revise qué variables cambia y en qué magnitud; (2) compruebe que los cambios respetan restricciones (permitted_range) y son operativamente viables; (3) si no aparecen soluciones, amplíe Δ y*, permita variar más variables o relaje rangos. Emplee estos contraejemplos para definir acciones y evaluar impacto potencial antes de implementarlas.</p></div>",
}

_LONG_TEXTS = {}

def _make_long(kind: str, feature: str = None) -> str:

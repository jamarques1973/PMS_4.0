# Instalación opcional bajo demanda
def ensure_xnn_packages(progress_output=None):
	install = []
	if not HAS_SHAP: install.append('shap')
	if not HAS_PYALE: install.append('PyALE')
	if not HAS_PDPBOX: install.append('pdpbox')
	if not HAS_DICE: install.append('dice-ml')
	if not install:
		return
	import sys, subprocess
	prog = widgets.IntProgress(value=0, min=0, max=len(install), bar_style='info', description='xIA')
	lbl = widgets.HTML(value='Instalando xIA: ' + ', '.join(install))
	if progress_output is not None:
		with progress_output:
			display(widgets.VBox([lbl, prog]))
	for i, pkg in enumerate(install, start=1):
		try:
			subprocess.check_call([sys.executable, '-m', 'pip', 'install', '-q', pkg])
		except Exception as _e:
			if progress_output is not None:
				with progress_output:
					display(widgets.HTML(value=f"<div>No se pudo instalar {pkg}: {_e}</div>"))
		finally:
			prog.value = i
	if progress_output is not None:
		prog.bar_style='success'; lbl.value='Instalación completada'


def ensure_dl_packages(progress_output: widgets.Output | None = None) -> bool:
	"""Garantiza TensorFlow disponible. Devuelve True si hay TF operativo."""
	global _HAS_TF
	if _HAS_TF:
		return True
	import sys, subprocess
	msg = widgets.HTML(value="Instalando TensorFlow (puede tardar unos minutos)…")
	prog = widgets.IntProgress(value=0, min=0, max=1, bar_style='info')
	if progress_output is not None:
		with progress_output:
			display(widgets.VBox([msg, prog]))
	try:
		subprocess.check_call([sys.executable, "-m", "pip", "install", "-q", "tensorflow-cpu>=2.13,<3.0"])  # opción CPU
		prog.value = 1
		import tensorflow as _tf  # noqa: F401
		from tensorflow import keras as _keras  # noqa: F401
		_HAS_TF = True
		return True
	except Exception as _e:
		if progress_output is not None:
			with progress_output:
				display(widgets.HTML(value=f"<div style='color:#b00'>No fue posible instalar TensorFlow: {_e}</div>"))
		return False



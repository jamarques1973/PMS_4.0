def _build_ranges_editor(cols, X_tr, X_te):
    xai_ranges_out.clear_output()
    items = []
    for c in cols:
        try:
            j = cols.index(c)
            arr = np.concatenate([X_tr[:, j], X_te[:, j]])
            arr = arr[np.isfinite(arr)]
            vmin = float(np.min(arr)) if arr.size else 0.0
            vmax = float(np.max(arr)) if arr.size else 0.0
        except Exception:
            vmin, vmax = 0.0, 0.0
        wmin = widgets.FloatText(value=vmin, description=f"{c} min", layout=widgets.Layout(width="45%"))
        wmax = widgets.FloatText(value=vmax, description=f"{c} max", layout=widgets.Layout(width="45%"))
        xai_range_controls[c] = (wmin, wmax)
        items.append(widgets.HBox([wmin, wmax], layout=widgets.Layout(justify_content="space-between")))
    with xai_ranges_out:
        display(widgets.VBox(items, layout=widgets.Layout(max_height="260px", overflow="auto")))

